    --// Functions
    local function UpdateCurrentIndexLabel()
        CurrentIndexLabel.Text = Data.CurrentCheckpointIndex .. " / " .. #Data.Checkpoints
        if TotalCPLabel then
            TotalCPLabel.Text = "Total CP Tersimpan: " .. #Data.Checkpoints
        end
    end

    local function HandleManualAutoReset()
        if Data.AutoResetEnabled and Data.CurrentCheckpointIndex == #Data.Checkpoints and not Data.IsLooping then
            task.spawn(function()
                if Data.IsResetting then return end
                Data.IsResetting = true
                
                task.wait(Data.ResetDelay or 0.5)
                
                if Data.ResetScript and Data.ResetScript ~= "" then
                    local success, result = pcall(function()
                        local func = loadstring(Data.ResetScript)
                        if func then func() end
                    end)
                    if not success then
                        warn("shhhhnayy05 - Reset Script Error: ", result)
                    end
                end
                
                task.wait(Data.StartLoopDelay or 1.0)
                
                if Data.Checkpoints[1] then
                    SafeTeleport(Data.Checkpoints[1].Position)
                    Data.CurrentCheckpointIndex = 1
                    UpdateCurrentIndexLabel()
                    ShowNotification("Auto Reset Terpicu!")
                end
                
                Data.IsResetting = false
            end)
        end
    end

    local function TeleportToCheckpoint(index)
        if index < 1 or index > #Data.Checkpoints then
            ShowNotification("Invalid checkpoint!")
            return
        end
        
        if SafeTeleport(Data.Checkpoints[index].Position) then
            Data.CurrentCheckpointIndex = index
            UpdateCurrentIndexLabel()
            ShowNotification("Checkpoint " .. index)
            
            HandleManualAutoReset()
        else
            ShowNotification("Character not ready!")
        end
    end

