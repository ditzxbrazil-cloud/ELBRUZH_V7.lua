--// CORE LOGIC: ENHANCED COLLECT CP REMOTE SYSTEM //--
local function GetPromptsAtPosition(targetPosition)
    local targets = {}
    local distLimit = Data.CollectRadius or 9999999
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if v.ObjectText == "Penuh!" or v.ActionText == "Kumpulkan" or (v.Parent and v.Parent.Name:find("Stone")) then
                local parentPart = v.Parent
                if parentPart and parentPart:IsA("BasePart") then
                    local d = (targetPosition - parentPart.Position).Magnitude
                    if d <= distLimit then
                        table.insert(targets, v)
                    end
                end
            end
        end
    end
    return targets
end

