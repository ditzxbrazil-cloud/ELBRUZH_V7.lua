    local function StartLoop()
        if Data.IsLooping or #Data.Checkpoints == 0 then return end
        
        Data.IsLooping = true
        Data.CurrentCheckpointIndex = 1
        
        Data.LoopConnection = task.spawn(function()
            while Data.IsLooping do
                if SafeTeleport(Data.Checkpoints[Data.CurrentCheckpointIndex].Position) then
                    
                    if Data.AutoResetEnabled and Data.CurrentCheckpointIndex == #Data.Checkpoints then
                        UpdateCurrentIndexLabel()
                        
                        task.wait(Data.ResetDelay or 0.5)
                        
                        if Data.ResetScript and Data.ResetScript ~= "" then
                            local success, result = pcall(function()
                                local func = loadstring(Data.ResetScript)
                                if func then func() end
                            end)
                            if not success then
                                warn("shhhhnayy05 - Reset Script Error: ", result)
                            end
                        end
                        
                        task.wait(Data.StartLoopDelay or 1.0)
                        Data.CurrentCheckpointIndex = 1
                    else
                        Data.CurrentCheckpointIndex = Data.CurrentCheckpointIndex + 1
                        if Data.CurrentCheckpointIndex > #Data.Checkpoints then
                            Data.CurrentCheckpointIndex = 1
                        end
                    end
                    UpdateCurrentIndexLabel()
                end
                task.wait(Data.Speed)
            end
        end)
        
        ShowNotification("Loop started!")
    end

