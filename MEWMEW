            self.CopyStats.Scripts = self.CopyStats.Scripts + 1
            
            --// Get source safely
            local source = ""
            pcall(function()
                source = instance.Source or ""
            end)
            data.Properties.Source = source
            data.Properties.Disabled = instance.Disabled
            
            if instance:IsA("LocalScript") then
                data.Properties.RunContext = tostring(instance.RunContext)
            end
            
        --// BASEPART (Parts, MeshParts, etc.)
        elseif instance:IsA("BasePart") then
            self.CopyStats.Parts = self.CopyStats.Parts + 1
            
            data.Properties.Size = {
