--// Make Slider (TOUCH COMPATIBLE)
function shhhhnayy05:MakeSlider(slider, fill, callback)
    local dragging = false
    
    local function update(input)
        local x = input.Position.X - slider.AbsolutePosition.X
        local scale = math.clamp(x/slider.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(scale, 0, 1, 0)
        callback(scale)
    end
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    
    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

--// Setup Input (MOBILE FIX)
function shhhhnayy05:SetupInput()
    local g = shhhhnayy05.GUI
    
    -- MOUSE
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if not shhhhnayy05.Config.IsActive then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            shhhhnayy05.IsDrawing = true
            self:Sculpt(input.Position)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            shhhhnayy05.IsDrawing = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if shhhhnayy05.IsDrawing and input.UserInputType == Enum.UserInputType.MouseMovement then
            self:Sculpt(input.Position)
        end
    end)
    
    -- TOUCH (MOBILE)
    UserInputService.TouchStarted:Connect(function(touch, gp)
        if gp then return end
        if not shhhhnayy05.Config.IsActive then return end
        shhhhnayy05.IsDrawing = true
        shhhhnayy05.TouchPositions[touch] = touch.Position
        self:Sculpt(touch.Position)
    end)
    
    UserInputService.TouchMoved:Connect(function(touch, gp)
        if not shhhhnayy05.Config.IsActive then return end
        if shhhhnayy05.IsDrawing then
            shhhhnayy05.TouchPositions[touch] = touch.Position
            self:Sculpt(touch.Position)
        end
    end)
    
    UserInputService.TouchEnded:Connect(function(touch, gp)
        shhhhnayy05.IsDrawing = false
        shhhhnayy05.TouchPositions[touch] = nil
    end)
end

--// Sculpt Function
function shhhhnayy05:Sculpt(pos)
    local cam = Workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(pos.X, pos.Y)
    
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {shhhhnayy05.GUI.Preview, LocalPlayer.Character}
    
    local result = Workspace:Raycast(ray.Origin, ray.Direction*1000, rp)
    if result then
        if shhhhnayy05.Config.Mode == "Smooth" then
            self:DoSmooth(result.Position)
        else
            self:DoFlatten(result.Position)
        end
    end
end

--// Do Smooth
function shhhhnayy05:DoSmooth(pos)
    local size = shhhhnayy05.Config.BrushSize
    local str = shhhhnayy05.Config.BrushStrength
    
    local region = Region3.new(pos-Vector3.new(size,size,size), pos+Vector3.new(size,size,size))
    region = region:ExpandToGrid(4)
    
    local mm, om = Workspace.Terrain:ReadVoxels(region, 4)
    local res = mm.Size
    
    for x=1,res.X do
        for y=1,res.Y do
            for z=1,res.Z do
                local vPos = region.CFrame.Position + Vector3.new((x-1)*4,(y-1)*4,(z-1)*4)
                local dist = (vPos-pos).Magnitude
                
                local inBrush = false
                if shhhhnayy05.Config.Shape == "Block" then
                    inBrush = math.abs(vPos.X-pos.X)<=size and math.abs(vPos.Y-pos.Y)<=size and math.abs(vPos.Z-pos.Z)<=size
                else
                    inBrush = dist <= size
                end
                
                if inBrush then
                    local falloff = 1
                    if shhhhnayy05.Config.Shape == "Ball" then
                        falloff = math.max(0, 1-(dist/size))
                        falloff = falloff*falloff*(3-2*falloff)
                    end
                    
                    local newOcc = math.clamp(om[x][y][z] + (str*falloff*0.5), 0, 1)
                    om[x][y][z] = newOcc
                    mm[x][y][z] = shhhhnayy05.CurrentMaterial
                    
                    local key = string.format("%d,%d,%d", math.floor(vPos.X/4)*4, math.floor(vPos.Y/4)*4, math.floor(vPos.Z/4)*4)
                    shhhhnayy05.TerrainData[key] = {x=math.floor(vPos.X/4)*4, y=math.floor(vPos.Y/4)*4, z=math.floor(vPos.Z/4)*4, occ=newOcc, mat=tostring(shhhhnayy05.CurrentMaterial):gsub("Enum.Material.","")}
                end
            end
        end
    end
    
    Workspace.Terrain:WriteVoxels(region, 4, mm, om)
end

--// Do Flatten
function shhhhnayy05:DoFlatten(pos)
    local size = shhhhnayy05.Config.BrushSize
    local str = shhhhnayy05.Config.BrushStrength
    
    -- Find target height
    local sample = Region3.new(pos-Vector3.new(size,0,size), pos+Vector3.new(size,4,size))
    sample = sample:ExpandToGrid(4)
    local sm, so = Workspace.Terrain:ReadVoxels(sample, 4)
    
    local targetY = pos.Y
    for x=1,sm.Size.X do
        for z=1,sm.Size.Z do
            for y=sm.Size.Y,1,-1 do
                if so[x][y][z] > 0.5 then
                    targetY = sample.CFrame.Position.Y + (y-1)*4
                    break
                end
            end
        end
    end
    
    -- Flatten
    local region = Region3.new(
        Vector3.new(pos.X-size, targetY-size, pos.Z-size),
        Vector3.new(pos.X+size, targetY+size, pos.Z+size)
    )
    region = region:ExpandToGrid(4)
    
    local mm, om = Workspace.Terrain:ReadVoxels(region, 4)
    local res = mm.Size
    
    for x=1,res.X do
        for y=1,res.Y do
            for z=1,res.Z do
                local vPos = region.CFrame.Position + Vector3.new((x-1)*4,(y-1)*4,(z-1)*4)
                local dist = Vector2.new(vPos.X-pos.X, vPos.Z-pos.Z).Magnitude
                
                local inBrush = false
                if shhhhnayy05.Config.Shape == "Block" then
                    inBrush = math.abs(vPos.X-pos.X)<=size and math.abs(vPos.Z-pos.Z)<=size
                else
                    inBrush = dist <= size
                end
                
                if inBrush then
                    local diff = targetY - vPos.Y
                    local blend = str
                    if shhhhnayy05.Config.Shape == "Ball" then
                        blend = str * math.max(0, 1-(dist/size))
                    end
                    
                    if math.abs(diff) < 12 then
                        local targetOcc = (math.abs(diff) < 2) and 1 or math.max(0, 1-math.abs(diff)/8)
                        om[x][y][z] = math.clamp(om[x][y][z] + (targetOcc-om[x][y][z])*blend, 0, 1)
                        mm[x][y][z] = shhhhnayy05.CurrentMaterial
                        
                        local key = string.format("%d,%d,%d", math.floor(vPos.X/4)*4, math.floor(vPos.Y/4)*4, math.floor(vPos.Z/4)*4)
                        shhhhnayy05.TerrainData[key] = {x=math.floor(vPos.X/4)*4, y=math.floor(vPos.Y/4)*4, z=math.floor(vPos.Z/4)*4, occ=om[x][y][z], mat=tostring(shhhhnayy05.CurrentMaterial):gsub("Enum.Material.","")}
                    end
                end
            end
        end
    end
    
    Workspace.Terrain:WriteVoxels(region, 4, mm, om)
end

--// Update Preview
function shhhhnayy05:UpdatePreview()
    local g = shhhhnayy05.GUI
    if not g or not shhhhnayy05.Config.IsActive then
        g.Preview.Visible = false
        return
    end
    
    local mouse = LocalPlayer:GetMouse()
    local cam = Workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
    
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {g.Preview, LocalPlayer.Character}
    
    local result = Workspace:Raycast(ray.Origin, ray.Direction*1000, rp)
    if result then
        g.Preview.Visible = true
        g.Preview.CFrame = CFrame.new(result.Position)
        g.Preview.Color = shhhhnayy05.Config.Mode == "Smooth" and Color3.fromRGB(0,200,255) or Color3.fromRGB(255,200,0)
    else
        g.Preview.Visible = false
    end
end

--// Generate Script
function shhhhnayy05:GenScript()
    local lines = {}
    
    table.insert(lines, "--// shhhhnayy05 Terrain Script")
    table.insert(lines, "local Terrain = workspace.Terrain")
    table.insert(lines, "")
    table.insert(lines, "--// Colors")
    table.insert(lines, "Terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB("..tostring(self.ColorPalettes.Grass[self.CurrentColors.Grass].color).."))")
    table.insert(lines, "Terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB("..tostring(self.ColorPalettes.Ground[self.CurrentColors.Ground].color).."))")
    table.insert(lines, "Terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB("..tostring(self.ColorPalettes.LeafyGrass[self.CurrentColors.LeafyGrass].color).."))")
    table.insert(lines, "Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB("..tostring(self.ColorPalettes.Rock[self.CurrentColors.Rock].color).."))")
    table.insert(lines, "")
    table.insert(lines, "--// Voxels")
    table.insert(lines, "local voxels = {")
    
    local count = 0
    for k,v in pairs(shhhhnayy05.TerrainData) do
        if v.occ > 0.1 then
            table.insert(lines, string.format("  {x=%d,y=%d,z=%d,occ=%.2f,mat=Enum.Material.%s},", v.x, v.y, v.z, v.occ, v.mat))
            count = count + 1
            if count > 8000 then break end
        end
    end
    
    table.insert(lines, "}")
    table.insert(lines, "")
    table.insert(lines, "for _,v in pairs(voxels) do")
    table.insert(lines, "  local r = Region3.new(Vector3.new(v.x,v.y,v.z), Vector3.new(v.x+4,v.y+4,v.z+4))")
    table.insert(lines, "  local mm,om = Terrain:ReadVoxels(r,4)")
    table.insert(lines, "  mm[1][1][1] = v.mat")
    table.insert(lines, "  om[1][1][1] = v.occ")
    table.insert(lines, "  Terrain:WriteVoxels(r,4,mm,om)")
    table.insert(lines, "end")
    table.insert(lines, "print('shhhhnayy05: '..#voxels..' voxels loaded')")
    
    shhhhnayy05.GUI.ScriptBox.Text = table.concat(lines, "\n")
    shhhhnayy05.GUI.ScriptWindow.Visible = true
    self:ShowNotif("Script Generated: "..count.." voxels")
end

--// Show Notification
function shhhhnayy05:ShowNotif(text)
    local g = shhhhnayy05.GUI
    local n = Instance.new("Frame", g.ScreenGui)
    n.Size = UDim2.new(0,250,0,45)
    n.Position = UDim2.new(0.5,-125,0,-50)
    n.BackgroundColor3 = Color3.fromRGB(30,30,30)
    Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
    
    local s = Instance.new("UIStroke", n)
    s.Color = Color3.fromRGB(0,200,255)
    s.Thickness = 2
    
    local l = Instance.new("TextLabel", n)
    l.Size = UDim2.new(1,-20,1,0)
    l.Position = UDim2.new(0,10,0,0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(255,255,255)
    l.TextSize = 13
    l.Font = Enum.Font.GothamBold
    
    TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Position = UDim2.new(0.5,-125,0,20)}):Play()
    
    spawn(function()
        wait(2.5)
        TweenService:Create(n, TweenInfo.new(0.3), {Position = UDim2.new(0.5,-125,0,-50)}):Play()
        wait(0.3)
        n:Destroy()
    end)
end

--// Init
function shhhhnayy05:Init()
    self:CreateGUI()
    print("🏔️ shhhhnayy05 Terrain Sculptor Mobile Loaded!")
end

shhhhnayy05:Init()
return shhhhnayy05
