--// TERRAIN DRAWING FUNCTIONS
function shhhhnayy05:DrawTerrain(position)
    local size = self.Config.BrushSize
    local material = self.Config.Material
    local color = self:GetCurrentColorForMaterial(material)
    
    local terrainData = nil
    
    if self.Config.CurrentMode == "Smooth" then
        -- SMOOTH MODE - Normal terrain drawing
        if self.Config.Shape == "Block" then
            local cframe = CFrame.new(position)
            local sizeVec = Vector3.new(size * 2, size, size * 2)
            
            Workspace.Terrain:FillBlock(cframe, sizeVec, material)
            if color then
                Workspace.Terrain:SetMaterialColor(material, color)
            end
            
            terrainData = {
                Type = "Block",
                Position = {X = position.X, Y = position.Y, Z = position.Z},
                Size = {X = size * 2, Y = size, Z = size * 2},
                Material = tostring(material),
                Color = color,
                Mode = "Smooth"
            }
        else
            local radius = size
            Workspace.Terrain:FillBall(position, radius, material)
            if color then
                Workspace.Terrain:SetMaterialColor(material, color)
            end
            
            terrainData = {
                Type = "Ball",
                Position = {X = position.X, Y = position.Y, Z = position.Z},
                Radius = radius,
                Material = tostring(material),
                Color = color,
                Mode = "Smooth"
            }
        end
        
    else
        -- FLATTEN MODE - Fixed height block
        -- Set flatten level on first click if not set
        if not self.Config.FlattenLevel then
            self.Config.FlattenLevel = position.Y
            self.GUI.FlattenDisplay.Text = "📍 Flatten Level: " .. math.floor(position.Y * 100) / 100
            self.GUI.FlattenDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
        
        local flattenY = self.Config.FlattenLevel
        
        -- Always use Block shape for flatten mode (as per your example)
        local blockSize = Vector3.new(size * 2, 4, size * 2)
        local flattenCFrame = CFrame.new(position.X, flattenY, position.Z)
        
        Workspace.Terrain:FillBlock(flattenCFrame, blockSize, material)
        if color then
            Workspace.Terrain:SetMaterialColor(material, color)
        end
        
        terrainData = {
            Type = "Block",
            Position = {X = position.X, Y = flattenY, Z = position.Z},
            Size = {X = size * 2, Y = 4, Z = size * 2},
            Material = tostring(material),
            Color = color,
            Mode = "Flatten",
            FlattenLevel = flattenY
        }
    end
    
    -- Add to history for conversion
    table.insert(self.TerrainHistory, terrainData)
    
    -- Update status
    self.GUI.StatusLabel.Text = "✅ Drew " .. self.Config.CurrentMode .. " at " .. math.floor(position.X) .. ", " .. math.floor(position.Y) .. ", " .. math.floor(position.Z)
end

--// INPUT HANDLING
function shhhhnayy05:SetupInput()
    local isDragging = false
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if self.Config.ModeEnabled then
            if input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                self:HandleDrawInput(input)
            end
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if self.Config.ModeEnabled and isDragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement or 
               input.UserInputType == Enum.UserInputType.Touch then
                self:HandleDrawInput(input)
            end
        end
        
        -- Update brush preview position
        if self.Config.ModeEnabled and self.BrushPreview then
            local ray = Workspace.CurrentCamera:ViewportPointToRay(input.Position.X, input.Position.Y)
            local hit, pos = self:Raycast(ray.Origin, ray.Direction * 1000)
            if hit then
                if self.Config.CurrentMode == "Flatten" and self.Config.FlattenLevel then
                    -- Show preview at flatten level
                    self.BrushPreview.CFrame = CFrame.new(pos.X, self.Config.FlattenLevel, pos.Z)
                else
                    self.BrushPreview.CFrame = CFrame.new(pos)
                end
                self.BrushPreview.Parent = Workspace
            end
        end
    end)
end

--// RAYCAST
function shhhhnayy05:Raycast(origin, direction)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {self.BrushPreview, LocalPlayer.Character}
    
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then
        return true, result.Position
    end
    return false, nil
end

--// HANDLE DRAW INPUT
function shhhhnayy05:HandleDrawInput(input)
    local ray = Workspace.CurrentCamera:ViewportPointToRay(input.Position.X, input.Position.Y)
    local hit, pos = self:Raycast(ray.Origin, ray.Direction * 1000)
    
    if hit and pos then
        self:DrawTerrain(pos)
    end
end

--// CONVERT TO SCRIPT
function shhhhnayy05:ConvertToScript()
    if #self.TerrainHistory == 0 then
        self.GUI.StatusLabel.Text = "❌ No terrain to convert!"
        self.GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local scriptContent = self:GenerateScriptContent()
    self:CreateScriptWindow(scriptContent)
    
    self.GUI.StatusLabel.Text = "✅ Converted " .. #self.TerrainHistory .. " terrain operations to script!"
    self.GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
end

--// GENERATE SCRIPT CONTENT
function shhhhnayy05:GenerateScriptContent()
    local lines = {}
    
    table.insert(lines, "--// TERRAIN SCRIPT GENERATED BY shhhhnayy05")
    table.insert(lines, "--// Generated: " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(lines, "--// Total Operations: " .. #self.TerrainHistory)
    table.insert(lines, "")
    table.insert(lines, "local Terrain = workspace.Terrain")
    table.insert(lines, "")
    
    -- Add color definitions if used
    local hasCustomColors = false
    for _, data in ipairs(self.TerrainHistory) do
        if data.Color then
            hasCustomColors = true
            break
        end
    end
    
    if hasCustomColors then
        table.insert(lines, "--// COLOR DEFINITIONS")
        table.insert(lines, "local Colors = {")
        
        local uniqueColors = {}
        for _, data in ipairs(self.TerrainHistory) do
            if data.Color and not uniqueColors[tostring(data.Color)] then
                uniqueColors[tostring(data.Color)] = data.Color
                local matName = data.Material:gsub("Enum.Material.", "")
                table.insert(lines, string.format("    %s = Color3.fromRGB(%d, %d, %d),",
                    matName,
                    math.floor(data.Color.R * 255),
                    math.floor(data.Color.G * 255),
                    math.floor(data.Color.B * 255)
                ))
            end
        end
        
        table.insert(lines, "}")
        table.insert(lines, "")
    end
    
    table.insert(lines, "--// TERRAIN OPERATIONS")
    table.insert(lines, "local function CreateTerrain()")
    
    for i, data in ipairs(self.TerrainHistory) do
        table.insert(lines, "")
        table.insert(lines, "    -- Operation " .. i .. ": " .. data.Mode .. " " .. data.Type .. " (" .. data.Material .. ")")
        
        if data.Type == "Block" then
            local pos = data.Position
            local size = data.Size
            local mat = data.Material:gsub("Enum.Material.", "")
            
            table.insert(lines, string.format("    Terrain:FillBlock("))
            table.insert(lines, string.format("        CFrame.new(%f, %f, %f),", pos.X, pos.Y, pos.Z))
            table.insert(lines, string.format("        Vector3.new(%f, %f, %f),", size.X, size.Y, size.Z))
            table.insert(lines, string.format("        Enum.Material.%s", mat))
            table.insert(lines, string.format("    )"))
        else
            local pos = data.Position
            local radius = data.Radius
            local mat = data.Material:gsub("Enum.Material.", "")
            
            table.insert(lines, string.format("    Terrain:FillBall("))
            table.insert(lines, string.format("        Vector3.new(%f, %f, %f),", pos.X, pos.Y, pos.Z))
            table.insert(lines, string.format("        %f,", radius))
            table.insert(lines, string.format("        Enum.Material.%s", mat))
            table.insert(lines, string.format("    )"))
        end
        
        if data.Color then
            local mat = data.Material:gsub("Enum.Material.", "")
            table.insert(lines, string.format("    Terrain:SetMaterialColor(Enum.Material.%s, Colors.%s)", mat, mat))
        end
    end
    
    table.insert(lines, "")
    table.insert(lines, "end")
    table.insert(lines, "")
    table.insert(lines, "--// EXECUTE")
    table.insert(lines, "CreateTerrain()")
    table.insert(lines, "print(\"[shhhhnayy05] Terrain created successfully with " .. #self.TerrainHistory .. " operations!\")")
    
    return table.concat(lines, "\n")
end

