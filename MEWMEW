--// Fungsi Sort
local function sortItems(items)
    if sortMode == "numeric" then
        table.sort(items, function(a, b)
            local numA = extractNumber(a.Name)
            local numB = extractNumber(b.Name)
            if numA ~= numB then
                return numA < numB
            else
                return string.lower(a.Name) < string.lower(b.Name)
            end
        end)
    else
        table.sort(items, function(a, b)
            return string.lower(a.Name) < string.lower(b.Name)
        end)
    end
    return items
end

--// Fungsi Start Auto Loop
local function startAutoLoop()
    if isLoopRunning then return end
    if #currentItems == 0 then return end
    
    isLoopRunning = true
    StartLoopBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    StopLoopBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    
    local lastTime = tick()
    
    loopConnection = RunService.Heartbeat:Connect(function()
        if not isLoopRunning then return end
        
        local currentTime = tick()
        if currentTime - lastTime >= loopSpeed then
            lastTime = currentTime
            
            currentIndex = currentIndex + 1
            if currentIndex > #currentItems then
                currentIndex = 1
            end
            
            updateNavigation()
        end
    end)
end

--// Fungsi Stop Auto Loop
local function stopAutoLoop()
    isLoopRunning = false
    StartLoopBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    StopLoopBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    
    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end
end

