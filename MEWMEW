--// Teleport ke checkpoint
local function teleportToCheckpoint(checkpoint)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local targetPosition = nil
    
    --// Coba dapatkan posisi dari instance
    if checkpoint.instance and checkpoint.instance.Parent then
        if checkpoint.instance:IsA("BasePart") then
            targetPosition = checkpoint.instance.Position + Vector3.new(0, 5, 0)
        else
            --// Cari part dalam model
            local part = checkpoint.instance:FindFirstChildWhichIsA("BasePart")
            if part then
                targetPosition = part.Position + Vector3.new(0, 5, 0)
            end
        end
    end
    
    --// Gunakan posisi tersimpan jika instance tidak valid
    if not targetPosition and checkpoint.position then
        targetPosition = checkpoint.position + Vector3.new(0, 5, 0)
    end
    
    if targetPosition then
        --// Animasi teleport
        TweenService:Create(humanoidRootPart, TweenInfo.new(0.3), {
            CFrame = CFrame.new(targetPosition)
        }):Play()
        
        StatusLabel.Text = "Teleported to: " .. checkpoint.name
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        StatusLabel.Text = "Error: Cannot teleport to " .. checkpoint.name
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

--// Reveal hidden checkpoints (buat visible)
local function revealHiddenCheckpoints()
    local revealed = 0
    
    for _, checkpoint in ipairs(CheckpointData.stored) do
        if checkpoint.isHidden and checkpoint.instance then
            pcall(function()
                --// Buat part baru di posisi checkpoint yang tersembunyi
                if checkpoint.instance:IsA("BasePart") then
                    checkpoint.instance.Transparency = 0
                    checkpoint.instance.CanCollide = true
                    
                    --// Tambah highlight
                    local selectionBox = Instance.new("SelectionBox")
                    selectionBox.Name = "CheckpointHighlight"
                    selectionBox.Adornee = checkpoint.instance
                    selectionBox.Color3 = Color3.fromRGB(255, 0, 255)
                    selectionBox.LineThickness = 0.05
                    selectionBox.Parent = checkpoint.instance
                end
                
                revealed = revealed + 1
                checkpoint.isHidden = false
                checkpoint.isActive = true
            end)
        end
    end
    
    --// Update UI
    updateCheckpointList()
    
    StatusLabel.Text = string.format("Revealed %d hidden checkpoints", revealed)
    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 255)
end

--// Fungsi Format Nama
local function formatName(name)
    if #name > 25 then
        return string.sub(name, 1, 22) .. "..."
    end
    return name
end

--// Fungsi Ambil Angka dari Nama
local function extractNumber(name)
    local num = string.match(name, "%d+")
    if num then
        return tonumber(num)
    end
    return 0
end

--// Fungsi Cek Apakah Valid Part
local function isValidPart(instance)
    return instance:IsA("BasePart") or instance:IsA("MeshPart") or instance:IsA("UnionOperation") or instance:IsA("Part")
end

--// Fungsi Dapatkan Icon
local function getIcon(instance)
    if instance:IsA("Folder") then
        return "📁"
    elseif instance:IsA("Model") then
        return "🧊"
    elseif instance:IsA("Part") then
        return "🟦"
    elseif instance:IsA("MeshPart") then
        return "🔷"
    elseif instance:IsA("UnionOperation") then
        return "⬡"
    else
        return "📦"
    end
end

