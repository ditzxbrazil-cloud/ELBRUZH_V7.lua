--// Connect All Events (ROBUST VERSION)
function shhhhnayy05:ConnectAllEvents()
    local g = shhhhnayy05.GUI
    
    -- Helper function for button connections
    local function ConnectButton(btn, callback)
        if not btn then return end
        
        -- Use Activated event (works for both touch and mouse)
        btn.Activated:Connect(function()
            -- Visual feedback
            local originalColor = btn.BackgroundColor3
            btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            
            task.delay(0.1, function()
                btn.BackgroundColor3 = originalColor
            end)
            
            -- Execute callback
            local success, err = pcall(callback)
            if not success then
                warn("Button error: " .. tostring(err))
            end
        end)
    end
    
    -- Mode Icon
    ConnectButton(g.ModeIcon, function()
        shhhhnayy05.Config.IsActive = not shhhhnayy05.Config.IsActive
        g.ModeStatus.BackgroundColor3 = shhhhnayy05.Config.IsActive and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
        
        -- FIX: Use Transparency instead of Visible
        if shhhhnayy05.Config.IsActive then
            g.Preview.Transparency = 0.6
        else
            g.Preview.Transparency = 1
        end
        
        self:ShowNotif(shhhhnayy05.Config.IsActive and "✅ MODE ON" or "❌ MODE OFF")
    end)
    
    -- Minimize Icon
    local minimized = false
    ConnectButton(g.MinIcon, function()
        minimized = not minimized
        g.MainFrame.Visible = not minimized
    end)
    
    -- Panel Minimize
    local panelMinBtn = g.MainFrame:FindFirstChild("TitleBar"):FindFirstChild("PanelMinBtn")
    ConnectButton(panelMinBtn, function()
        minimized = true
        g.MainFrame.Visible = false
    end)
    
    -- Close
    local closeBtn = g.MainFrame:FindFirstChild("TitleBar"):FindFirstChild("CloseBtn")
    ConnectButton(closeBtn, function()
        shhhhnayy05.Config.IsActive = false
        g.Preview:Destroy()
        g.ScreenGui:Destroy()
    end)
    
    -- Mode: Smooth
    ConnectButton(g.SmoothBtn, function()
        shhhhnayy05.Config.Mode = "Smooth"
        g.SmoothBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        g.FlattenBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        self:ShowNotif("Mode: SMOOTH")
    end)
    
    -- Mode: Flatten
    ConnectButton(g.FlattenBtn, function()
        shhhhnayy05.Config.Mode = "Flatten"
        g.FlattenBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        g.SmoothBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        self:ShowNotif("Mode: FLATTEN")
    end)
    
    -- Shape: Block
    ConnectButton(g.BlockBtn, function()
        shhhhnayy05.Config.Shape = "Block"
        g.BlockBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
        g.BallBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        g.Preview.Shape = Enum.PartType.Block
        self:ShowNotif("Shape: BLOCK")
    end)
    
    -- Shape: Ball
    ConnectButton(g.BallBtn, function()
        shhhhnayy05.Config.Shape = "Ball"
        g.BallBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
        g.BlockBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        g.Preview.Shape = Enum.PartType.Ball
        self:ShowNotif("Shape: BALL")
    end)
    
    -- Sliders
    self:SetupSlider(g.SizeSlider, g.SizeFill, function(val)
        shhhhnayy05.Config.BrushSize = math.floor(val * 20 + 4)
        g.SizeLabel.Text = "Size: " .. shhhhnayy05.Config.BrushSize
        local s = shhhhnayy05.Config.BrushSize
        g.Preview.Size = Vector3.new(s, s, s)
    end)
    
    self:SetupSlider(g.StrSlider, g.StrFill, function(val)
        shhhhnayy05.Config.BrushStrength = val
        g.StrengthLabel.Text = "Strength: " .. math.floor(val * 100) .. "%"
    end)
    
    -- Toggle Windows
    ConnectButton(g.MatToggleBtn, function()
        g.MatWindow.Visible = not g.MatWindow.Visible
        g.MatToggleBtn.Text = g.MatWindow.Visible and "📂 CLOSE MATERIALS" or "📂 OPEN MATERIALS"
    end)
    
    ConnectButton(g.ColToggleBtn, function()
        g.ColWindow.Visible = not g.ColWindow.Visible
        g.ColToggleBtn.Text = g.ColWindow.Visible and "🌈 CLOSE COLORS" or "🌈 OPEN COLOR PALETTE"
    end)
    
    -- Material Selection
    for _, btn in pairs(g.MatScroll:GetChildren()) do
        if btn:IsA("TextButton") then
            ConnectButton(btn, function()
                local matName = btn.Name
                local success, mat = pcall(function()
                    return Enum.Material[matName]
                end)
                
                if success and mat then
                    shhhhnayy05.CurrentMaterial = mat
                    
                    -- Update visuals
                    for _, b in pairs(g.MatScroll:GetChildren()) do
                        if b:IsA("TextButton") then
                            b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                            local s = b:FindFirstChildOfClass("UIStroke")
                            if s then s:Destroy() end
                        end
                    end
                    
                    btn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
                    local ns = Instance.new("UIStroke")
                    ns.Color = Color3.fromRGB(255, 255, 255)
                    ns.Thickness = 2
                    ns.Parent = btn
                    
                    self:ShowNotif("Material: " .. matName)
                end
            end)
        end
    end
    
    -- Color Selection
    for _, btn in pairs(g.ColWindow:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Name:find("_") then
            ConnectButton(btn, function()
                local parts = {}
                for part in btn.Name:gmatch("[^_]+") do
                    table.insert(parts, part)
                end
                if #parts == 2 then
                    local matType, idx = parts[1], tonumber(parts[2])
                    shhhhnayy05.CurrentColors[matType] = idx
                    
                    -- Refresh strokes
                    for _, b in pairs(g.ColWindow:GetDescendants()) do
                        if b:IsA("TextButton") and b.Name:find("_") then
                            local p = {}
                            for pt in b.Name:gmatch("[^_]+") do table.insert(p, pt) end
                            if #p == 2 then
                                local stroke = b:FindFirstChildOfClass("UIStroke")
                                if tonumber(p[2]) == shhhhnayy05.CurrentColors[p[1]] then
                                    if not stroke then
                                        stroke = Instance.new("UIStroke")
                                        stroke.Color = Color3.fromRGB(255, 255, 255)
                                        stroke.Thickness = 3
                                        stroke.Parent = b
                                    end
                                else
                                    if stroke then stroke:Destroy() end
                                end
                            end
                        end
                    end
                    
                    self:ShowNotif(matType .. " color updated!")
                end
            end)
        end
    end
    
    -- Actions
    ConnectButton(g.ConvertBtn, function()
        self:GenerateScript()
    end)
    
    ConnectButton(g.ClearBtn, function()
        shhhhnayy05.TerrainData = {}
        Workspace.Terrain:Clear()
        self:ShowNotif("🗑️ Terrain Cleared!")
    end)
    
    ConnectButton(g.CopyBtn, function()
        if setclipboard then
            setclipboard(g.ScriptBox.Text)
            self:ShowNotif("📋 Copied!")
        else
            g.ScriptBox:CaptureFocus()
            self:ShowNotif("Select All & Copy")
        end
    end)
    
    -- Setup terrain input
    self:SetupTerrainInput()
    
    -- Update loop
    RunService.RenderStepped:Connect(function()
        self:UpdatePreview()
    end)
end

--// Setup Slider
function shhhhnayy05:SetupSlider(slider, fill, callback)
    local dragging = false
    
    local function update(input)
        local absX = input.Position.X
        local sliderX = slider.AbsolutePosition.X
        local sliderW = slider.AbsoluteSize.X
        local scale = math.clamp((absX - sliderX) / sliderW, 0, 1)
        fill.Size = UDim2.new(scale, 0, 1, 0)
        callback(scale)
    end
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    
    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

--// Setup Terrain Input
function shhhhnayy05:SetupTerrainInput()
    -- Touch
    UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
        if gameProcessed then return end
        if not shhhhnayy05.Config.IsActive then return end
        shhhhnayy05.IsDrawing = true
        self:SculptAt(touch.Position)
    end)
    
    UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
        if not shhhhnayy05.Config.IsActive then return end
        if shhhhnayy05.IsDrawing then
            self:SculptAt(touch.Position)
        end
    end)
    
    UserInputService.TouchEnded:Connect(function(touch, gameProcessed)
        shhhhnayy05.IsDrawing = false
    end)
    
    -- Mouse fallback
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not shhhhnayy05.Config.IsActive then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            shhhhnayy05.IsDrawing = true
            self:SculptAt(input.Position)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            shhhhnayy05.IsDrawing = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if shhhhnayy05.IsDrawing and input.UserInputType == Enum.UserInputType.MouseMovement then
            self:SculptAt(input.Position)
        end
    end)
end

--// Sculpt At
function shhhhnayy05:SculptAt(screenPos)
    local cam = Workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
    
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {shhhhnayy05.GUI.Preview, LocalPlayer.Character}
    
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
    if result then
        if shhhhnayy05.Config.Mode == "Smooth" then
            self:ApplySmooth(result.Position)
        else
            self:ApplyFlatten(result.Position)
        end
    end
end

--// Apply Smooth
function shhhhnayy05:ApplySmooth(pos)
    local size = shhhhnayy05.Config.BrushSize
    local str = shhhhnayy05.Config.BrushStrength
    
    local region = Region3.new(pos - Vector3.new(size, size, size), pos + Vector3.new(size, size, size))
    region = region:ExpandToGrid(4)
    
    local mm, om = Workspace.Terrain:ReadVoxels(region, 4)
    local res = mm.Size
    
    for x = 1, res.X do
        for y = 1, res.Y do
            for z = 1, res.Z do
                local vPos = region.CFrame.Position + Vector3.new((x - 1) * 4, (y - 1) * 4, (z - 1) * 4)
                local dist = (vPos - pos).Magnitude
                
                local inBrush = false
                if shhhhnayy05.Config.Shape == "Block" then
                    inBrush = math.abs(vPos.X - pos.X) <= size and math.abs(vPos.Y - pos.Y) <= size and math.abs(vPos.Z - pos.Z) <= size
                else
                    inBrush = dist <= size
                end
                
                if inBrush then
                    local falloff = 1
                    if shhhhnayy05.Config.Shape == "Ball" then
                        falloff = math.max(0, 1 - (dist / size))
                        falloff = falloff * falloff * (3 - 2 * falloff)
                    end
                    
                    local newOcc = math.clamp(om[x][y][z] + (str * falloff * 0.5), 0, 1)
                    if newOcc > 0.01 then
                        om[x][y][z] = newOcc
                        mm[x][y][z] = shhhhnayy05.CurrentMaterial
                        
                        local key = string.format("%d,%d,%d", math.floor(vPos.X / 4) * 4, math.floor(vPos.Y / 4) * 4, math.floor(vPos.Z / 4) * 4)
                        shhhhnayy05.TerrainData[key] = {
                            x = math.floor(vPos.X / 4) * 4,
                            y = math.floor(vPos.Y / 4) * 4,
                            z = math.floor(vPos.Z / 4) * 4,
                            occ = newOcc,
                            mat = tostring(shhhhnayy05.CurrentMaterial):gsub("Enum.Material.", "")
                        }
                    end
                end
            end
        end
    end
    
    Workspace.Terrain:WriteVoxels(region, 4, mm, om)
end

--// Apply Flatten
function shhhhnayy05:ApplyFlatten(pos)
    local size = shhhhnayy05.Config.BrushSize
    local str = shhhhnayy05.Config.BrushStrength
    
    local sample = Region3.new(pos - Vector3.new(size, 0, size), pos + Vector3.new(size, 4, size))
    sample = sample:ExpandToGrid(4)
    local sm, so = Workspace.Terrain:ReadVoxels(sample, 4)
    
    local targetY = pos.Y
    for x = 1, sm.Size.X do
        for z = 1, sm.Size.Z do
            for y = sm.Size.Y, 1, -1 do
                if so[x][y][z] > 0.5 then
                    targetY = sample.CFrame.Position.Y + (y - 1) * 4
                    break
                end
            end
        end
    end
    
    local region = Region3.new(
        Vector3.new(pos.X - size, targetY - size, pos.Z - size),
        Vector3.new(pos.X + size, targetY + size, pos.Z + size)
    )
    region = region:ExpandToGrid(4)
    
    local mm, om = Workspace.Terrain:ReadVoxels(region, 4)
    local res = mm.Size
    
    for x = 1, res.X do
        for y = 1, res.Y do
            for z = 1, res.Z do
                local vPos = region.CFrame.Position + Vector3.new((x - 1) * 4, (y - 1) * 4, (z - 1) * 4)
                local dist = Vector2.new(vPos.X - pos.X, vPos.Z - pos.Z).Magnitude
                
                local inBrush = false
                if shhhhnayy05.Config.Shape == "Block" then
                    inBrush = math.abs(vPos.X - pos.X) <= size and math.abs(vPos.Z - pos.Z) <= size
                else
                    inBrush = dist <= size
                end
                
                if inBrush then
                    local diff = targetY - vPos.Y
                    local blend = str
                    if shhhhnayy05.Config.Shape == "Ball" then
                        blend = str * math.max(0, 1 - (dist / size))
                    end
                    
                    if math.abs(diff) < 12 then
                        local targetOcc = (math.abs(diff) < 2) and 1 or math.max(0, 1 - math.abs(diff) / 8)
                        local newOcc = math.clamp(om[x][y][z] + (targetOcc - om[x][y][z]) * blend, 0, 1)
                        
                        if newOcc > 0.01 then
                            om[x][y][z] = newOcc
                            mm[x][y][z] = shhhhnayy05.CurrentMaterial
                            
                            local key = string.format("%d,%d,%d", math.floor(vPos.X / 4) * 4, math.floor(vPos.Y / 4) * 4, math.floor(vPos.Z / 4) * 4)
                            shhhhnayy05.TerrainData[key] = {
                                x = math.floor(vPos.X / 4) * 4,
                                y = math.floor(vPos.Y / 4) * 4,
                                z = math.floor(vPos.Z / 4) * 4,
                                occ = newOcc,
                                mat = tostring(shhhhnayy05.CurrentMaterial):gsub("Enum.Material.", "")
                            }
                        end
                    end
                end
            end
        end
    end
    
    Workspace.Terrain:WriteVoxels(region, 4, mm, om)
end

--// Update Preview (FIXED)
function shhhhnayy05:UpdatePreview()
    local g = shhhhnayy05.GUI
    if not g then return end
    
    -- FIX: Check Transparency instead of Visible
    if not shhhhnayy05.Config.IsActive then
        g.Preview.Transparency = 1
        return
    end
    
    local mouse = LocalPlayer:GetMouse()
    local cam = Workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
    
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {g.Preview, LocalPlayer.Character}
    
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
    if result then
        g.Preview.Transparency = 0.6
        g.Preview.CFrame = CFrame.new(result.Position)
        g.Preview.Color = shhhhnayy05.Config.Mode == "Smooth" and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(255, 200, 0)
    else
        g.Preview.Transparency = 1
    end
end

--// Generate Script
function shhhhnayy05:GenerateScript()
    local lines = {}
    
    table.insert(lines, "--// shhhhnayy05 Terrain Script")
    table.insert(lines, "local Terrain = workspace.Terrain")
    table.insert(lines, "")
    table.insert(lines, "--// Colors")
    
    local grassCol = self.ColorPalettes.Grass[self.CurrentColors.Grass].color
    table.insert(lines, string.format("Terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(%d,%d,%d))", 
        math.floor(grassCol.R * 255), math.floor(grassCol.G * 255), math.floor(grassCol.B * 255)))
    
    local groundCol = self.ColorPalettes.Ground[self.CurrentColors.Ground].color
    table.insert(lines, string.format("Terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(%d,%d,%d))", 
        math.floor(groundCol.R * 255), math.floor(groundCol.G * 255), math.floor(groundCol.B * 255)))
    
    local leafyCol = self.ColorPalettes.LeafyGrass[self.CurrentColors.LeafyGrass].color
    table.insert(lines, string.format("Terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(%d,%d,%d))", 
        math.floor(leafyCol.R * 255), math.floor(leafyCol.G * 255), math.floor(leafyCol.B * 255)))
    
    local rockCol = self.ColorPalettes.Rock[self.CurrentColors.Rock].color
    table.insert(lines, string.format("Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(%d,%d,%d))", 
        math.floor(rockCol.R * 255), math.floor(rockCol.G * 255), math.floor(rockCol.B * 255)))
    
    table.insert(lines, "")
    table.insert(lines, "--// Voxels")
    table.insert(lines, "local voxels = {")
    
    local count = 0
    for k, v in pairs(shhhhnayy05.TerrainData) do
        if v.occ > 0.1 then
            table.insert(lines, string.format("    {x=%d,y=%d,z=%d,occ=%.2f,mat=Enum.Material.%s},", 
                v.x, v.y, v.z, v.occ, v.mat))
            count = count + 1
            if count >= 10000 then break end
        end
    end
    
    table.insert(lines, "}")
    table.insert(lines, "")
    table.insert(lines, "for _,v in pairs(voxels) do")
    table.insert(lines, "    local r = Region3.new(Vector3.new(v.x,v.y,v.z), Vector3.new(v.x+4,v.y+4,v.z+4))")
    table.insert(lines, "    local mm,om = Terrain:ReadVoxels(r,4)")
    table.insert(lines, "    mm[1][1][1] = v.mat")
    table.insert(lines, "    om[1][1][1] = v.occ")
    table.insert(lines, "    Terrain:WriteVoxels(r,4,mm,om)")
    table.insert(lines, "end")
    table.insert(lines, "print('shhhhnayy05: ' .. #voxels .. ' voxels')")
    
    shhhhnayy05.GUI.ScriptBox.Text = table.concat(lines, "\n")
    shhhhnayy05.GUI.ScriptWindow.Visible = true
    self:ShowNotif("📜 Script: " .. count .. " voxels")
end

--// Show Notification
function shhhhnayy05:ShowNotif(text)
    local g = shhhhnayy05.GUI
    if not g then return end
    
    local n = Instance.new("Frame")
    n.Name = "Notif"
    n.Size = UDim2.new(0, 280, 0, 50)
    n.Position = UDim2.new(0.5, -140, 0, -60)
    n.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    n.BorderSizePixel = 0
    n.Parent = g.ScreenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = n
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 200, 255)
    stroke.Thickness = 2
    stroke.Parent = n
    
    local l = Instance.new("TextLabel")
    l.Name = "Text"
    l.Size = UDim2.new(1, -20, 1, 0)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(255, 255, 255)
    l.TextSize = 14
    l.Font = Enum.Font.GothamBold
    l.Parent = n
    
    TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Position = UDim2.new(0.5, -140, 0, 30)
    }):Play()
    
    task.delay(3, function()
        TweenService:Create(n, TweenInfo.new(0.3), {
            Position = UDim2.new(0.5, -140, 0, -60)
        }):Play()
        task.wait(0.3)
        n:Destroy()
    end)
end

