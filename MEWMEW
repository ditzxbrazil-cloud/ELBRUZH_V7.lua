--// Touch-Compatible Button Connection
function shhhhnayy05:ConnectButton(btn, callback)
    -- Primary: TouchTap for mobile
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        end
    end)
    
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- Restore color based on button type
            if btn.Name:find("Smooth") then
                btn.BackgroundColor3 = shhhhnayy05.Config.Mode == "Smooth" and Color3.fromRGB(0,150,255) or Color3.fromRGB(50,50,50)
            elseif btn.Name:find("Flatten") then
                btn.BackgroundColor3 = shhhhnayy05.Config.Mode == "Flatten" and Color3.fromRGB(0,150,255) or Color3.fromRGB(50,50,50)
            elseif btn.Name:find("Block") then
                btn.BackgroundColor3 = shhhhnayy05.Config.Shape == "Block" and Color3.fromRGB(0,150,100) or Color3.fromRGB(50,50,50)
            elseif btn.Name:find("Ball") then
                btn.BackgroundColor3 = shhhhnayy05.Config.Shape == "Ball" and Color3.fromRGB(0,150,100) or Color3.fromRGB(50,50,50)
            else
                -- Default restore
                local original = btn:GetAttribute("OriginalColor") or btn.BackgroundColor3
                btn.BackgroundColor3 = original
            end
            callback()
        end
    end)
    
    -- Store original color
    btn:SetAttribute("OriginalColor", btn.BackgroundColor3)
end

