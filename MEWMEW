--// Cek apakah object adalah checkpoint
local function isCheckpoint(instance)
    if not instance then return false end
    
    local name = string.lower(instance.Name)
    
    --// Pattern umum untuk checkpoint
    local checkpointPatterns = {
        "checkpoint", "check", "cp", "stage", "level", "spawn", "start", "begin",
        "point", "save", "respawn", "progress", "waypoint", "flag", "goal",
        "finish", "end", "teleport", "tp", "portal", "door", "entry", "exit"
    }
    
    for _, pattern in ipairs(checkpointPatterns) do
        if string.find(name, pattern) then
            return true
        end
    end
    
    --// Cek attribute checkpoint
    if instance:GetAttribute("Checkpoint") or instance:GetAttribute("Stage") then
        return true
    end
    
    --// Cek jika ada TouchInterest (biasanya checkpoint)
    if instance:FindFirstChild("TouchInterest") then
        return true
    end
    
    --// Cek jika ada ClickDetector (checkpoint interaktif)
    if instance:FindFirstChild("ClickDetector") then
        return true
    end
    
    --// Cek jika ada ProximityPrompt (checkpoint modern)
    if instance:FindFirstChild("ProximityPrompt") then
        return true
    end
    
    return false
end

--// Simpan checkpoint ke storage
local function storeCheckpoint(instance, position, isHidden)
    if not instance then return end
    
    local checkpointId = tostring(instance)
    
    --// Cek apakah sudah ada
    for _, cp in ipairs(CheckpointData.stored) do
        if cp.id == checkpointId then
            return -- Sudah tersimpan
        end
    end
    
    local checkpointInfo = {
        id = checkpointId,
        name = instance.Name,
        position = position or (instance:IsA("BasePart") and instance.Position) or nil,
        cframe = instance:IsA("BasePart") and instance.CFrame or nil,
        instance = instance,
        isHidden = isHidden or false,
        isActive = instance.Parent ~= nil,
        detectedTime = tick(),
        path = instance:GetFullName()
    }
    
    table.insert(CheckpointData.stored, checkpointInfo)
    
    --// Update label
    local total = #CheckpointData.stored
    local active = 0
    local hidden = 0
    
    for _, cp in ipairs(CheckpointData.stored) do
        if cp.isActive then active = active + 1 end
        if cp.isHidden then hidden = hidden + 1 end
    end
    
    TotalCheckpointLabel.Text = string.format("📊 Total: %d | 🎯 Active: %d | 👻 Hidden: %d", total, active, hidden)
    
    return checkpointInfo
end

--// Scan seluruh workspace untuk checkpoint (termasuk yang tersembunyi)
local function scanAllCheckpoints()
    StatusLabel.Text = "Status: Scanning..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    local foundCount = 0
    
    --// Recursive scan function
    local function scanContainer(container, depth)
        if depth > 10 then return end -- Limit depth
        
        for _, child in ipairs(container:GetChildren()) do
            if isCheckpoint(child) then
                local isHidden = false
                
                --// Cek apakah hidden (tidak terlihat atau di dalam folder tersembunyi)
                if child:IsA("BasePart") then
                    if child.Transparency > 0.9 or not child.CanCollide then
                        isHidden = true
                    end
                end
                
                --// Cek parent yang mungkin menyembunyikan
                local parent = child.Parent
                while parent and parent ~= workspace do
                    if parent:IsA("Folder") or parent:IsA("Model") then
                        local parentName = string.lower(parent.Name)
                        if string.find(parentName, "hidden") or string.find(parentName, "secret") or 
                           string.find(parentName, "locked") or string.find(parentName, "unavailable") then
                            isHidden = true
                            break
                        end
                    end
                    parent = parent.Parent
                end
                
                storeCheckpoint(child, nil, isHidden)
                foundCount = foundCount + 1
            end
            
            --// Scan recursively tapi hanya untuk container tertentu
            if child:IsA("Folder") or child:IsA("Model") or child:IsA("Configuration") then
                scanContainer(child, depth + 1)
            end
        end
    end
    
    --// Scan workspace
    scanContainer(workspace, 0)
    
    --// Scan ReplicatedStorage (kadang checkpoint disimpan di sana)
    pcall(function()
        scanContainer(game:GetService("ReplicatedStorage"), 0)
    end)
    
    --// Scan ServerStorage
    pcall(function()
        scanContainer(game:GetService("ServerStorage"), 0)
    end)
    
    StatusLabel.Text = string.format("Status: Found %d checkpoints", foundCount)
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    --// Update UI list
    updateCheckpointList()
    
    return foundCount
end

