        shhhhnayy05.Config.Mode = "Flatten"
        g.FlattenBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        g.SmoothBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        self:ShowNotif("Mode: FLATTEN")
    end)
    
    -- Shape: Block
    self:ConnectButton(g.BlockBtn, function()
        shhhhnayy05.Config.Shape = "Block"
        g.BlockBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
        g.BallBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        g.Preview.Shape = Enum.PartType.Block
        self:ShowNotif("Shape: BLOCK")
    end)
    
    -- Shape: Ball
    self:ConnectButton(g.BallBtn, function()
