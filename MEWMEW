--// Get Current Color Based on Material
local function GetCurrentColorForMaterial(material)
	if material == Enum.Material.Grass then
		return grassColors[currentGrassColorIndex].color
	elseif material == Enum.Material.Ground then
		return groundColors[currentGroundColorIndex].color
	elseif material == Enum.Material.LeafyGrass then
		return leavygrassColors[currentLeavygrassColorIndex].color
	elseif material == Enum.Material.Rock then
		return rockColors[currentRockColorIndex].color
	else
		return shhhhnayy05.CurrentColor
	end
end

