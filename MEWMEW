-- Noise Functions untuk generate terrain realistis
local function shhhhnayy05_Noise(x, y, seed)
    local n = math.sin(x * 12.9898 + y * 78.233 + seed) * 43758.5453
    return n - math.floor(n)
end

local function shhhhnayy05_SmoothNoise(x, y, seed)
    local corners = (shhhhnayy05_Noise(x-1, y-1, seed) + shhhhnayy05_Noise(x+1, y-1, seed) + 
                     shhhhnayy05_Noise(x-1, y+1, seed) + shhhhnayy05_Noise(x+1, y+1, seed)) / 16
    local sides = (shhhhnayy05_Noise(x-1, y, seed) + shhhhnayy05_Noise(x+1, y, seed) + 
                   shhhhnayy05_Noise(x, y-1, seed) + shhhhnayy05_Noise(x, y+1, seed)) / 8
    local center = shhhhnayy05_Noise(x, y, seed) / 4
    return corners + sides + center
end

local function shhhhnayy05_InterpolatedNoise(x, y, seed)
    local integer_X = math.floor(x)
    local fractional_X = x - integer_X
    local integer_Y = math.floor(y)
    local fractional_Y = y - integer_Y
    
    local v1 = shhhhnayy05_SmoothNoise(integer_X, integer_Y, seed)
    local v2 = shhhhnayy05_SmoothNoise(integer_X + 1, integer_Y, seed)
    local v3 = shhhhnayy05_SmoothNoise(integer_X, integer_Y + 1, seed)
    local v4 = shhhhnayy05_SmoothNoise(integer_X + 1, integer_Y + 1, seed)
    
    local i1 = v1 + fractional_X * (v2 - v1)
    local i2 = v3 + fractional_X * (v4 - v3)
    
    return i1 + fractional_Y * (i2 - i1)
end

local function shhhhnayy05_PerlinNoise(x, y, seed, octaves, persistence)
    local total = 0
    local frequency = 1
    local amplitude = 1
    local maxValue = 0
    
    for i = 1, octaves do
        total = total + shhhhnayy05_InterpolatedNoise(x * frequency, y * frequency, seed) * amplitude
        maxValue = maxValue + amplitude
        amplitude = amplitude * persistence
        frequency = frequency * 2
    end
    
    return total / maxValue
end

-- Terrain Generator Class
local shhhhnayy05_TerrainGenerator = {}
shhhhnayy05_TerrainGenerator.__index = shhhhnayy05_TerrainGenerator

function shhhhnayy05_TerrainGenerator.new()
    local self = setmetatable({}, shhhhnayy05_TerrainGenerator)
    self.TerrainData = {}
    self.GeneratedTerrain = {}
    self.IsGenerating = false
    return self
end

function shhhhnayy05_TerrainGenerator:GenerateFromCoordinates(lat, long, size, heightScale, detail, generateWater)
    if self.IsGenerating then return end
    self.IsGenerating = true
    
    -- Simulasi fetch data elevation berdasarkan koordinat
    -- Dalam implementasi real, ini akan memanggil API seperti Google Elevation API
    local seed = (lat * 10000 + long * 100) % 1000000
    local octaves = detail == "Low" and 2 or (detail == "Medium" and 4 or 6)
    
    local terrainData = {
        Coordinates = {Lat = lat, Long = long},
        Size = size,
        HeightScale = heightScale,
        Detail = detail,
        HasWater = generateWater,
        Heights = {},
        Materials = {},
        Seed = seed,
        Timestamp = os.time()
    }
    
    -- Generate heightmap menggunakan Perlin Noise
    -- Ini mensimulasikan terrain real berdasarkan koordinat
    for x = 1, size do
        terrainData.Heights[x] = {}
        terrainData.Materials[x] = {}
        
        for z = 1, size do
            -- Scale coordinates untuk noise
            local nx = x / size * 4
            local nz = z / size * 4
            
            -- Multiple octaves untuk detail
            local height = shhhhnayy05_PerlinNoise(nx, nz, seed, octaves, 0.5)
            
            -- Tambahkan variasi regional berdasarkan latitude
            local regionalFactor = math.sin(lat * math.pi / 180) * 0.3
            height = height + regionalFactor * shhhhnayy05_PerlinNoise(nx * 0.5, nz * 0.5, seed + 1000, 2, 0.5)
            
            -- Normalize ke 0-1
            height = math.clamp((height + 1) / 2, 0, 1)
            
            -- Apply height scale dengan variasi
            local finalHeight = math.floor(height * heightScale)
            terrainData.Heights[x][z] = finalHeight
            
            -- Determine material berdasarkan height dan slope
            local material = self:GetMaterialFromHeight(finalHeight, heightScale, generateWater)
            terrainData.Materials[x][z] = material
        end
        
        -- Progress update setiap 10 rows
        if x % 10 == 0 then
            local progress = x / size
            self:UpdateProgress(progress, "Generating heightmap...")
            task.wait()
        end
    end
    
    self.TerrainData = terrainData
    self.IsGenerating = false
    return terrainData
end

function shhhhnayy05_TerrainGenerator:GetMaterialFromHeight(height, maxHeight, generateWater)
    local waterLevel = maxHeight * 0.3
    
    if generateWater and height < waterLevel then
        return Enum.Material.Water
    elseif height < waterLevel + 2 then
        return Enum.Material.Sand
    elseif height < maxHeight * 0.6 then
        return Enum.Material.Grass
    elseif height < maxHeight * 0.8 then
        return Enum.Material.Rock
    else
        return Enum.Material.Snow
    end
end

function shhhhnayy05_TerrainGenerator:SpawnTerrain(terrainData, updateProgress)
    local terrain = Workspace.Terrain
    local size = terrainData.Size
    local heights = terrainData.Heights
    local materials = terrainData.Materials
    
    -- Clear existing generated terrain
    self:ClearGeneratedTerrain()
    
    -- Calculate center offset
    local centerOffset = Vector3.new(-size/2, 0, -size/2)
    
    -- Generate terrain menggunakan FillBlock dan FillCylinder
    for x = 1, size, 4 do
        for z = 1, size, 4 do
            local height = heights[x][z]
            local material = materials[x][z]
            
            local pos = Vector3.new(x + centerOffset.X, height/2, z + centerOffset.Z)
            local size_vec = Vector3.new(4, math.max(height, 1), 4)
            
            -- Buat region terrain
            if material == Enum.Material.Water then
                -- Water level
                terrain:FillBlock(CFrame.new(pos.X, 5, pos.Z), Vector3.new(4, 10, 4), material)
            else
                -- Ground terrain
                terrain:FillBlock(CFrame.new(pos.X, height/2, pos.Z), size_vec, material)
            end
            
            -- Simpan reference untuk clear nanti
            table.insert(self.GeneratedTerrain, {
                Position = pos,
                Size = size_vec,
                Material = material
            })
        end
        
        -- Update progress
        if x % 20 == 0 then
            local progress = x / size
            updateProgress(progress, "Spawning terrain blocks...")
            task.wait()
        end
    end
    
    -- Add decorative elements (trees, rocks) untuk Grass areas
    self:AddDecorations(terrainData, centerOffset)
    
    return true
end

function shhhhnayy05_TerrainGenerator:AddDecorations(terrainData, centerOffset)
    local size = terrainData.Size
    local heights = terrainData.Heights
    local materials = terrainData.Materials
    
    for x = 1, size, 8 do
        for z = 1, size, 8 do
            if materials[x][z] == Enum.Material.Grass then
                local height = heights[x][z]
                local pos = Vector3.new(x + centerOffset.X, height + 1, z + centerOffset.Z)
                
                -- Random chance untuk tree/rock
                local rand = math.random()
                if rand > 0.85 then
                    -- Spawn tree
                    self:CreateTree(pos)
                elseif rand > 0.7 then
                    -- Spawn rock
                    self:CreateRock(pos)
                end
            end
        end
    end
end

function shhhhnayy05_TerrainGenerator:CreateTree(position)
    local tree = Instance.new("Model")
    tree.Name = "shhhhnayy05_Tree"
    
    -- Trunk
    local trunk = Instance.new("Part")
    trunk.Name = "Trunk"
    trunk.Size = Vector3.new(2, 8, 2)
    trunk.Position = position + Vector3.new(0, 4, 0)
    trunk.Material = Enum.Material.Wood
    trunk.BrickColor = BrickColor.new("Brown")
    trunk.Anchored = true
    trunk.Parent = tree
    
    -- Leaves
    local leaves = Instance.new("Part")
    leaves.Name = "Leaves"
    leaves.Size = Vector3.new(8, 6, 8)
    leaves.Position = position + Vector3.new(0, 9, 0)
    leaves.Material = Enum.Material.LeafyGrass
    leaves.BrickColor = BrickColor.new("Bright green")
    leaves.Anchored = true
    leaves.Parent = tree
    
    tree.Parent = Workspace
    table.insert(self.GeneratedTerrain, tree)
end

function shhhhnayy05_TerrainGenerator:CreateRock(position)
    local rock = Instance.new("Part")
    rock.Name = "shhhhnayy05_Rock"
    rock.Size = Vector3.new(math.random(3, 5), math.random(2, 4), math.random(3, 5))
    rock.Position = position + Vector3.new(0, rock.Size.Y/2, 0)
    rock.Material = Enum.Material.Rock
    rock.BrickColor = BrickColor.new("Medium stone grey")
    rock.Anchored = true
    rock.Parent = Workspace
    
    table.insert(self.GeneratedTerrain, rock)
end

function shhhhnayy05_TerrainGenerator:ClearGeneratedTerrain()
    for _, obj in ipairs(self.GeneratedTerrain) do
        if typeof(obj) == "Instance" then
            obj:Destroy()
        end
    end
    self.GeneratedTerrain = {}
    
    -- Clear terrain regions
    local terrain = Workspace.Terrain
    terrain:Clear()
end

function shhhhnayy05_TerrainGenerator:UpdateProgress(progress, message)
    -- Will be connected to GUI
end

-- Export ke Script Function
function shhhhnayy05_TerrainGenerator:ExportToScript()
    if not self.TerrainData or not self.TerrainData.Heights then
        return nil, "No terrain data to export"
    end
    
    local data = self.TerrainData
    local scriptLines = {}
    
    table.insert(scriptLines, "--[[")
    table.insert(scriptLines, "    shhhhnayy05 Terrain Script Export")
    table.insert(scriptLines, "    Generated: " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(scriptLines, "    Coordinates: " .. data.Coordinates.Lat .. ", " .. data.Coordinates.Long)
    table.insert(scriptLines, "    Size: " .. data.Size .. "x" .. data.Size)
    table.insert(scriptLines, "]]--")
    table.insert(scriptLines, "")
    table.insert(scriptLines, "local Workspace = game:GetService(\"Workspace\")")
    table.insert(scriptLines, "local terrain = Workspace.Terrain")
    table.insert(scriptLines, "")
    table.insert(scriptLines, "-- Terrain Data")
    table.insert(scriptLines, "local TerrainConfig = {")
    table.insert(scriptLines, "    Size = " .. data.Size .. ",")
    table.insert(scriptLines, "    HeightScale = " .. data.HeightScale .. ",")
    table.insert(scriptLines, "    Seed = " .. data.Seed .. ",")
    table.insert(scriptLines, "    HasWater = " .. tostring(data.HasWater))
    table.insert(scriptLines, "}")
    table.insert(scriptLines, "")
    table.insert(scriptLines, "-- Heightmap Data (Compressed)")
    table.insert(scriptLines, "local HeightMap = {")
    
    -- Compress height data
    for x = 1, data.Size, 10 do
        local rowData = {}
        for z = 1, data.Size, 10 do
            if data.Heights[x] and data.Heights[x][z] then
                table.insert(rowData, math.floor(data.Heights[x][z]))
            end
        end
        if #rowData > 0 then
            table.insert(scriptLines, "    [" .. x .. "] = {" .. table.concat(rowData, ",") .. "},")
        end
    end
    
    table.insert(scriptLines, "}")
    table.insert(scriptLines, "")
    table.insert(scriptLines, "-- Material Map")
    table.insert(scriptLines, "local MaterialMap = {")
    
    local materialNames = {
        [Enum.Material.Grass] = "Enum.Material.Grass",
        [Enum.Material.Rock] = "Enum.Material.Rock",
        [Enum.Material.Sand] = "Enum.Material.Sand",
        [Enum.Material.Water] = "Enum.Material.Water",
        [Enum.Material.Snow] = "Enum.Material.Snow"
    }
    
    for x = 1, data.Size, 20 do
        for z = 1, data.Size, 20 do
            if data.Materials[x] and data.Materials[x][z] then
                local mat = materialNames[data.Materials[x][z]] or "Enum.Material.Grass"
                table.insert(scriptLines, "    {Pos = Vector3.new(" .. x .. ",0," .. z .. "), Mat = " .. mat .. "},")
            end
        end
    end
    
    table.insert(scriptLines, "}")
    table.insert(scriptLines, "")
    table.insert(scriptLines, "-- Generate Function")
    table.insert(scriptLines, "local function GenerateTerrain()")
    table.insert(scriptLines, "    terrain:Clear()")
    table.insert(scriptLines, "    local centerOffset = Vector3.new(-TerrainConfig.Size/2, 0, -TerrainConfig.Size/2)")
    table.insert(scriptLines, "    ")
    table.insert(scriptLines, "    for x = 1, TerrainConfig.Size, 4 do")
    table.insert(scriptLines, "        for z = 1, TerrainConfig.Size, 4 do")
    table.insert(scriptLines, "            local height = HeightMap[x] and HeightMap[x][math.floor(z/10)+1] or 10")
    table.insert(scriptLines, "            local pos = Vector3.new(x + centerOffset.X, height/2, z + centerOffset.Z)")
    table.insert(scriptLines, "            local size = Vector3.new(4, math.max(height, 1), 4)")
    table.insert(scriptLines, "            terrain:FillBlock(CFrame.new(pos), size, Enum.Material.Grass)")
    table.insert(scriptLines, "        end")
    table.insert(scriptLines, "    end")
    table.insert(scriptLines, "    print(\"Terrain generated by shhhhnayy05!\")")
    table.insert(scriptLines, "end")
    table.insert(scriptLines, "")
    table.insert(scriptLines, "GenerateTerrain()")
    
    return table.concat(scriptLines, "\n"), nil
end

