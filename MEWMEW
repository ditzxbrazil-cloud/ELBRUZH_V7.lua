    if not Terrain then return end
    local gC = grassColors[currentGrassColorIndex].color
    local grC = groundColors[currentGroundColorIndex].color
    local lC = leafyGrassColors[currentLeafyColorIndex].color
    local rC = rockColors[currentRockColorIndex].color

    local generatedCode = "-- Script Konfigurasi Terrain (Final)\nlocal Terrain = workspace:FindFirstChildOfClass(\"Terrain\")\nif Terrain then\n\tTerrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(" .. math.floor(gC.R*255) .. ", " .. math.floor(gC.G*255) .. ", " .. math.floor(gC.B*255) .. "))\n\tTerrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(" .. math.floor(grC.R*255) .. ", " .. math.floor(grC.G*255) .. ", " .. math.floor(grC.B*255) .. "))\n\tTerrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(" .. math.floor(lC.R*255) .. ", " .. math.floor(lC.G*255) .. ", " .. math.floor(lC.B*255) .. "))\n\tTerrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(" .. math.floor(rC.R*255) .. ", " .. math.floor(rC.G*255) .. ", " .. math.floor(rC.B*255) .. "))\nend"
    swTextBox.Text = generatedCode
end

-- --- LOGIKA EDITING TERRAIN ---
local function getMousePosition()
    if not Mouse then 
        return Vector3.new(0,0,0) 
    end
    local success, result = pcall(function()
        return Mouse.Hit.Position
    end)
    if success then return result end
    return Vector3.new(0,0,0)
end

if Mouse then
    Mouse.Button1Down:Connect(function()
        if not isActive then return end
        if not isDrawing then
            isDrawing = true
            flattenLevel = nil
        end
    end)

    Mouse.Button1Up:Connect(function()
        isDrawing = false
        flattenLevel = nil
    end)
end

RunService.RenderStepped:Connect(function()
    if not isActive or not isDrawing then return end
    
    if Mouse then
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and 
           not UserInputService:IsTouchPressed() then
            isDrawing = false
            flattenLevel = nil
            return
        end
    end

    local position = getMousePosition()
    if position.Magnitude == 0 then return end
    
    if currentTool == "Draw" then
        if Terrain then
            Terrain:FillBlock(CFrame.new(position), brushSize, currentMaterial)
        end
    elseif currentTool == "Flatten" then
        if not flattenLevel then
            flattenLevel = position.Y
        end
        
        if Terrain then
            local areaSize = Vector3.new(brushSize.X, 4, brushSize.Z)
            Terrain:FillBlock(CFrame.new(position.X, flattenLevel, position.Z), areaSize, currentMaterial)
        end
    end
end)

