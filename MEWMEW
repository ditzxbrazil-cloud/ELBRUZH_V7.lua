end

--// SET MODE
function shhhhnayy05:SetMode(mode)
    self.Config.CurrentMode = mode
    
    -- Update button visuals
    if mode == "Smooth" then
        self.GUI.SmoothBtn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
        self.GUI.FlattenBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        self.GUI.FlattenDisplay.Visible = false
        self.GUI.ResetFlattenBtn.Visible = false
    else
        self.GUI.SmoothBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        self.GUI.FlattenBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 100)
        self.GUI.FlattenDisplay.Visible = true
        self.GUI.ResetFlattenBtn.Visible = true
    end
    
    if self.Config.ModeEnabled then
        self.GUI.StatusLabel.Text = "✏️ Mode: " .. mode .. " | " .. self.Config.Shape
    end
end

