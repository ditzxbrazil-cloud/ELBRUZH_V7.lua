                Z = instance.AttachmentRight.Z
            }
            data.Properties.AttachmentUp = {
                X = instance.AttachmentUp.X,
                Y = instance.AttachmentUp.Y,
                Z = instance.AttachmentUp.Z
            }
            
        --// JOINTS
        elseif instance:IsA("JointInstance") then
            data.Properties.Part0 = instance.Part0 and instance.Part0.Name or nil
            data.Properties.Part1 = instance.Part1 and instance.Part1.Name or nil
            
        --// BEAMS
        elseif instance:IsA("Beam") then
            data.Properties.Texture = instance.Texture
            data.Properties.TextureLength = instance.TextureLength
            data.Properties.TextureMode = tostring(instance.TextureMode)
            data.Properties.TextureSpeed = instance.TextureSpeed
            data.Properties.Color = tostring(instance.Color)
            data.Properties.Transparency = tostring(instance.Transparency)
            data.Properties.Width0 = instance.Width0
            data.Properties.Width1 = instance.Width1
            data.Properties.Segments = instance.Segments
            data.Properties.Attachment0 = instance.Attachment0 and instance.Attachment0.Name or nil
            data.Properties.Attachment1 = instance.Attachment1 and instance.Attachment1.Name or nil
            
        --// ATTACHMENT
        elseif instance:IsA("Attachment") then
            data.Properties.WorldPosition = {
                X = instance.WorldPosition.X,
                Y = instance.WorldPosition.Y,
                Z = instance.WorldPosition.Z
            }
            data.Properties.WorldOrientation = {
                X = instance.WorldOrientation.X,
                Y = instance.WorldOrientation.Y,
                Z = instance.WorldOrientation.Z
            }
            data.Properties.Axis = {
                X = instance.Axis.X,
                Y = instance.Axis.Y,
                Z = instance.Axis.Z
            }
            data.Properties.SecondaryAxis = {
                X = instance.SecondaryAxis.X,
                Y = instance.SecondaryAxis.Y,
                Z = instance.SecondaryAxis.Z
            }
            
        --// TRAIL
        elseif instance:IsA("Trail") then
            data.Properties.Color = tostring(instance.Color)
            data.Properties.Transparency = tostring(instance.Transparency)
            data.Properties.Lifetime = instance.Lifetime
            data.Properties.MinLength = instance.MinLength
            data.Properties.WidthScale = tostring(instance.WidthScale)
            data.Properties.Attachment0 = instance.Attachment0 and instance.Attachment0.Name or nil
            data.Properties.Attachment1 = instance.Attachment1 and instance.Attachment1.Name or nil
            
        --// REGION3 VALUE
        elseif instance:IsA("Region3Value") then
            local min = instance.Value.CFrame.Position - (instance.Value.Size / 2)
            local max = instance.Value.CFrame.Position + (instance.Value.Size / 2)
            data.Properties.Value = {
                Min = {X = min.X, Y = min.Y, Z = min.Z},
                Max = {X = max.X, Y = max.Y, Z = max.Z}
            }
            
        --// VECTOR3 RANGE VALUE
        elseif instance:IsA("Vector3Range") then
            --// Custom type handling
            
        --// ANYTHING ELSE - Store basic info
        else
            self.CopyStats.Others = self.CopyStats.Others + 1
            --// Try to get common properties
            pcall(function()
                if instance:FindFirstChild("Value") then
                    data.Properties.Value = instance.Value
                end
            end)
        end
    end)
    
    --// Recursively serialize children
    for _, child in ipairs(instance:GetChildren()) do
        --// Skip Terrain and Cameras
        if not child:IsA("Terrain") and not child:IsA("Camera") then
            local childData = self:SerializeInstance(child, depth + 1, stats)
            if childData then
                table.insert(data.Children, childData)
            end
        end
    end
    
    return data
end

