-- shhhhnayy05 ESP System
local shhhhnayy05_ESPSystem = {}

function shhhhnayy05_ESPSystem.CreateESP(player, data)
    if not player or not player.Character then return nil end
    
    local character = player.Character
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return nil end
    
    -- Get executor info for color and text
    local executorName = "Clean"
    local espColor = shhhhnayy05_Config.Colors.Success
    local hasExecutor = false
    
    if #data.Executors > 0 then
        hasExecutor = true
        executorName = data.Executors[1].Name
        espColor = data.Executors[1].Color or shhhhnayy05_Config.Colors.Danger
        
        -- If multiple executors, show count
        if #data.Executors > 1 then
            executorName = executorName .. " (+" .. (#data.Executors - 1) .. ")"
        end
    end
    
    -- Create BillboardGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "shhhhnayy05_ESP_" .. player.Name
    billboard.Adornee = humanoidRootPart
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = shhhhnayy05_Config.ESPDistance
    
    -- Main Frame
    local espFrame = Instance.new("Frame")
    espFrame.Name = "ESPFrame"
    espFrame.Size = UDim2.new(1, 0, 1, 0)
    espFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    espFrame.BackgroundTransparency = 0.3
    espFrame.BorderSizePixel = 0
    espFrame.Parent = billboard
    
    local espCorner = Instance.new("UICorner")
    espCorner.CornerRadius = UDim.new(0, 8)
    espCorner.Parent = espFrame
    
    -- Border
    local espStroke = Instance.new("UIStroke")
    espStroke.Color = espColor
    espStroke.Thickness = 2
    espStroke.Parent = espFrame
    
    -- Username Label
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Username"
    nameLabel.Size = UDim2.new(1, -10, 0, 22)
    nameLabel.Position = UDim2.new(0, 5, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = "👤 " .. player.Name
    nameLabel.TextColor3 = shhhhnayy05_Config.Colors.Text
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = espFrame
    
    -- Executor Label
    local execLabel = Instance.new("TextLabel")
    execLabel.Name = "Executor"
    execLabel.Size = UDim2.new(1, -10, 0, 18)
    execLabel.Position = UDim2.new(0, 5, 0, 27)
    execLabel.BackgroundTransparency = 1
    execLabel.Text = hasExecutor and ("🚨 " .. executorName) or "✅ Clean"
    execLabel.TextColor3 = hasExecutor and espColor or shhhhnayy05_Config.Colors.Success
    execLabel.TextSize = 12
    execLabel.Font = Enum.Font.GothamSemibold
    execLabel.Parent = espFrame
    
    -- Distance Label
    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "Distance"
    distLabel.Size = UDim2.new(1, -10, 0, 15)
    distLabel.Position = UDim2.new(0, 5, 0, 45)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "📏 Calculating..."
    distLabel.TextColor3 = shhhhnayy05_Config.Colors.SubText
    distLabel.TextSize = 10
    distLabel.Font = Enum.Font.Gotham
    distLabel.Parent = espFrame
    
    billboard.Parent = character
    
    -- Store reference
    shhhhnayy05_System.ESPObjects[player] = {
        Billboard = billboard,
        Frame = espFrame,
        NameLabel = nameLabel,
        ExecLabel = execLabel,
        DistLabel = distLabel,
        Color = espColor,
        HasExecutor = hasExecutor,
        Player = player
    }
    
    return billboard
end

function shhhhnayy05_ESPSystem.UpdateESP()
    for player, espData in pairs(shhhhnayy05_System.ESPObjects) do
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            -- Update distance
            local distance = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            espData.DistLabel.Text = string.format("📏 %.1f studs", distance)
            
            -- Update color if executor status changed
            local data = shhhhnayy05_System.DetectedPlayers[player]
            if data then
                if #data.Executors > 0 and not espData.HasExecutor then
                    -- Now has executor
                    espData.HasExecutor = true
                    espData.ExecLabel.Text = "🚨 " .. data.Executors[1].Name
                    espData.ExecLabel.TextColor3 = data.Executors[1].Color or shhhhnayy05_Config.Colors.Danger
                    espData.Frame.UIStroke.Color = data.Executors[1].Color or shhhhnayy05_Config.Colors.Danger
                elseif #data.Executors == 0 and espData.HasExecutor then
                    -- No longer has executor
                    espData.HasExecutor = false
                    espData.ExecLabel.Text = "✅ Clean"
                    espData.ExecLabel.TextColor3 = shhhhnayy05_Config.Colors.Success
                    espData.Frame.UIStroke.Color = shhhhnayy05_Config.Colors.Success
                end
            end
        else
            -- Remove ESP if player character doesn't exist
            if espData.Billboard then
                espData.Billboard:Destroy()
            end
            shhhhnayy05_System.ESPObjects[player] = nil
        end
    end
end

function shhhhnayy05_ESPSystem.ClearESP()
    for player, espData in pairs(shhhhnayy05_System.ESPObjects) do
        if espData.Billboard then
            espData.Billboard:Destroy()
        end
    end
    shhhhnayy05_System.ESPObjects = {}
end

function shhhhnayy05_ESPSystem.RefreshESP()
    shhhhnayy05_ESPSystem.ClearESP()
    
    if not shhhhnayy05_Config.ESPEnabled then return end
    
    for player, data in pairs(shhhhnayy05_System.DetectedPlayers) do
        if player ~= LocalPlayer then
            shhhhnayy05_ESPSystem.CreateESP(player, data)
        end
    end
end

-- shhhhnayy05 Detection Engine
local shhhhnayy05_Detector = {}

function shhhhnayy05_Detector.DetectDeviceType(player)
    local deviceType = "Unknown"
    local platform = "Unknown"
    
    -- Check using UserInputService
    local success, result = pcall(function()
        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
            return "Mobile", "Android/iOS"
        elseif UserInputService.KeyboardEnabled then
            return "PC", "Windows/Mac"
        else
            return "Unknown", "Unknown"
        end
    end)
    
    if success then
        deviceType, platform = result[1] or result, result[2] or result
    end
    
    return deviceType, platform
end

function shhhhnayy05_Detector.DetectExecutor(player)
    local detectedExecutors = {}
    
    -- Method 1: Check global variables and functions
    for category, executors in pairs(shhhhnayy05_Config.ExecutorDatabase) do
        for execName, execData in pairs(executors) do
            local detected = false
            
            -- Check for global variables
            for _, signature in ipairs(execData.Signatures) do
                local success, exists = pcall(function()
                    return _G[signature] ~= nil or getfenv()[signature] ~= nil
                end)
                if success and exists then
                    detected = true
                    break
                end
            end
            
            -- Check for specific functions/identifiers
            if not detected then
                for _, indicator in ipairs(execData.Indicators) do
                    local success, exists = pcall(function()
                        return _G[indicator] ~= nil or 
                               getfenv()[indicator] ~= nil or
                               (typeof(getfenv) == "function" and getfenv(0)[indicator] ~= nil)
                    end)
                    if success and exists then
                        detected = true
                        break
                    end
                end
            end
            
            -- Check using identifyexecutor
            if not detected then
                local success, execIdentity = pcall(function()
                    if identifyexecutor then
                        return identifyexecutor()
                    end
                    return nil
                end)
                if success and execIdentity then
                    local identity = tostring(execIdentity):lower()
                    for _, signature in ipairs(execData.Signatures) do
                        if identity:find(signature:lower()) then
                            detected = true
                            break
                        end
                    end
                end
            end
            
            -- Check using getexecutorname
            if not detected then
                local success, execName_result = pcall(function()
                    if getexecutorname then
                        return getexecutorname()
                    end
                    return nil
                end)
                if success and execName_result then
                    local name = tostring(execName_result):lower()
                    for _, signature in ipairs(execData.Signatures) do
                        if name:find(signature:lower()) then
                            detected = true
                            break
                        end
                    end
                end
            end
            
            if detected then
                table.insert(detectedExecutors, {
                    Name = execName,
                    Category = category,
                    Platform = execData.Platform,
                    RiskLevel = execData.RiskLevel,
                    Color = execData.Color,
                    DetectionMethod = "Global Variable Check"
                })
            end
        end
    end
    
    -- Method 2: Check for common executor functions
    local executorFunctions = {
        "getrawmetatable", "setrawmetatable", "getnamecallmethod", "setnamecallmethod",
        "hookfunction", "hookmetamethod", "newcclosure", "checkcaller", "iscclosure",
        "getgc", "getrenv", "getgenv", "getreg", "getconstants", "getupvalues",
        "getprotos", "getstack", "getinfo", "setupvalue", "setconstant",
        "loadstring", "loadfile", "dofile", "require", "getscriptbytecode",
        "getscriptclosure", "getscripthash", "getscriptraw", "decompile",
        "saveinstance", "gethiddenproperty", "sethiddenproperty", "gethui",
        "getconnections", "firesignal", "firesignal", "getsignalfunctions"
    }
    
    local availableFunctions = {}
    for _, funcName in ipairs(executorFunctions) do
        local success, exists = pcall(function()
            return getfenv()[funcName] ~= nil or _G[funcName] ~= nil
        end)
        if success and exists then
            table.insert(availableFunctions, funcName)
        end
    end
    
    -- Method 3: Check for specific executor environment markers
    local envMarkers = {
        "syn", "KRNL", "Flux", "Delta", "Codex", "Arceus", "Vega", 
        "Wave", "Hydrogen", "Electron", "ScriptWare", "Oxygen"
    }
    
    for _, marker in ipairs(envMarkers) do
        local success, exists = pcall(function()
            return _G[marker] ~= nil or getfenv()[marker] ~= nil
        end)
        if success and exists then
            local matched = false
            for category, executors in pairs(shhhhnayy05_Config.ExecutorDatabase) do
                for execName, execData in pairs(executors) do
                    if marker:lower() == execName:lower() or 
                       marker:lower() == execName:gsub(" ", ""):lower() or
                       marker:lower() == execName:gsub("X", " X"):lower() then
                        table.insert(detectedExecutors, {
                            Name = execName,
                            Category = category,
                            Platform = execData.Platform,
                            RiskLevel = execData.RiskLevel,
                            Color = execData.Color,
                            DetectionMethod = "Environment Marker: " .. marker
                        })
                        matched = true
                        break
                    end
                end
                if matched then break end
            end
            
            if not matched then
                table.insert(detectedExecutors, {
                    Name = marker,
                    Category = "Unknown",
                    Platform = "Unknown",
                    RiskLevel = "Unknown",
                    Color = shhhhnayy05_Config.Colors.Warning,
                    DetectionMethod = "Environment Marker"
                })
            end
        end
    end
    
    return detectedExecutors, availableFunctions
end

function shhhhnayy05_Detector.DetectActiveScripts(player)
    local detectedScripts = {}
    
    -- Method 1: Check PlayerGui for suspicious GUIs
    local success, playerGui = pcall(function()
        return player:WaitForChild("PlayerGui", 1)
    end)
    
    if success and playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            local guiName = gui.Name:lower()
            for scriptType, patterns in pairs(shhhhnayy05_Config.ScriptPatterns) do
                for _, pattern in ipairs(patterns) do
                    if guiName:find(pattern:lower()) then
                        table.insert(detectedScripts, {
                            Type = scriptType,
                            Name = gui.Name,
                            Location = "PlayerGui",
                            Pattern = pattern
                        })
                        break
                    end
                end
            end
            
            local execGUIs = {"synapse", "krnl", "fluxus", "delta", "codex", 
                             "arceus", "vega", "wave", "hydrogen", "electron",
                             "exploit", "hack", "cheat", "admin", "cmd"}
            for _, execGui in ipairs(execGUIs) do
                if guiName:find(execGui) then
                    table.insert(detectedScripts, {
                        Type = "Executor GUI",
                        Name = gui.Name,
                        Location = "PlayerGui",
                        Pattern = execGui
                    })
                    break
                end
            end
        end
    end
    
    -- Method 2: Check Character for suspicious objects
    local success, character = pcall(function()
        return player.Character
    end)
    
    if success and character then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                local scriptName = obj.Name:lower()
                for scriptType, patterns in pairs(shhhhnayy05_Config.ScriptPatterns) do
                    for _, pattern in ipairs(patterns) do
                        if scriptName:find(pattern:lower()) then
                            table.insert(detectedScripts, {
                                Type = scriptType,
                                Name = obj.Name,
                                Location = "Character",
                                Pattern = pattern
                            })
                            break
                        end
                    end
                end
            end
            
            if obj:IsA("BodyGyro") or obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") then
                table.insert(detectedScripts, {
                    Type = "Fly/Physics Hack",
                    Name = obj.ClassName,
                    Location = "Character." .. obj.Parent.Name,
                    Pattern = obj.ClassName
                })
            end
            
            if obj:IsA("Humanoid") then
                if obj.WalkSpeed > 16 then
                    table.insert(detectedScripts, {
                        Type = "Speed Hack",
                        Name = "WalkSpeed: " .. tostring(obj.WalkSpeed),
                        Location = "Humanoid",
                        Pattern = "WalkSpeed > 16"
                    })
                end
                if obj.JumpPower > 50 then
                    table.insert(detectedScripts, {
                        Type = "Super Jump",
                        Name = "JumpPower: " .. tostring(obj.JumpPower),
                        Location = "Humanoid",
                        Pattern = "JumpPower > 50"
                    })
                end
                if obj.Health > obj.MaxHealth then
                    table.insert(detectedScripts, {
                        Type = "God Mode",
                        Name = "Health > MaxHealth",
                        Location = "Humanoid",
                        Pattern = "Health manipulation"
                    })
                end
            end
        end
    end
    
    -- Method 3: Check Backpack for suspicious tools
    local success, backpack = pcall(function()
        return player:WaitForChild("Backpack", 1)
    end)
    
    if success and backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            local toolName = tool.Name:lower()
            local suspiciousTools = {"kill", "sword", "gun", "weapon", "admin", 
                                   "ban", "kick", "crash", "lag", "exploit"}
            for _, susp in ipairs(suspiciousTools) do
                if toolName:find(susp) then
                    table.insert(detectedScripts, {
                        Type = "Suspicious Tool",
                        Name = tool.Name,
                        Location = "Backpack",
                        Pattern = susp
                    })
                    break
                end
            end
        end
    end
    
    return detectedScripts
end

function shhhhnayy05_Detector.AnalyzePlayer(player)
    local analysis = {
        Player = player,
        DeviceType = "Unknown",
        Platform = "Unknown",
        Executors = {},
        ActiveScripts = {},
        Functions = {},
        Timestamp = os.time(),
        RiskScore = 0
    }
    
    analysis.DeviceType, analysis.Platform = shhhhnayy05_Detector.DetectDeviceType(player)
    analysis.Executors, analysis.Functions = shhhhnayy05_Detector.DetectExecutor(player)
    analysis.ActiveScripts = shhhhnayy05_Detector.DetectActiveScripts(player)
    analysis.RiskScore = #analysis.Executors * 25 + #analysis.ActiveScripts * 10
    
    return analysis
end

-- shhhhnayy05 Teleport System
local shhhhnayy05_Teleport = {}

function shhhhnayy05_Teleport.ToPlayer(targetPlayer)
    if not targetPlayer then
        return false, "No player selected"
    end
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return false, "Your character not found"
    end
    
    local targetCharacter = targetPlayer.Character
    if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then
        return false, "Target player character not found"
    end
    
    local targetPosition = targetCharacter.HumanoidRootPart.Position + shhhhnayy05_System.TeleportOffset
    
    -- Teleport using CFrame
    local success, error = pcall(function()
        LocalPlayer.Character:SetPrimaryPartCFrame(CFrame.new(targetPosition))
    end)
    
    if success then
        return true, "Teleported to " .. targetPlayer.Name
    else
        -- Try alternative method
        success, error = pcall(function()
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition)
        end)
        
        if success then
            return true, "Teleported to " .. targetPlayer.Name
        else
            return false, "Teleport failed: " .. tostring(error)
        end
    end
end

function shhhhnayy05_Teleport.ToPosition(position)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return false, "Your character not found"
    end
    
    local success, error = pcall(function()
        LocalPlayer.Character:SetPrimaryPartCFrame(CFrame.new(position))
    end)
    
    if success then
        return true, "Teleported to position"
    else
        return false, "Teleport failed: " .. tostring(error)
    end
end

