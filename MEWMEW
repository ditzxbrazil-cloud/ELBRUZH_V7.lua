        status.Text = "Mode: Smooth | Shape: " .. CurrentShape
    else
        smoothBtn.BackgroundColor3 = Color3.fromRGB(65, 65, 80)
        flattenBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
        modeBtn.Text = "🟠\nFLATTEN"
        modeBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
        status.Text = "Mode: Flatten | Y-Lock: " .. (FlattenLevel and tostring(math.floor(FlattenLevel)) or "Not Set")
