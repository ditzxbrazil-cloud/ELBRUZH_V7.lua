--// TOGGLE MODE ON/OFF
function shhhhnayy05:ToggleMode()
    self.Config.ModeEnabled = not self.Config.ModeEnabled
    
    if self.Config.ModeEnabled then
        self.GUI.ModeIcon.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        self.GUI.ModeIcon.Text = "✏️"
        self.GUI.StatusLabel.Text = "✏️ Mode ON - " .. self.Config.CurrentMode .. " | " .. self.Config.Shape
        self.GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        self:CreateBrushPreview()
    else
        self.GUI.ModeIcon.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        self.GUI.ModeIcon.Text = "✋"
        self.GUI.StatusLabel.Text = "✋ Mode OFF - Click icon to enable"
        self.GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        self:DestroyBrushPreview()
    end
end

--// TOGGLE PANEL VISIBILITY
function shhhhnayy05:TogglePanel()
    self.Config.Minimized = not self.Config.Minimized
    
    if self.Config.Minimized then
        self.GUI.MainPanel.Visible = false
        self.GUI.PanelIcon.Text = "🏔️"
    else
        self.GUI.MainPanel.Visible = true
        self.GUI.PanelIcon.Text = "📂"
    end
end

