--// Fungsi Teleport LANGSUNG
local function teleportToItem(item)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local targetPosition = nil
    
    if isValidPart(item) then
        targetPosition = item.Position + Vector3.new(0, 5, 0)
    elseif item:IsA("Model") then
        local primaryPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        if primaryPart then
            targetPosition = primaryPart.Position + Vector3.new(0, 5, 0)
        end
    end
    
    if targetPosition then
        humanoidRootPart.CFrame = CFrame.new(targetPosition)
    end
end

--// FUNGSI AUTO SEARCH
local function performAutoSearch(searchText)
    if #currentItems == 0 then return false end
    if searchText == "" or searchText == nil then return false end
    
    searchText = string.lower(searchText)
    
    local searchNumber = tonumber(searchText)
    local foundIndex = nil
    
    for i, item in ipairs(currentItems) do
        local match = false
        
        if searchNumber then
            if i == searchNumber then
                match = true
            else
                local itemNum = extractNumber(item.Name)
                if itemNum == searchNumber then
                    match = true
                end
            end
        else
            if string.find(string.lower(item.Name), searchText) then
                match = true
            end
        end
        
        if match then
            foundIndex = i
            break
        end
    end
    
    if foundIndex then
        currentIndex = foundIndex
        
        CounterLabel.Text = currentIndex .. " / " .. #currentItems
        local item = currentItems[currentIndex]
        if item then
            SelectedItemLabel.Text = getIcon(item) .. " " .. formatName(item.Name)
            teleportToItem(item)
        end
        
        -- SCROLL OTOMATIS
        local itemHeight = 38
        local targetPosition = (foundIndex - 1) * itemHeight
        local maxScroll = math.max(0, TeleportContent.CanvasSize.Y.Offset - TeleportContent.AbsoluteSize.Y)
        local clampedPosition = math.clamp(targetPosition, 0, maxScroll)
        
        TeleportContent.CanvasPosition = Vector2.new(0, clampedPosition)
        
        -- Highlight
        for _, child in ipairs(TeleportContent:GetChildren()) do
            if child:IsA("Frame") then
                local btn = child:FindFirstChild("ItemButton")
                if btn then
                    if child.Name == item.Name .. "_TeleportItem" then
                        child.BackgroundColor3 = Color3.fromRGB(80, 100, 150)
                        
                        TweenService:Create(child, TweenInfo.new(0.2), {
                            BackgroundColor3 = Color3.fromRGB(100, 255, 100)
                        }):Play()
                        
                        delay(0.3, function()
                            if child and child.Parent then
                                TweenService:Create(child, TweenInfo.new(0.3), {
                                    BackgroundColor3 = Color3.fromRGB(80, 100, 150)
                                }):Play()
                            end
                        end)
                    else
                        child.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
                    end
                end
            end
        end
        
        return true
    end
    
    return false
end

