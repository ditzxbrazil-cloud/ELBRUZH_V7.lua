            end
        else
            shhhhnayy05_UI.ShowNotification("⚠️ No Selection", "Please select a player first!", shhhhnayy05_Config.Colors.Warning)
        end
    end)
    
    -- Clear button
    UI.ClearBtn.MouseButton1Click:Connect(function()
        shhhhnayy05_System.DetectedPlayers = {}
        shhhhnayy05_System.ActiveScripts = {}
        shhhhnayy05_ESPSystem.ClearESP()
        shhhhnayy05_UI.UpdatePlayerList()
        shhhhnayy05_UI.UpdateStats()
        shhhhnayy05_UI.ClearDetails()
    end)
    
    -- Make draggable
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    UI.MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = UI.MainFrame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
                        input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            UI.MainFrame.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X,
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    -- ESP Update Loop
    RunService.RenderStepped:Connect(function()
        if shhhhnayy05_Config.ESPEnabled then
            shhhhnayy05_ESPSystem.UpdateESP()
        end
    end)
    
    -- Initial scan
    shhhhnayy05_UI.ScanAllPlayers()
end

function shhhhnayy05_UI.UpdateStats()
    local UI = shhhhnayy05_UI.Elements
    local totalDetected = 0
    local mobileCount = 0
    local pcCount = 0
    local scriptCount = 0
    
    for _, data in pairs(shhhhnayy05_System.DetectedPlayers) do
        totalDetected = totalDetected + 1
        if data.DeviceType == "Mobile" then
            mobileCount = mobileCount + 1
        elseif data.DeviceType == "PC" then
            pcCount = pcCount + 1
        end
        scriptCount = scriptCount + #data.ActiveScripts
    end
    
    UI.Stats.TotalDetected.Text = "👥 Detected: " .. totalDetected
    UI.Stats.MobileCount.Text = "📱 Mobile: " .. mobileCount
    UI.Stats.PCCount.Text = "💻 PC: " .. pcCount
    UI.Stats.ScriptCount.Text = "📜 Scripts: " .. scriptCount
end

