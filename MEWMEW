--// Position Key Function
local function GetPositionKey(position)
	return math.floor(position.X / 4) .. "," .. math.floor(position.Y / 4) .. "," .. math.floor(position.Z / 4)
end

--// Check if Position Exists
local function PositionExists(position)
	local key = GetPositionKey(position)
	return shhhhnayy05.ExistingPositions[key] ~= nil
end

--// Mark Position
local function MarkPosition(position, data)
	local key = GetPositionKey(position)
	shhhhnayy05.ExistingPositions[key] = data
end

--// Unmark Position
local function UnmarkPosition(position)
	local key = GetPositionKey(position)
	shhhhnayy05.ExistingPositions[key] = nil
end

--// Save Undo State
local function SaveUndoState()
	local state = {
		TerrainHistory = {},
		ExistingPositions = {}
	}
	
	for i, data in ipairs(shhhhnayy05.TerrainHistory) do
		state.TerrainHistory[i] = {
			position = data.position,
			size = data.size,
			material = data.material,
			color = data.color,
			shape = data.shape,
			mode = data.mode
		}
	end
	
	for k, v in pairs(shhhhnayy05.ExistingPositions) do
		state.ExistingPositions[k] = v
	end
	
	table.insert(shhhhnayy05.UndoStack, state)
	
	if #shhhhnayy05.UndoStack > shhhhnayy05.MaxUndo then
		table.remove(shhhhnayy05.UndoStack, 1)
	end
	
	shhhhnayy05.RedoStack = {}
end

--// Restore State
local function RestoreState(state)
	Terrain:Clear()
	
	shhhhnayy05.TerrainHistory = {}
	shhhhnayy05.ExistingPositions = {}
	
	for _, data in ipairs(state.TerrainHistory) do
		Terrain:SetMaterialColor(data.material, data.color)
		
		if data.shape == "Block" then
			Terrain:FillBlock(CFrame.new(data.position), data.size, data.material)
		else
			Terrain:FillBall(data.position, data.size.X / 2, data.material)
		end
		
		table.insert(shhhhnayy05.TerrainHistory, data)
		MarkPosition(data.position, data)
	end
end

--// Place Terrain Function - SESUAI CONTOH USER
local function PlaceTerrain(position)
	local isNewPosition = not PositionExists(position)
	local currentColor = GetCurrentColorForMaterial(shhhhnayy05.CurrentMaterial)
	
	Terrain:SetMaterialColor(shhhhnayy05.CurrentMaterial, currentColor)
	
	local size = Vector3.new(shhhhnayy05.BrushSize, shhhhnayy05.BrushSize, shhhhnayy05.BrushSize)
	
	if shhhhnayy05.Mode == "Flatten" then
		-- SISTEM FLATTEN SESUAI CONTOH USER
		if not shhhhnayy05.FlattenLevel then
			shhhhnayy05.FlattenLevel = position.Y -- Mengambil titik awal tinggi tanah
		end
		
		local radius = shhhhnayy05.BrushSize / 2
		local flattenPos = Vector3.new(position.X, shhhhnayy05.FlattenLevel, position.Z)
		local flattenSize = Vector3.new(radius * 2, 4, radius * 2)
		
		-- Bagian inilah yang "memunculkan" terrain rata (persegi/block)
		Terrain:FillBlock(CFrame.new(flattenPos), flattenSize, shhhhnayy05.CurrentMaterial)
		
		position = flattenPos
		size = flattenSize
	else
		-- SMOOTH MODE (normal)
		if shhhhnayy05.Shape == "Block" then
			Terrain:FillBlock(CFrame.new(position), size, shhhhnayy05.CurrentMaterial)
		else
			Terrain:FillBall(position, shhhhnayy05.BrushSize / 2, shhhhnayy05.CurrentMaterial)
		end
	end
	
	if isNewPosition then
		local terrainData = {
			position = position,
			size = size,
			material = shhhhnayy05.CurrentMaterial,
			color = currentColor,
			shape = shhhhnayy05.Shape,
			mode = shhhhnayy05.Mode
		}
		
		table.insert(shhhhnayy05.TerrainHistory, terrainData)
		MarkPosition(position, terrainData)
	end
	
	return isNewPosition
end

--// Raycast Function
local function RaycastFromMouse()
	local mousePos = UserInputService:GetMouseLocation()
	local ray = Workspace.CurrentCamera:ViewportPointToRay(mousePos.X, mousePos.Y)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = {BrushPreview, LocalPlayer.Character}
	
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
	return result
end

--// Update Brush Preview
local function UpdateBrushPreview()
	if not shhhhnayy05.Enabled then
		BrushPreview.Transparency = 1
		return
	end
	
	local result = RaycastFromMouse()
	if result then
		BrushPreview.Transparency = 0.7
		local pos = result.Position + result.Normal * (shhhhnayy05.BrushSize / 2)
		
		if shhhhnayy05.Mode == "Flatten" and shhhhnayy05.FlattenLevel then
			pos = Vector3.new(pos.X, shhhhnayy05.FlattenLevel, pos.Z)
		end
		
		BrushPreview.Position = pos
		BrushPreview.Size = Vector3.new(shhhhnayy05.BrushSize, 4, shhhhnayy05.BrushSize)
		
		if shhhhnayy05.Mode == "Flatten" then
			BrushPreview.Shape = Enum.PartType.Block
		elseif shhhhnayy05.Shape == "Block" then
			BrushPreview.Shape = Enum.PartType.Block
		else
			BrushPreview.Shape = Enum.PartType.Ball
		end
		
		BrushPreview.Color = GetCurrentColorForMaterial(shhhhnayy05.CurrentMaterial)
	else
		BrushPreview.Transparency = 1
	end
end

