    mainLoader = mainLoader .. 'print("📂 Folder: ' .. folderName .. '")\n\n'
    
    for _, serv in ipairs(services) do
        mainLoader = mainLoader .. '--// Loading ' .. serv.name .. '\n'
        mainLoader = mainLoader .. 'pcall(function()\n'
        mainLoader = mainLoader .. '    loadstring(readfile("' .. folderPath .. '/' .. serv.name .. '_Loader.lua"))()\n'
