--// MAIN COPY FUNCTION
function shhhhnayy05:StartCopy(selectedOnly)
    --// Reset stats
    self.CopyStats = {
        TotalItems = 0,
        Scripts = 0,
        Parts = 0,
        Remotes = 0,
        GUIs = 0,
        Others = 0
    }
    
    --// Get services to copy
    local services = {}
    
    if selectedOnly then
        --// Get from checkboxes
        for name, checkbox in pairs(checkboxes) do
            if checkbox.data.checked and checkbox.data.obj then
                table.insert(services, {
                    name = name,
                    obj = checkbox.data.obj,
                    count = #checkbox.data.obj:GetChildren()
                })
            end
        end
    else
        --// Copy ALL services automatically
        services = self:GetAllServices()
    end
    
    if #services == 0 then
        updateStatus("❌ Tidak ada service yang dipilih!", true)
        return
    end
    
    --// Update UI
    GenerateBtn.Active = false
    GenerateBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    GenerateBtn.Text = "⏳ COPYING..."
    
    --// Create folder
    local gameName = game.Name:gsub("%W", "_"):sub(1, 25)
    local timestamp = os.date("%Y%m%d_%H%M%S")
    local folderName = "shhhhnayy05_" .. gameName .. "_" .. game.PlaceId .. "_" .. timestamp
    local folderPath = self.Config.BaseFolder .. "/" .. folderName
    
    updateStatus("📁 Membuat folder: " .. folderName)
    
    if self.Methods.makefolder then
        pcall(function()
            makefolder(folderPath)
        end)
    end
    
    wait(0.5)
    
    --// Copy each service
    local savedServices = {}
    local totalServices = #services
    
    for i, serv in ipairs(services) do
        local percent = (i - 1) / totalServices * 100
        updateProgress(percent)
        updateStatus("📦 Menyalin " .. serv.name .. "... (" .. i .. "/" .. totalServices .. ") - " .. serv.count .. " items")
        
        --// Serialize service
        local serviceData = self:SerializeInstance(serv.obj)
        
        if serviceData then
            --// Generate loader
            local loaderScript = self:GenerateServiceLoader(serviceData, serv.name)
            
            --// Save to file
            if self.Methods.writefile then
                pcall(function()
                    writefile(folderPath .. "/" .. serv.name .. "_Loader.lua", loaderScript)
                end)
            end
            
            table.insert(savedServices, {
                Name = serv.name,
                Count = #serv.obj:GetChildren()
            })
        end
        
        wait(0.2)
    end
    
    --// Generate main files
    updateProgress(95)
    updateStatus("📝 Membuat file loader...")
    
    local mainLoader = self:GenerateMainLoader(services, folderPath, folderName)
    local readme = self:GenerateReadme(folderName, services, self.CopyStats)
    
    if self.Methods.writefile then
        pcall(function()
            writefile(folderPath .. "/_LOAD_ALL.lua", mainLoader)
            writefile(folderPath .. "/README.txt", readme)
        end)
    end
    
    --// Save to registry
    local gameId = folderName
    self.SavedGames[gameId] = {
        GameName = game.Name,
        PlaceId = game.PlaceId,
        Created = os.date("%Y-%m-%d %H:%M:%S"),
        FolderPath = folderPath,
        FolderName = folderName,
        Services = savedServices,
        Stats = self.CopyStats
    }
    self:SaveRegistry()
    
    --// Update UI
    updateProgress(100)
    updateStatus("✅ BERHASIL! Items: " .. self.CopyStats.TotalItems .. " | Scripts: " .. self.CopyStats.Scripts, false, true)
    updateFileCount()
    
    GenerateBtn.Active = true
    GenerateBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    GenerateBtn.Text = "📁 COPY GAME"
    
    --// Show result
    self:ShowResult(gameId)
    
    print("✅ COPY COMPLETE!")
    print("📊 Stats:", self.CopyStats)
    print("📁 Folder:", folderPath)
end

