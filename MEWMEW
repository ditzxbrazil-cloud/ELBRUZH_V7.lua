function shhhhnayy05.GenerateFullScript()
    local lines = {
        "--// ========================================== ",
        "--// GENERATED BY shhhhnayy05 Real-Time Copier",
        "--// Game: " .. game.Name,
        "--// Place ID: " .. game.PlaceId,
        "--// Created: " .. os.date("%Y-%m-%d %H:%M:%S"),
        "--// ========================================== ",
        "",
        "local shhhhnayy05_Loader = {}",
        "",
        "--// Utility Functions",
        "function shhhhnayy05_Loader.CreateInstance(className, parent, name)",
        "    local success, inst = pcall(function()",
        "        local obj = Instance.new(className)",
        "        obj.Name = name",
        "        obj.Parent = parent",
        "        return obj",
        "    end)",
        "    if success then return inst end",
        "    return nil",
        "end",
        "",
        "function shhhhnayy05_Loader.SetProperties(inst, props)",
        "    if not inst or not props then return end",
        "    for prop, value in pairs(props) do",
        "        pcall(function()",
        "            if type(value) == 'table' then",
        "                if prop == 'Size' and #value == 3 then",
        "                    inst.Size = Vector3.new(value[1], value[2], value[3])",
        "                elseif prop == 'Position' and #value == 3 then",
        "                    inst.Position = Vector3.new(value[1], value[2], value[3])",
        "                elseif prop == 'Rotation' and #value == 3 then",
        "                    inst.Orientation = Vector3.new(value[1], value[2], value[3])",
        "                elseif prop == 'Color' and #value == 3 then",
        "                    inst.Color = Color3.new(value[1], value[2], value[3])",
        "                elseif prop == 'BackgroundColor3' and #value == 3 then",
        "                    inst.BackgroundColor3 = Color3.new(value[1], value[2], value[3])",
        "                elseif prop == 'TextColor3' and #value == 3 then",
        "                    inst.TextColor3 = Color3.new(value[1], value[2], value[3])",
        "                elseif prop == 'Size' and #value == 4 then -- UDim2",
        "                    inst.Size = UDim2.new(value[1], value[2], value[3], value[4])",
        "                elseif prop == 'Position' and #value == 4 then -- UDim2",
        "                    inst.Position = UDim2.new(value[1], value[2], value[3], value[4])",
        "                end",
        "            else",
        "                inst[prop] = value",
        "            end",
        "        end)",
        "    end",
        "end",
        "",
        "function shhhhnayy05_Loader.BuildHierarchy(data, parent)",
        "    if not data then return end",
        "    ",
        "    local inst = shhhhnayy05_Loader.CreateInstance(data.ClassName, parent, data.Name)",
        "    if not inst then return end",
        "    ",
        "    -- Set properties",
        "    if data.Properties then",
        "        shhhhnayy05_Loader.SetProperties(inst, data.Properties)",
        "    end",
        "    ",
        "    -- Build children",
        "    if data.Children then",
        "        for _, childData in ipairs(data.Children) do",
        "            shhhhnayy05_Loader.BuildHierarchy(childData, inst)",
        "        end",
        "    end",
        "    ",
        "    return inst",
        "end",
        "",
        "--// Main Load Function",
        "function shhhhnayy05_Loader.LoadGame()",
        "    print('🎮 shhhhnayy05 Loader: Starting...')",
        "",
    }
    
    -- Add service data
    for serviceName, serviceData in pairs(shhhhnayy05.CopiedData) do
        table.insert(lines, "    --// Loading " .. serviceName)
        table.insert(lines, "    print('📂 Loading " .. serviceName .. "...')")
        table.insert(lines, "    local " .. serviceName .. " = game:GetService('" .. serviceName .. "')")
        table.insert(lines, "    if " .. serviceName .. " then")
        
        if serviceData.Children then
            for _, child in ipairs(serviceData.Children) do
                table.insert(lines, "        shhhhnayy05_Loader.BuildHierarchy(" .. shhhhnayy05.TableToString(child) .. ", " .. serviceName .. ")")
            end
        end
        
        table.insert(lines, "    end")
        table.insert(lines, "")
    end
    
    -- Footer
    table.insert(lines, "    print('✅ shhhhnayy05 Loader: Complete!')")
    table.insert(lines, "    print('🎮 All services loaded successfully!')")
    table.insert(lines, "end")
    table.insert(lines, "")
    table.insert(lines, "--// Execute")
    table.insert(lines, "shhhhnayy05_Loader.LoadGame()")
    
    return table.concat(lines, "\n")
end

