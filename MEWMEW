--// Initialize
function shhhhnayy05:Init()
    print("🔧 shhhhnayy05: Initializing COMPLETE Game Copier...")
    
    --// Create base folder
    if self.Methods.makefolder then
        pcall(function()
            if not isfolder(self.Config.BaseFolder) then
                makefolder(self.Config.BaseFolder)
                print("✅ Created: " .. self.Config.BaseFolder)
            end
        end)
    end
    
    --// Load saved games
    self:LoadSavedGames()
    
    print("✅ Ready! Use GUI to copy game.")
end

--// Load Saved Games
function shhhhnayy05:LoadSavedGames()
    if not (self.Methods.isfile and self.Methods.readfile) then return end
    
    pcall(function()
        local indexPath = self.Config.BaseFolder .. "/" .. self.Config.IndexFile
        if isfile(indexPath) then
            local content = readfile(indexPath)
            self.SavedGames = HttpService:JSONDecode(content)
            print("📂 Loaded " .. self:GetSavedCount() .. " saved games")
        end
    end)
    
    --// Global backup
    if self.Methods.getgenv then
        local genv = getgenv()
        if genv.shhhhnayy05_SavedGames then
            for id, game in pairs(genv.shhhhnayy05_SavedGames) do
                if not self.SavedGames[id] then
                    self.SavedGames[id] = game
                end
            end
        end
        genv.shhhhnayy05_SavedGames = self.SavedGames
    end
end

--// Save Registry
function shhhhnayy05:SaveRegistry()
    if self.Methods.writefile then
        pcall(function()
            local indexPath = self.Config.BaseFolder .. "/" .. self.Config.IndexFile
            writefile(indexPath, HttpService:JSONEncode(self.SavedGames))
        end)
    end
    
    if self.Methods.getgenv then
        getgenv().shhhhnayy05_SavedGames = self.SavedGames
    end
end

--// Get Saved Count
function shhhhnayy05:GetSavedCount()
    local count = 0
    for _ in pairs(self.SavedGames) do count = count + 1 end
    return count
end

--// Delete Game
function shhhhnayy05:DeleteGame(gameId)
    local game = self.SavedGames[gameId]
    if not game then return false end
    
    --// Try delete files
    if self.Methods.delfile and game.FolderPath then
        pcall(function()
            for _, service in ipairs(game.Services or {}) do
                local filePath = game.FolderPath .. "/" .. service.Name .. "_Loader.lua"
                if isfile(filePath) then
                    delfile(filePath)
                end
            end
            local mainFile = game.FolderPath .. "/_LOAD_ALL.lua"
            local readmeFile = game.FolderPath .. "/README.txt"
            if isfile(mainFile) then delfile(mainFile) end
            if isfile(readmeFile) then delfile(readmeFile) end
        end)
    end
    
    self.SavedGames[gameId] = nil
    self:SaveRegistry()
    return true
end

--// GET ALL SERVICES IN GAME
function shhhhnayy05:GetAllServices()
    local services = {}
    
    --// Core Services (always try to copy)
    local coreServices = {
        {Name = "ReplicatedStorage", Object = ReplicatedStorage, Critical = true},
        {Name = "ServerScriptService", Object = ServerScriptService, Critical = true},
        {Name = "StarterPlayerScripts", Object = StarterPlayer:FindFirstChild("StarterPlayerScripts"), Critical = true},
        {Name = "StarterCharacterScripts", Object = StarterPlayer:FindFirstChild("StarterCharacterScripts"), Critical = false},
        {Name = "StarterGui", Object = StarterGui, Critical = false},
        {Name = "StarterPack", Object = StarterPack, Critical = false},
        {Name = "Lighting", Object = Lighting, Critical = false},
        {Name = "Workspace", Object = Workspace, Critical = false},
        {Name = "Teams", Object = Teams, Critical = false},
        {Name = "SoundService", Object = SoundService, Critical = false},
        {Name = "Chat", Object = Chat, Critical = false},
        {Name = "LocalizationService", Object = LocalizationService, Critical = false},
        {Name = "StarterPlayer", Object = StarterPlayer, Critical = false}
    }
    
    for _, serv in ipairs(coreServices) do
        if serv.Object and typeof(serv.Object) == "Instance" then
            --// Check if has children
            local childCount = #serv.Object:GetChildren()
            table.insert(services, {
                name = serv.Name,
                obj = serv.Object,
                count = childCount,
                critical = serv.Critical
            })
        end
    end
    
    return services
end

--// SERIALIZE INSTANCE (COMPLETE VERSION)
