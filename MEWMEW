--// Convert to Script Function
local function ConvertToScript()
	if #shhhhnayy05.TerrainHistory == 0 then
		StatusLabel.Text = "⚠️ No terrain to convert!"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		return
	end
	
	local scriptText = "--// shhhhnayy05 Terrain Generator Script\n"
	scriptText = scriptText .. "--// Auto-generated from Terrain Editor\n"
	scriptText = scriptText .. "--// Total Terrain Count: " .. #shhhhnayy05.TerrainHistory .. "\n\n"
	scriptText = scriptText .. "local Terrain = workspace.Terrain\n\n"
	
	-- Group by material and color for optimization
	local groupedData = {}
	
	for _, data in ipairs(shhhhnayy05.TerrainHistory) do
		local materialName = data.material.Name
		local colorKey = tostring(data.color)
		local groupKey = materialName .. "_" .. colorKey
		
		if not groupedData[groupKey] then
			groupedData[groupKey] = {
				material = data.material,
				color = data.color,
				items = {}
			}
		end
		
		table.insert(groupedData[groupKey].items, data)
	end
	
	-- Generate script for each group
	for groupKey, group in pairs(groupedData) do
		scriptText = scriptText .. "--// Material: " .. group.material.Name .. " | Color: " .. tostring(group.color) .. "\n"
		scriptText = scriptText .. "Terrain:SetMaterialColor(Enum.Material." .. group.material.Name .. ", Color3.fromRGB(" .. 
			math.floor(group.color.R * 255) .. ", " .. 
			math.floor(group.color.G * 255) .. ", " .. 
			math.floor(group.color.B * 255) .. "))\n\n"
		
		for _, data in ipairs(group.items) do
			local pos = data.position
			local size = data.size
			
			if data.shape == "Block" then
				if data.mode == "Flatten" then
					scriptText = scriptText .. "Terrain:FillBlock(CFrame.new(" .. pos.X .. ", " .. pos.Y .. ", " .. pos.Z .. "), " ..
						"Vector3.new(" .. size.X .. ", " .. size.Y .. ", " .. size.Z .. "), " ..
						"Enum.Material." .. data.material.Name .. ") -- Flatten\n"
				else
					scriptText = scriptText .. "Terrain:FillBlock(CFrame.new(" .. pos.X .. ", " .. pos.Y .. ", " .. pos.Z .. "), " ..
						"Vector3.new(" .. size.X .. ", " .. size.Y .. ", " .. size.Z .. "), " ..
						"Enum.Material." .. data.material.Name .. ")\n"
				end
			else
				scriptText = scriptText .. "Terrain:FillBall(Vector3.new(" .. pos.X .. ", " .. pos.Y .. ", " .. pos.Z .. "), " ..
					(size.X / 2) .. ", Enum.Material." .. data.material.Name .. ")\n"
			end
		end
		
		scriptText = scriptText .. "\n"
	end
	
	scriptText = scriptText .. "--// End of shhhhnayy05 Terrain Script\n"
	scriptText = scriptText .. "--// Total operations: " .. #shhhhnayy05.TerrainHistory
	
	ScriptBox.Text = scriptText
	ScriptWindow.Visible = true
	shhhhnayy05.ScriptWindowOpen = true
	
	StatusLabel.Text = "✓ Script generated! (" .. #shhhhnayy05.TerrainHistory .. " terrains)"
	StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
end

