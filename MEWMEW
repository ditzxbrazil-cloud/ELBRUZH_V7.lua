--// INPUT HANDLING

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not shhhhnayy05.Enabled then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDrawing = true
		
		SaveUndoState()
		
		local result = RaycastFromMouse()
		if result then
			local placePos = result.Position + result.Normal * (shhhhnayy05.BrushSize / 2)
			
			-- Jika mode flatten dan FlattenLevel belum ada, set dari posisi pertama
			if shhhhnayy05.Mode == "Flatten" and not shhhhnayy05.FlattenLevel then
				shhhhnayy05.FlattenLevel = placePos.Y
				FlattenStatusLabel.Text = "Height locked: Y=" .. math.floor(shhhhnayy05.FlattenLevel)
			end
			
			PlaceTerrain(placePos)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDrawing = false
	end
end)

RunService.RenderStepped:Connect(function()
	UpdateBrushPreview()
	
	if isDrawing and shhhhnayy05.Enabled then
		local result = RaycastFromMouse()
		if result then
			local placePos = result.Position + result.Normal * (shhhhnayy05.BrushSize / 2)
			PlaceTerrain(placePos)
		end
	end
end)

