--// UPDATE BRUSH PREVIEW
function shhhhnayy05:UpdateBrushPreview()
    if self.BrushPreview then
        local size = self.Config.BrushSize * 2
        self.BrushPreview.Size = Vector3.new(size, size, size)
        
        if self.Config.Shape == "Block" then
            self.BrushPreview.Shape = Enum.PartType.Block
        else
            self.BrushPreview.Shape = Enum.PartType.Ball
        end
