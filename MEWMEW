    catTitle.Parent = catFrame
    
    local innerScroll = Instance.new("ScrollingFrame")
    innerScroll.Size = UDim2.new(1, -5, 1, -30)
    innerScroll.Position = UDim2.new(0, 2, 0, 28)
    innerScroll.BackgroundTransparency = 1
    innerScroll.ScrollBarThickness = 4
    innerScroll.Parent = catFrame
    
    local innerLayout = Instance.new("UIListLayout")
    innerLayout.Parent = innerScroll
    
    for i, cData in ipairs(colorsTable) do
        local btn = Instance.new("TextButton")
        btn.Text = cData.name
        btn.Size = UDim2.new(1, 0, 0, 25)
        btn.BackgroundColor3 = cData.color
        btn.Font = Enum.Font.Gotham
        btn.TextColor3 = Color3.white
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.black
        stroke.Thickness = 1
        stroke.Transparency = 0.5
        stroke.Parent = btn
        
        btn.Parent = innerScroll
        btn.MouseButton1Click:Connect(function()
            updateFunc(i, cData.color)
        end)
    end
    
    innerScroll.CanvasSize = UDim2.new(0, 0, innerLayout.AbsoluteContentSize.Y, 0)
    catFrame.Size = UDim2.new(1, -10, 0, innerLayout.AbsoluteContentSize.Y + 35)
end

