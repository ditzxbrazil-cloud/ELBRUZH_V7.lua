--// Refresh Colors
function shhhhnayy05:RefreshColors(parent)
    for _,btn in pairs(parent:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Name:find("_") then
            local parts = {}
            for part in btn.Name:gmatch("[^_]+") do table.insert(parts,part) end
            if #parts == 2 then
                local matType,idx = parts[1],tonumber(parts[2])
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if idx == shhhhnayy05.CurrentColors[matType] then
                    if not stroke then
                        stroke = Instance.new("UIStroke", btn)
                        stroke.Color = Color3.fromRGB(255,255,255)
                        stroke.Thickness = 3
                    end
                else
                    if stroke then stroke:Destroy() end
                end
            end
        end
    end
end

