--// UTILITY FUNCTIONS
function shhhhnayy05:Tween(obj, props, duration, easing)
    duration = duration or 0.3
    easing = easing or Enum.EasingStyle.Quad
    local tween = TweenService:Create(obj, TweenInfo.new(duration, easing), props)
    tween:Play()
    return tween
end

function shhhhnayy05:CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius or UDim.new(0, 8)
    corner.Parent = parent
    return corner
end

function shhhhnayy05:CreateStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(100, 100, 100)
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

function shhhhnayy05:CreateShadow(parent)
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://1316045217"
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.6
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(10, 10, 118, 118)
    shadow.Size = UDim2.new(1, 20, 1, 20)
    shadow.Position = UDim2.new(0, -10, 0, -10)
    shadow.ZIndex = parent.ZIndex - 1
    shadow.Parent = parent
    return shadow
end

--// GET CURRENT COLOR BASED ON MATERIAL
function shhhhnayy05:GetCurrentColorForMaterial(material)
    if material == Enum.Material.Grass then
        return self.GrassColors[self.CurrentGrassColorIndex].color
    elseif material == Enum.Material.Ground then
        return self.GroundColors[self.CurrentGroundColorIndex].color
    elseif material == Enum.Material.LeafyGrass then
        return self.LeafyGrassColors[self.CurrentLeafyGrassColorIndex].color
    elseif material == Enum.Material.Rock then
        return self.RockColors[self.CurrentRockColorIndex].color
    else
        return nil
    end
end

