--// REAL-TIME COPY FUNCTION
function shhhhnayy05.StartRealTimeCopy()
    if shhhhnayy05.IsCopying then return end
    shhhhnayy05.IsCopying = true
    
    -- Reset data
    shhhhnayy05.CopiedData = {}
    
    -- Show progress section
    shhhhnayy05.GUI.ProgressSection.Visible = true
    shhhhnayy05.GUI.StartCopyBtn.Text = "⏳ COPYING..."
    shhhhnayy05.GUI.StartCopyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    
    spawn(function()
        shhhhnayy05.UpdateProgress(0, "🔍 Scanning current game...", 0, 0, 0)
        wait(0.5)
        
        -- Get selected services
        local selectedServices = {}
        for serviceName, getChecked in pairs(shhhhnayy05.ServiceCheckboxes) do
            if getChecked() then
                table.insert(selectedServices, serviceName)
            end
        end
        
        if #selectedServices == 0 then
            shhhhnayy05.UpdateProgress(0, "❌ No services selected!", 0, 0, 0)
            shhhhnayy05.IsCopying = false
            shhhhnayy05.GUI.StartCopyBtn.Text = "🚀 START COPY"
            shhhhnayy05.GUI.StartCopyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            return
        end
        
        shhhhnayy05.UpdateProgress(5, "📦 Found " .. #selectedServices .. " services to copy", 0, 0, 0)
        wait(0.3)
        
        local totalServices = #selectedServices
        local currentService = 0
        local totalItems = 0
        local totalScripts = 0
        
        for _, serviceName in ipairs(selectedServices) do
            currentService = currentService + 1
            local baseProgress = (currentService - 1) / totalServices * 90
            
            shhhhnayy05.UpdateProgress(baseProgress + 5, "📂 Reading " .. serviceName .. "...", currentService, totalItems, totalScripts)
            
            local service = game:FindFirstChild(serviceName) or game:GetService(serviceName)
            
            if service then
                shhhhnayy05.UpdateProgress(baseProgress + 10, "🔍 Scanning children of " .. serviceName .. "...", currentService, totalItems, totalScripts)
                
                local success, data = pcall(function()
                    return shhhhnayy05.DeepScanService(service, function(progress, items, scripts)
                        totalItems = items
                        totalScripts = scripts
                        local subProgress = progress * (80 / totalServices)
                        shhhhnayy05.UpdateProgress(baseProgress + 10 + subProgress, 
                            "📋 Copying from " .. serviceName .. "... (" .. items .. " items, " .. scripts .. " scripts)", 
                            currentService, totalItems, totalScripts)
                    end)
                end)
                
                if success and data then
                    shhhhnayy05.CopiedData[serviceName] = data
                    totalItems = totalItems + shhhhnayy05.CountItemsInData(data)
                    totalScripts = totalScripts + shhhhnayy05.CountScriptsInData(data)
                    shhhhnayy05.UpdateProgress(baseProgress + 90, "✅ " .. serviceName .. " copied!", currentService, totalItems, totalScripts)
                else
                    shhhhnayy05.UpdateProgress(baseProgress + 90, "⚠️ " .. serviceName .. " failed: " .. tostring(data), currentService, totalItems, totalScripts)
                end
            else
                shhhhnayy05.UpdateProgress(baseProgress + 90, "⚠️ " .. serviceName .. " not found", currentService, totalItems, totalScripts)
            end
            
            wait(0.2)
        end
        
        shhhhnayy05.UpdateProgress(95, "🔄 Finalizing data structure...", totalServices, totalItems, totalScripts)
        wait(0.5)
        
        shhhhnayy05.UpdateProgress(100, "🎉 COPY COMPLETE! Total: " .. totalItems .. " items, " .. totalScripts .. " scripts", totalServices, totalItems, totalScripts)
        
        shhhhnayy05.IsCopying = false
        shhhhnayy05.GUI.StartCopyBtn.Text = "✅ COPIED!"
        shhhhnayy05.GUI.StartCopyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        
        wait(2)
        shhhhnayy05.GUI.StartCopyBtn.Text = "🚀 START COPY"
        shhhhnayy05.GUI.StartCopyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        
        -- Auto suggest save
        shhhhnayy05.ShowNotification("Copy Complete!", "Click 'SAVE FILE' to store permanently")
    end)
end

function shhhhnayy05.DeepScanService(service, progressCallback)
    local data = {
        Name = service.Name,
        ClassName = service.ClassName,
        Children = {}
    }
    
    local totalChildren = #service:GetChildren()
    local processed = 0
    local items = 0
    local scripts = 0
    
    local function scanInstance(inst, parentTable)
        processed = processed + 1
        items = items + 1
        
        if inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript") then
            scripts = scripts + 1
        end
        
        -- Update progress every 10 items
        if processed % 10 == 0 and progressCallback then
            progressCallback(processed / totalChildren * 100, items, scripts)
        end
        
        local itemData = {
            Name = inst.Name,
            ClassName = inst.ClassName,
            Properties = {},
            Children = {}
        }
        
        -- Safe property reading
        pcall(function()
            -- Common properties
            if inst:IsA("BasePart") then
                itemData.Properties.Size = {inst.Size.X, inst.Size.Y, inst.Size.Z}
                itemData.Properties.Position = {inst.Position.X, inst.Position.Y, inst.Position.Z}
                itemData.Properties.Rotation = {inst.Orientation.X, inst.Orientation.Y, inst.Orientation.Z}
                itemData.Properties.Color = {inst.Color.R, inst.Color.G, inst.Color.B}
                itemData.Properties.Material = tostring(inst.Material)
                itemData.Properties.Transparency = inst.Transparency
                itemData.Properties.Anchored = inst.Anchored
                itemData.Properties.CanCollide = inst.CanCollide
            end
            
            -- Script source (if possible)
            if (inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")) and inst.Source then
                itemData.Properties.Source = inst.Source:sub(1, 5000) -- Limit source size
            end
            
            -- Value objects
            if inst:IsA("ValueBase") then
                itemData.Properties.Value = tostring(inst.Value)
            end
            
            -- GUI properties
            if inst:IsA("GuiObject") then
                itemData.Properties.Size = {inst.Size.X.Scale, inst.Size.X.Offset, inst.Size.Y.Scale, inst.Size.Y.Offset}
                itemData.Properties.Position = {inst.Position.X.Scale, inst.Position.X.Offset, inst.Position.Y.Scale, inst.Position.Y.Offset}
                itemData.Properties.BackgroundColor3 = {inst.BackgroundColor3.R, inst.BackgroundColor3.G, inst.BackgroundColor3.B}
                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                    itemData.Properties.Text = inst.Text
                    itemData.Properties.TextColor3 = {inst.TextColor3.R, inst.TextColor3.G, inst.TextColor3.B}
                    itemData.Properties.TextSize = inst.TextSize
                end
            end
            
            -- RemoteEvents/Functions
            if inst:IsA("RemoteEvent") then
                -- No special properties needed
            end
            if inst:IsA("RemoteFunction") then
                -- No special properties needed
            end
            
            -- Folders and Models
            if inst:IsA("Folder") or inst:IsA("Model") then
                -- Container only
            end
        end)
        
        -- Scan children recursively
        for _, child in ipairs(inst:GetChildren()) do
            if not child:IsA("Terrain") and not child:IsA("Camera") then
                table.insert(itemData.Children, scanInstance(child, {}))
            end
        end
        
        return itemData
    end
    
    for _, child in ipairs(service:GetChildren()) do
        table.insert(data.Children, scanInstance(child, {}))
    end
    
    return data
end

function shhhhnayy05.CountItemsInData(data)
    local count = 1 -- Count self
    for _, child in ipairs(data.Children or {}) do
        count = count + shhhhnayy05.CountItemsInData(child)
    end
    return count
end

function shhhhnayy05.CountScriptsInData(data)
    local count = 0
    if data.ClassName == "Script" or data.ClassName == "LocalScript" or data.ClassName == "ModuleScript" then
        count = 1
    end
    for _, child in ipairs(data.Children or {}) do
        count = count + shhhhnayy05.CountScriptsInData(child)
    end
    return count
end

--// FILE MANAGEMENT
function shhhhnayy05.SaveToPermanentFile()
    if not shhhhnayy05.CopiedData or not next(shhhhnayy05.CopiedData) then
        shhhhnayy05.AddLog("❌ No data to save! Copy a game first.")
        return
    end
    
    local fileName = game.Name:gsub("[^%w]", "_"):sub(1, 20) .. "_" .. os.date("%H%M%S")
    
    local fileData = {
        Name = fileName,
        DisplayName = game.Name,
        GameId = game.PlaceId,
        Created = os.date("%Y-%m-%d %H:%M:%S"),
        Data = shhhhnayy05.CopiedData,
        Stats = {
            Services = 0,
            Items = 0,
            Scripts = 0
        },
        Version = "2.0"
    }
    
    -- Calculate stats
    for serviceName, serviceData in pairs(shhhhnayy05.CopiedData) do
        fileData.Stats.Services = fileData.Stats.Services + 1
        fileData.Stats.Items = fileData.Stats.Items + shhhhnayy05.CountItemsInData(serviceData)
        fileData.Stats.Scripts = fileData.Stats.Scripts + shhhhnayy05.CountScriptsInData(serviceData)
    end
    
    -- Save to _G (persistent storage)
    if not _G.shhhhnayy05_SavedFiles then
        _G.shhhhnayy05_SavedFiles = {}
    end
    
    _G.shhhhnayy05_SavedFiles[fileName] = fileData
    shhhhnayy05.SavedFiles[fileName] = fileData
    
    shhhhnayy05.AddLog("💾 Saved: " .. fileName)
    shhhhnayy05.AddLog("   Items: " .. fileData.Stats.Items .. " | Scripts: " .. fileData.Stats.Scripts)
    shhhhnayy05.ShowNotification("File Saved!", fileName .. " stored permanently")
end

function shhhhnayy05.LoadSavedFiles()
    if _G.shhhhnayy05_SavedFiles then
        shhhhnayy05.SavedFiles = _G.shhhhnayy05_SavedFiles
    end
end

