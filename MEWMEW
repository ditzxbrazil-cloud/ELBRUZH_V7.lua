function shhhhnayy05_UI.ShowNotification(title, message, color)
    local UI = shhhhnayy05_UI.Elements
    
    UI.Notification.Title.Text = title
    UI.Notification.Title.TextColor3 = color or shhhhnayy05_Config.Colors.Danger
    UI.Notification.Text.Text = message
    
    UI.Notification.Frame.Visible = true
    UI.Notification.Frame.Position = UDim2.new(0.5, -150, 0, -100)
    
    TweenService:Create(UI.Notification.Frame, TweenInfo.new(0.5, Enum.EasingStyle.Quart), 
        {Position = UDim2.new(0.5, -150, 0, 20)}):Play()
    
    task.delay(shhhhnayy05_Config.NotificationDuration, function()
        TweenService:Create(UI.Notification.Frame, TweenInfo.new(0.5, Enum.EasingStyle.Quart), 
            {Position = UDim2.new(0.5, -150, 0, -100)}):Play()
        task.wait(0.5)
        UI.Notification.Frame.Visible = false
    end)
end

function shhhhnayy05_UI.ScanAllPlayers()
    local UI = shhhhnayy05_UI.Elements
    
    shhhhnayy05_System.DetectedPlayers = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local analysis = shhhhnayy05_Detector.AnalyzePlayer(player)
            shhhhnayy05_System.DetectedPlayers[player] = analysis
            
            if #analysis.Executors > 0 then
                local execNames = {}
                for _, exec in ipairs(analysis.Executors) do
                    table.insert(execNames, exec.Name)
                end
                shhhhnayy05_UI.ShowNotification(
                    "🚨 Executor Detected!", 
                    player.Name .. " using: " .. table.concat(execNames, ", "),
                    shhhhnayy05_Config.Colors.Danger
                )
            end
        end
    end
    
    shhhhnayy05_UI.UpdatePlayerList()
    shhhhnayy05_UI.UpdateStats()
    
    -- Refresh ESP if enabled
    if shhhhnayy05_Config.ESPEnabled then
        shhhhnayy05_ESPSystem.RefreshESP()
    end
    
    shhhhnayy05_UI.ShowNotification("✅ Scan Complete", "Scanned " .. tostring(#Players:GetPlayers() - 1) .. " players", shhhhnayy05_Config.Colors.Success)
end

function shhhhnayy05_UI.StartMonitoring()
    task.spawn(function()
        while shhhhnayy05_System.Monitoring do
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local analysis = shhhhnayy05_Detector.AnalyzePlayer(player)
                    local oldData = shhhhnayy05_System.DetectedPlayers[player]
                    
                    -- Check for new executors
                    if oldData and #analysis.Executors > #oldData.Executors then
                        local newExecutors = {}
                        for i = #oldData.Executors + 1, #analysis.Executors do
                            table.insert(newExecutors, analysis.Executors[i].Name)
                        end
                        shhhhnayy05_UI.ShowNotification(
                            "🚨 New Executor Detected!",
                            player.Name .. " started using: " .. table.concat(newExecutors, ", "),
                            shhhhnayy05_Config.Colors.Danger
                        )
                    end
                    
                    shhhhnayy05_System.DetectedPlayers[player] = analysis
                end
            end
            
            shhhhnayy05_UI.UpdatePlayerList()
            shhhhnayy05_UI.UpdateStats()
            
            task.wait(shhhhnayy05_Config.UpdateInterval)
        end
    end)
end

