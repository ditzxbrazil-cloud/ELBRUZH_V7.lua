        task.wait(2) -- Wait for player to load
        local analysis = shhhhnayy05_Detector.AnalyzePlayer(player)
        shhhhnayy05_System.DetectedPlayers[player] = analysis
        
        if #analysis.Executors > 0 then
            local execNames = {}
            for _, exec in ipairs(analysis.Executors) do
                table.insert(execNames, exec.Name)
            end
            shhhhnayy05_UI.ShowNotification(
                "🚨 New Player with Executor!",
                player.Name .. " joined using: " .. table.concat(execNames, ", "),
                shhhhnayy05_Config.Colors.Danger
            )
        else
            shhhhnayy05_UI.ShowNotification("👤 Player Joined", player.Name .. " joined the game", shhhhnayy05_Config.Colors.Accent)
        end
        
        shhhhnayy05_UI.UpdatePlayerList()
        shhhhnayy05_UI.UpdateStats()
        
        if shhhhnayy05_Config.ESPEnabled then
            shhhhnayy05_ESPSystem.CreateESP(player, analysis)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    shhhhnayy05_System.DetectedPlayers[player] = nil
    
    if shhhhnayy05_System.ESPObjects[player] then
        if shhhhnayy05_System.ESPObjects[player].Billboard then
            shhhhnayy05_System.ESPObjects[player].Billboard:Destroy()
        end
        shhhhnayy05_System.ESPObjects[player] = nil
    end
    
    if shhhhnayy05_System.SelectedPlayer == player then
        shhhhnayy05_System.SelectedPlayer = nil
        shhhhnayy05_UI.ClearDetails()
    end
    
    shhhhnayy05_UI.UpdatePlayerList()
    shhhhnayy05_UI.UpdateStats()
end)

