function shhhhnayy05_UI.ShowPlayerDetails(player, data)
    local UI = shhhhnayy05_UI.Elements
    
    for _, child in ipairs(UI.DetailsScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Basic Info
    shhhhnayy05_UI.CreateDetailItem("👤 Player Name", player.Name, shhhhnayy05_Config.Colors.Accent)
    shhhhnayy05_UI.CreateDetailItem("📱 Device Type", data.DeviceType, 
        data.DeviceType == "Mobile" and shhhhnayy05_Config.Colors.Warning or shhhhnayy05_Config.Colors.Accent)
    shhhhnayy05_UI.CreateDetailItem("🖥️ Platform", data.Platform, shhhhnayy05_Config.Colors.Text)
    shhhhnayy05_UI.CreateDetailItem("⚠️ Risk Score", tostring(data.RiskScore) .. "/100", 
        data.RiskScore >= 50 and shhhhnayy05_Config.Colors.Danger or 
        (data.RiskScore >= 25 and shhhhnayy05_Config.Colors.Warning or shhhhnayy05_Config.Colors.Success))
    
    -- Executors
    if #data.Executors > 0 then
        local execNames = {}
        for _, exec in ipairs(data.Executors) do
            table.insert(execNames, exec.Name .. " (" .. exec.Platform .. ")")
        end
        shhhhnayy05_UI.CreateDetailItem("🚨 Detected Executors", table.concat(execNames, "\n"), shhhhnayy05_Config.Colors.Danger)
    else
        shhhhnayy05_UI.CreateDetailItem("✅ Executors", "None detected", shhhhnayy05_Config.Colors.Success)
    end
    
    -- Active Scripts
    if #data.ActiveScripts > 0 then
        local scriptNames = {}
        for _, script in ipairs(data.ActiveScripts) do
            table.insert(scriptNames, script.Type .. ": " .. script.Name)
        end
        shhhhnayy05_UI.CreateDetailItem("📜 Active Scripts", table.concat(scriptNames, "\n"), shhhhnayy05_Config.Colors.Warning)
    else
        shhhhnayy05_UI.CreateDetailItem("✅ Scripts", "None detected", shhhhnayy05_Config.Colors.Success)
    end
    
    -- Available Functions
    if #data.Functions > 0 then
        local funcPreview = table.concat(data.Functions, ", ")
        if #funcPreview > 50 then
            funcPreview = funcPreview:sub(1, 50) .. "..."
        end
        shhhhnayy05_UI.CreateDetailItem("⚙️ Suspicious Functions", funcPreview, shhhhnayy05_Config.Colors.Warning)
    end
    
    local contentHeight = #UI.DetailsScroll:GetChildren() * 55
    UI.DetailsScroll.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
end

