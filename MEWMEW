    mainLoader = mainLoader .. '--// Game: ' .. game.Name .. '\n'
    mainLoader = mainLoader .. '--// Folder: ' .. folderName .. '\n'
    mainLoader = mainLoader .. '--// Generated: ' .. os.date("%Y-%m-%d %H:%M:%S") .. '\n'
    mainLoader = mainLoader .. '--// Total Services: ' .. #services .. '\n\n'
    
