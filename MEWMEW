--// Raycast
local function GetRaycast()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    if PreviewPart then params.FilterDescendantsInstances = {PreviewPart} end
    return Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
end

--// Create Preview
local function CreatePreview()
    if PreviewPart then PreviewPart:Destroy() end
    PreviewPart = Instance.new("Part")
    PreviewPart.Shape = CurrentShape == "Ball" and Enum.PartType.Ball or Enum.PartType.Block
    PreviewPart.Material = Enum.Material.ForceField
    PreviewPart.Color = Color3.fromRGB(255, 255, 255)
    PreviewPart.Transparency = 0.7
    PreviewPart.CanCollide = false
    PreviewPart.Anchored = true
    PreviewPart.CastShadow = false
    PreviewPart.Parent = Workspace
end

--// Update Preview
local function UpdatePreview()
    if not PreviewPart then CreatePreview() end
    local result = GetRaycast()
    if result then
        PreviewPos = result.Position
        if CurrentShape == "Ball" then
            PreviewPart.Shape = Enum.PartType.Ball
            PreviewPart.Size = Vector3.new(SizeX, SizeY, SizeZ)
        else
            PreviewPart.Shape = Enum.PartType.Block
            PreviewPart.Size = Vector3.new(SizeX, SizeY, SizeZ)
        end
        
        -- Show flatten level if in flatten mode
        if CurrentMode == "Flatten" and FlattenLevel then
            PreviewPart.Position = Vector3.new(PreviewPos.X, FlattenLevel, PreviewPos.Z)
            PreviewPart.Color = Color3.fromRGB(255, 200, 100) -- Orange tint for flatten mode
        else
            PreviewPart.Position = PreviewPos
            PreviewPart.Color = Color3.fromRGB(255, 255, 255)
        end
        PreviewPart.Transparency = 0.65
    else
        PreviewPart.Transparency = 1
    end
end

--// Apply Material Colors
local function ApplyMaterialColors()
    pcall(function()
        Terrain:SetMaterialColor(Enum.Material.Grass, grassColors[currentGrassColorIndex].color)
    end)
    pcall(function()
        Terrain:SetMaterialColor(Enum.Material.Ground, groundColors[currentGroundColorIndex].color)
    end)
end

--// BL Function
local function BL(d)
    local pos = Vector3.new(d[1], d[2], d[3])
    local sx, sy, sz = d[4], d[5], d[6]
    local matName = d[7]
    local shape = d[8] or "Ball"
    local mode = d[9] or "Smooth"
    local flattenY = d[10]
    
    local mat = Enum.Material.Grass
    for _, m in ipairs(Materials) do
        if m.Name == matName then mat = m.Mat break end
    end
    
    ApplyMaterialColors()
    
    if mode == "Flatten" and flattenY then
        -- Flatten mode: FillBlock at locked Y level
        local sizeVec = Vector3.new(sx, 4, sz)
        Terrain:FillBlock(CFrame.new(pos.X, flattenY, pos.Z), sizeVec, mat)
    elseif shape == "Block" then
        local sizeVec = Vector3.new(sx, sy, sz)
        Terrain:FillBlock(CFrame.new(pos), sizeVec, mat)
    else
        Terrain:FillBall(pos, math.max(sx, sy, sz)/2, mat)
    end
    
    return d
end

--// Spawn Terrain
local function SpawnTerrain()
    if not PreviewPos then return false end
    
    local data
    if CurrentMode == "Flatten" then
        -- Initialize FlattenLevel if not set
        if not FlattenLevel then
            FlattenLevel = PreviewPos.Y
        end
        
        data = {
            math.floor(PreviewPos.X),
            math.floor(FlattenLevel),
            math.floor(PreviewPos.Z),
            SizeX, 4, SizeZ, -- Y is fixed to 4 for flatten
            CurrentMaterial.Name,
            "Block", -- Flatten always uses Block
            "Flatten",
            FlattenLevel
        }
    else
        -- Smooth mode (normal)
        data = {
            math.floor(PreviewPos.X),
            math.floor(PreviewPos.Y),
            math.floor(PreviewPos.Z),
            SizeX, SizeY, SizeZ,
            CurrentMaterial.Name,
            CurrentShape,
            "Smooth"
        }
    end
    
    BL(data)
    table.insert(UndoHistory, data)
    RedoHistory = {}
    table.insert(SpawnedData, data)
    return true
end

--// Reset Flatten Level
local function ResetFlattenLevel()
    FlattenLevel = nil
end

--// UNDO
local function Undo()
    if #UndoHistory == 0 then return false, "Nothing to undo" end
    local lastData = table.remove(UndoHistory)
    table.insert(RedoHistory, lastData)
    for i = #SpawnedData, 1, -1 do
        local d = SpawnedData[i]
        if d[1] == lastData[1] and d[2] == lastData[2] and d[3] == lastData[3] then
            table.remove(SpawnedData, i)
            break
        end
    end
    Terrain:Clear()
    for _, d in ipairs(SpawnedData) do BL(d) end
    return true, "Undone 1 terrain"
end

--// REDO
local function Redo()
    if #RedoHistory == 0 then return false, "Nothing to redo" end
    local data = table.remove(RedoHistory)
    table.insert(UndoHistory, data)
    table.insert(SpawnedData, data)
    BL(data)
    return true, "Redone 1 terrain"
end

--// Generate Script
local function GenerateScript()
    if #SpawnedData == 0 then return "-- No terrain spawned yet!" end
    local code = "--// Terrain Spawn Script by shhhhnayy05\n--// Total: " .. #SpawnedData .. " terrains\n\n"
    code = code .. "local Terrain = workspace:WaitForChild('Terrain')\n\n"
    code = code .. "local function BL(d)\n"
    code = code .. "    local pos = Vector3.new(d[1], d[2], d[3])\n"
    code = code .. "    local mats = {Grass=Enum.Material.Grass,Rock=Enum.Material.Rock,Sand=Enum.Material.Sand,Water=Enum.Material.Water,Snow=Enum.Material.Snow,Mud=Enum.Material.Mud,Ground=Enum.Material.Ground,Asphalt=Enum.Material.Asphalt,Brick=Enum.Material.Brick,Wood=Enum.Material.WoodPlanks,Concrete=Enum.Material.Concrete,Ice=Enum.Material.Ice}\n"
    code = code .. "    local mat = mats[d[7]] or Enum.Material.Grass\n"
    code = code .. "    local mode = d[9] or 'Smooth'\n"
    code = code .. "    local flattenY = d[10]\n"
    code = code .. "    if mode == 'Flatten' and flattenY then\n"
    code = code .. "        Terrain:FillBlock(CFrame.new(pos.X, flattenY, pos.Z), Vector3.new(d[4], 4, d[6]), mat)\n"
    code = code .. "    elseif d[8] == 'Block' then\n"
    code = code .. "        Terrain:FillBlock(CFrame.new(pos), Vector3.new(d[4], d[5], d[6]), mat)\n"
    code = code .. "    else\n"
    code = code .. "        Terrain:FillBall(pos, math.max(d[4], d[5], d[6])/2, mat)\n"
    code = code .. "    end\n"
    code = code .. "end\n\n"
    
    local batchSize = 20
    local numBatches = math.ceil(#SpawnedData / batchSize)
    for b = 1, numBatches do
        code = code .. "for _,d in ipairs({"
        local startIdx = (b-1) * batchSize + 1
        local endIdx = math.min(b * batchSize, #SpawnedData)
        for i = startIdx, endIdx do
            local d = SpawnedData[i]
            code = code .. "{" .. d[1] .. "," .. d[2] .. "," .. d[3] .. "," .. d[4] .. "," .. d[5] .. "," .. d[6] .. ",'" .. d[7] .. "','" .. (d[8] or "Ball") .. "','" .. (d[9] or "Smooth") .. "'"
            if d[10] then
                code = code .. "," .. tostring(d[10])
            else
                code = code .. ",nil"
            end
            code = code .. "}"
            if i < endIdx then code = code .. "," end
        end
        code = code .. "})do BL(d)end\n"
    end
    code = code .. "\nprint('[Terrain by shhhhnayy05] " .. #SpawnedData .. " blocks spawned!')"
    return code
end

