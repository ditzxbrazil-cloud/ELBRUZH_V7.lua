			ExistingPositions = {}
		}
		for i, data in ipairs(shhhhnayy05.TerrainHistory) do
			currentState.TerrainHistory[i] = data
		end
		for k, v in pairs(shhhhnayy05.ExistingPositions) do
			currentState.ExistingPositions[k] = v
		end
		table.insert(shhhhnayy05.RedoStack, currentState)
		
		local prevState = table.remove(shhhhnayy05.UndoStack)
		RestoreState(prevState)
		
		StatusLabel.Text = "↩️ UNDO - " .. #shhhhnayy05.TerrainHistory .. " terrains"
		StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	else
