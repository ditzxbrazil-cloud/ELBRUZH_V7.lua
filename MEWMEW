--// INPUT HANDLING

--// Mouse Down
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not shhhhnayy05.Enabled then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDrawing = true
		
		-- Save state for undo at start of draw session
		SaveUndoState()
		
		local result = RaycastFromMouse()
		if result then
			local placePos = result.Position + result.Normal * (shhhhnayy05.BrushSize / 2)
			PlaceTerrain(placePos)
		end
	end
end)

--// Mouse Up
UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDrawing = false
	end
end)

