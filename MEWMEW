            data.Properties.Neutral = instance.Neutral
            data.Properties.AllowTeamChangeOnTouch = instance.AllowTeamChangeOnTouch
            data.Properties.Duration = instance.Duration
            data.Properties.Shape = tostring(instance.Shape)
            
        --// BACKPACK ITEM
        elseif instance:IsA("Tool") or instance:IsA("HopperBin") then
            data.Properties.RequiresHandle = instance.RequiresHandle
            data.Properties.CanBeDropped = instance.CanBeDropped
            data.Properties.ManualActivationOnly = instance.ManualActivationOnly
            
        --// CAMERA (in Workspace)
        elseif instance:IsA("Camera") then
            --// Skip cameras
            
        --// ACCOUTREMENT (Hats, etc.)
        elseif instance:IsA("Accoutrement") then
            data.Properties.AttachmentForward = {
                X = instance.AttachmentForward.X,
                Y = instance.AttachmentForward.Y,
                Z = instance.AttachmentForward.Z
            }
            data.Properties.AttachmentPos = {
