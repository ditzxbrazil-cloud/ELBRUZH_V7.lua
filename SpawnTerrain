local function GetRaycast()
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    local ray=Camera:ViewportPointToRay(center.X,center.Y)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Blacklist
    local filterList={}
    if PreviewPart then table.insert(filterList,PreviewPart) end
    if IgnoreTerrain then table.insert(filterList,Terrain) end
    params.FilterDescendantsInstances=filterList
    return Workspace:Raycast(ray.Origin,ray.Direction*1000,params)
end

local function CreatePreview()
    if PreviewPart then PreviewPart:Destroy() end
    PreviewPart=Instance.new("Part")
    if CurrentShape=="Ball" then PreviewPart.Shape=Enum.PartType.Ball
    elseif CurrentShape=="Wedge" then PreviewPart.Shape=Enum.PartType.Wedge
    else PreviewPart.Shape=Enum.PartType.Block end
    PreviewPart.Material=Enum.Material.SmoothPlastic
    PreviewPart.Color=Color3.fromRGB(255,255,255)
    PreviewPart.Transparency=0.85
    PreviewPart.CanCollide=false
    PreviewPart.Anchored=true
    PreviewPart.CastShadow=false
    PreviewPart.Parent=Workspace
    local sb=Instance.new("SelectionBox")
    sb.Name="EdgeOutline"
    sb.LineThickness=0.08
    sb.Color3=Color3.fromRGB(0,255,255)
    sb.SurfaceColor3=Color3.fromRGB(0,255,255)
    sb.SurfaceTransparency=1
    sb.Adornee=PreviewPart
    sb.Parent=PreviewPart
end

local function SnapPosition(pos)
    if not SnapEnabled then return pos end
    local sx,sy,sz=pos.X,pos.Y,pos.Z
    if SnapAxis.X then sx=math.floor(pos.X/GridSize+0.5)*GridSize end
    if SnapAxis.Y then sy=math.floor(pos.Y/GridSize+0.5)*GridSize end
    if SnapAxis.Z then sz=math.floor(pos.Z/GridSize+0.5)*GridSize end
    return Vector3.new(sx,sy,sz)
end

local function UpdateGridVisual()
    for _,line in ipairs(GridLines) do line:Destroy() end
    GridLines={}
    if not ShowGridVisual then return end
    local hrp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pp=hrp.Position
    local range=100
    local sx=math.floor((pp.X-range)/GridSize)*GridSize
    local ex=math.floor((pp.X+range)/GridSize)*GridSize
    local sz=math.floor((pp.Z-range)/GridSize)*GridSize
    local ez=math.floor((pp.Z+range)/GridSize)*GridSize
    for z=sz,ez,GridSize do
        local line=Instance.new("Part")
        line.Size=Vector3.new(range*2,0.1,0.1)
        line.CFrame=CFrame.new(pp.X,pp.Y-1,z)
        line.Anchored=true
        line.CanCollide=false
        line.Transparency=0.8
        line.Color=Color3.fromRGB(255,255,0)
        line.Material=Enum.Material.SmoothPlastic
        line.Parent=Workspace
        table.insert(GridLines,line)
    end
    for x=sx,ex,GridSize do
        local line=Instance.new("Part")
        line.Size=Vector3.new(0.1,0.1,range*2)
        line.CFrame=CFrame.new(x,pp.Y-1,pp.Z)
        line.Anchored=true
        line.CanCollide=false
        line.Transparency=0.8
        line.Color=Color3.fromRGB(255,255,0)
        line.Material=Enum.Material.SmoothPlastic
        line.Parent=Workspace
        table.insert(GridLines,line)
    end
end
