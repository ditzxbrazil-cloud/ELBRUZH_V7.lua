--// Spawn Terrain - FIXED: Hapus ExpandToGrid
local function SpawnTerrain()
    local success, _ = pcall(function()
        if not PreviewPos then return false end
        
        local maxDim = math.max(SizeX, SizeY, SizeZ)
        local padding = SmoothEnabled and (SmoothIntensity * 6) or 4
        local halfBounds = Vector3.new(maxDim/2 + padding, maxDim/2 + padding, maxDim/2 + padding)
        -- FIXED: Hapus :ExpandToGrid
        local region = Region3.new(PreviewPos - halfBounds, PreviewPos + halfBounds)
        local beforeMats, beforeOccs = Terrain:ReadVoxels(region, 4)
        local data = {
            math.floor(PreviewPos.X), math.floor(PreviewPos.Y), math.floor(PreviewPos.Z),
            SizeX, SizeY, SizeZ, CurrentMaterial.Name, CurrentShape,
            currentGrassColorIndex, currentLeafyGrassColorIndex, currentGroundColorIndex, currentRockColorIndex,    
            RotX, RotY, RotZ, SmoothEnabled, SmoothModes[CurrentSmoothModeIndex], SmoothIntensity, CurrentMode, SmoothHeight
        }
        BL(data)
        local afterMats, afterOccs = Terrain:ReadVoxels(region, 4)
        table.insert(UndoHistory, {Region = region, BeforeMats = beforeMats, BeforeOccs = beforeOccs, AfterMats = afterMats, AfterOccs = afterOccs, Data = data})
        RedoHistory = {}
        table.insert(SpawnedData, data)
        UpdateSpawnCounter()
    end)
    return success
end

--// UNDO / REDO
local function Undo()
    if #UndoHistory == 0 then return false, "Nothing to undo" end
    local lastNode = table.remove(UndoHistory)
    table.insert(RedoHistory, lastNode)
    for i = #SpawnedData, 1, -1 do if SpawnedData[i] == lastNode.Data then table.remove(SpawnedData, i); break end end
    pcall(function() Terrain:WriteVoxels(lastNode.Region, 4, lastNode.BeforeMats, lastNode.BeforeOccs) end)
    UpdateSpawnCounter()
    return true, "Undone 1 terrain"
end

