    code = code .. "local function BL(d)\n"
    if mode == "Convert Part" then
        code = code .. "    local localOffset = Vector3.new(d[1], d[2], d[3]) - OriginPos\n"
        code = code .. "    local worldCF = BasePart.CFrame * CFrame.new(localOffset)\n"
        code = code .. "    local pos = worldCF.Position\n"
    else
        code = code .. "    local pos = Vector3.new(d[1], d[2], d[3])\n"
    end
    code = code .. "    local mats = {Grass=Enum.Material.Grass,LeafyGrass=Enum.Material.LeafyGrass,Rock=Enum.Material.Rock,Sand=Enum.Material.Sand,Water=Enum.Material.Water,Snow=Enum.Material.Snow,Mud=Enum.Material.Mud,Ground=Enum.Material.Ground,Asphalt=Enum.Material.Asphalt,Brick=Enum.Material.Brick,Wood=Enum.Material.WoodPlanks,Concrete=Enum.Material.Concrete,Ice=Enum.Material.Ice}\n"
    code = code .. "    local mat = mats[d[7]] or Enum.Material.Grass\n"
    code = code .. "    local shape, actionMode = d[8] or 'Ball', d[18] or 'Build'\n"
    code = code .. "    local sizeVec = Vector3.new(d[4], d[5], d[6])\n"
    code = code .. "    pcall(function() Terrain:SetMaterialColor(Enum.Material.Grass, grassColors[d[9] or 3]) end)\n"
    code = code .. "    pcall(function() Terrain:SetMaterialColor(Enum.Material.LeafyGrass, leafyGrassColors[d[10] or 3]) end)\n"
    code = code .. "    pcall(function() Terrain:SetMaterialColor(Enum.Material.Ground, groundColors[d[11] or 2]) end)\n"
    
    if mode == "Convert Part" then
        code = code .. "    local cf = worldCF * CFrame.Angles(math.rad(d[12] or 0), math.rad(d[13] or 0), math.rad(d[14] or 0))\n"
    else
        code = code .. "    local cf = CFrame.new(pos) * CFrame.Angles(math.rad(d[12] or 0), math.rad(d[13] or 0), math.rad(d[14] or 0))\n"
    end
    
    code = code .. "    if actionMode == 'Flatten' then\n"
    if mode == "Convert Part" then
        code = code .. "        local baseCf = worldCF * CFrame.Angles(0, math.rad(d[13] or 0), 0)\n"
    else
        code = code .. "        local baseCf = CFrame.new(pos) * CFrame.Angles(0, math.rad(d[13] or 0), 0)\n"
    end
    code = code .. "        if shape == 'Block' then Terrain:FillBlock(baseCf, Vector3.new(d[4], 2, d[6]), mat); Terrain:FillBlock(baseCf * CFrame.new(0, (d[5]/2)+1, 0), Vector3.new(d[4], d[5], d[6]), Enum.Material.Air)\n"
    code = code .. "        elseif shape == 'Wedge' then Terrain:FillWedge(cf, sizeVec, mat); Terrain:FillBlock(baseCf * CFrame.new(0, (d[5]/2)+1, 0), Vector3.new(d[4], d[5], d[6]), Enum.Material.Air)\n"
    code = code .. "        else local radius = math.max(d[4], d[5], d[6])/2; Terrain:FillBall(pos, radius, mat); Terrain:FillBlock(baseCf * CFrame.new(0, radius, 0), Vector3.new(d[4], radius*2, d[6]), Enum.Material.Air) end\n"
    code = code .. "    elseif actionMode == 'Paint' then\n"
    code = code .. "        local halfSize = sizeVec / 2\n"
    code = code .. "        local region = Region3.new(pos - halfSize, pos + halfSize):ExpandToGrid(4)\n"
    code = code .. "        local m, o = Terrain:ReadVoxels(region, 4)\n"
    code = code .. "        local r = math.max(d[4], d[5], d[6])/2\n"
    code = code .. "        for x = 1, m.Size.X do for y = 1, m.Size.Y do for z = 1, m.Size.Z do\n"
    code = code .. "            if m[x][y][z] ~= Enum.Material.Air and m[x][y][z] ~= mat then\n"
    code = code .. "                if shape == 'Ball' then local vPos = region.CFrame.Position - (region.Size/2) + Vector3.new(x*4-2, y*4-2, z*4-2); if (vPos - pos).Magnitude <= r then m[x][y][z] = mat end\n"
    code = code .. "                else m[x][y][z] = mat end\n"
    code = code .. "            end\n"
    code = code .. "        end end end\n"
    code = code .. "        Terrain:WriteVoxels(region, 4, m, o)\n"
    code = code .. "    else\n"
    code = code .. "        if shape == 'Block' then Terrain:FillBlock(cf, sizeVec, mat)\n"
    code = code .. "        elseif shape == 'Wedge' then Terrain:FillWedge(cf, sizeVec, mat)\n"
    code = code .. "        else Terrain:FillBall(pos, math.max(d[4], d[5], d[6])/2, mat) end\n"
    code = code .. "    end\n"
    code = code .. "    if d[15] and actionMode ~= 'Flatten' and actionMode ~= 'Paint' then ApplySmoothTerrain(pos, sizeVec, mat, d[17], d[16], d[19]) end\n"
    code = code .. "end\n\n"
    
    if mode == "Convert Part" then
        code = code .. "local function RenderTerrain()\n"
    end
    
    local batchSize = 20
    local numBatches = math.ceil(#SpawnedData / batchSize)
    for b = 1, numBatches do
        if mode == "Convert Part" then code = code .. "    " end
        code = code .. "for _,d in ipairs({"
        local startIdx = (b-1) * batchSize + 1
        local endIdx = math.min(b * batchSize, #SpawnedData)
        for i = startIdx, endIdx do
            local d = SpawnedData[i]
            local sEnabled = d[15] and "true" or "false"
            code = code .. "{" .. d[1] .. "," .. d[2] .. "," .. d[3] .. "," .. d[4] .. "," .. d[5] .. "," .. d[6] .. ",'" .. d[7] .. "','" .. (d[8] or "Ball") .. "'," .. (d[9] or 3) .. "," .. (d[10] or 3) .. "," .. (d[11] or 2) .. "," .. (d[12] or 0) .. "," .. (d[13] or 0) .. "," .. (d[14] or 0) .. "," .. sEnabled .. ",'" .. (d[16] or "Soft Edge") .. "'," .. (d[17] or 5) .. ",'" .. (d[18] or "Build") .. "'," .. (d[19] or 5) .. "}"
            if i < endIdx then code = code .. "," end
        end
        code = code .. "})do BL(d)end\n"
    end
    
    if mode == "Convert Part" then
        code = code .. "end\n\n"
        code = code .. "RenderTerrain()\n"
        code = code .. "-- BasePart:GetPropertyChangedSignal('CFrame'):Connect(function() Terrain:Clear() RenderTerrain() end)\n"
    end
    
    code = code .. "\nprint('[Terrain] " .. #SpawnedData .. " blocks spawned!')"
    return code
end

