local function UpdatePreview()
    if not PreviewPart then CreatePreview() end
    local result=GetRaycast()
    if result then
        local rawPos=result.Position
        local displayPos=SnapEnabled and SnapPosition(rawPos) or rawPos
        PreviewPos=displayPos
        if CurrentMode=="Flatten" then
            PreviewPart.Size=Vector3.new(SizeX,SizeY,SizeZ)
            local cf=CFrame.new(displayPos)*CFrame.Angles(0,math.rad(RotY),0)
            PreviewPart.CFrame=cf*CFrame.new(0,SizeY/2,0)
        elseif CurrentMode=="Paint" then
            if CurrentShape=="Ball" then PreviewPart.Size=Vector3.new(SizeX,SizeX,SizeX)
            else PreviewPart.Size=Vector3.new(SizeX,1,SizeZ) end
            local cf=CFrame.new(displayPos)*CFrame.Angles(0,math.rad(RotY),0)
            PreviewPart.CFrame=cf
        elseif CurrentMode=="Erase" then
            PreviewPart.Size=Vector3.new(SizeX,SizeY,SizeZ)
            local cf=CFrame.new(displayPos)*CFrame.Angles(math.rad(RotX),math.rad(RotY),math.rad(RotZ))
            PreviewPart.CFrame=cf
            PreviewPart.Color=Color3.fromRGB(255,50,50)
            PreviewPart.EdgeOutline.Color3=Color3.fromRGB(255,50,50)
        else
            PreviewPart.Size=Vector3.new(SizeX,SizeY,SizeZ)
            local cf=CFrame.new(displayPos)*CFrame.Angles(math.rad(RotX),math.rad(RotY),math.rad(RotZ))
            PreviewPart.CFrame=cf
        end
        if CurrentMode~="Erase" then
            PreviewPart.Transparency=0.85
            PreviewPart.EdgeOutline.Transparency=0
            if SnapEnabled then
                PreviewPart.Color=Color3.fromRGB(100,255,150)
                PreviewPart.EdgeOutline.Color3=Color3.fromRGB(100,255,150)
            else
                PreviewPart.Color=Color3.fromRGB(255,255,255)
                PreviewPart.EdgeOutline.Color3=Color3.fromRGB(0,255,255)
            end
        end
    else
        PreviewPart.Transparency=1
        PreviewPart.EdgeOutline.Transparency=1
    end
end

local function ApplyMaterialColors()
    pcall(function() Terrain:SetMaterialColor(Enum.Material.Grass,grassColors[currentGrassColorIndex].c) end)
    pcall(function() Terrain:SetMaterialColor(Enum.Material.LeafyGrass,leafyGrassColors[currentLeafyGrassColorIndex].c) end)
    pcall(function() Terrain:SetMaterialColor(Enum.Material.Ground,groundColors[currentGroundColorIndex].c) end)
end

local function ApplySmoothTerrain(centerPos,sizeVec,material,intensity,mode)
    local radius=math.max(sizeVec.X,sizeVec.Y,sizeVec.Z)/2
    local layers=intensity or 2
    for layer=1,layers do
        local layerRadius=radius+(layer*2)
        local layerSize=math.max(2,6-layer)
        local angleStep=360/(8*layer)
        for angle=0,359,angleStep do
            local rad=math.rad(angle)
            local offsetY=0
            if mode=="Noise" then offsetY=math.random(-4,4) elseif mode=="Gradient" then offsetY=math.random(-2,2) end
            local offset=Vector3.new(math.cos(rad)*layerRadius,offsetY,math.sin(rad)*layerRadius)
            local pos=centerPos+offset
            if mode=="Soft Edge" then Terrain:FillBall(pos,layerSize/1.5,material)
            elseif mode=="Noise" then if math.random()>0.4 then Terrain:FillBall(pos,layerSize/2,material) end
            elseif mode=="Gradient" then if math.random()>0.2 then Terrain:FillBall(pos,layerSize/2,material) end
            elseif mode=="Blend" then Terrain:FillBall(pos,layerSize,material) end
        end
    end
end

local function BL(d)
    local pos=Vector3.new(d[1],d[2],d[3])
    local sx,sy,sz=d[4],d[5],d[6]
    local matName=d[7]
    local shape=d[8] or "Ball"
    local rx,ry,rz=d[12] or 0,d[13] or 0,d[14] or 0
    local smoothOn=d[15] or false
    local smoothMode=d[16] or "Soft Edge"
    local smoothInt=d[17] or 5
    local actionMode=d[18] or "Build"
    local brushStr=d[19] or 5
    local rockMix=d[20] or false
    local mat=Enum.Material.Grass
    for _,m in ipairs(Materials) do if m.N==matName then mat=m.M break end end
    ApplyMaterialColors()
    local sizeVec=Vector3.new(sx,sy,sz)
    local cf=CFrame.new(pos)*CFrame.Angles(math.rad(rx),math.rad(ry),math.rad(rz))
    local strengthMultiplier=brushStr/5
    local adjustedSize=sizeVec*strengthMultiplier
    
    if actionMode=="Erase" then
        if shape=="Block" then Terrain:FillBlock(cf,adjustedSize,Enum.Material.Air)
        elseif shape=="Wedge" then Terrain:FillWedge(cf,adjustedSize,Enum.Material.Air)
        else Terrain:FillBall(pos,math.max(adjustedSize.X,adjustedSize.Y,adjustedSize.Z)/2,Enum.Material.Air) end
    elseif actionMode=="Flatten" then
        local baseCf=CFrame.new(pos)*CFrame.Angles(0,math.rad(ry),0)
        if shape=="Block" then
            Terrain:FillBlock(baseCf,Vector3.new(sx,2,sz),mat)
            Terrain:FillBlock(baseCf*CFrame.new(0,(sy/2)+1,0),Vector3.new(sx,sy,sz),Enum.Material.Air)
        elseif shape=="Wedge" then
            Terrain:FillWedge(cf,sizeVec,mat)
            Terrain:FillBlock(baseCf*CFrame.new(0,(sy/2)+1,0),Vector3.new(sx,sy,sz),Enum.Material.Air)
        else
            local radius=math.max(sx,sy,sz)/2
            Terrain:FillBall(pos,radius,mat)
            Terrain:FillBlock(baseCf*CFrame.new(0,radius,0),Vector3.new(sx,radius*2,sz),Enum.Material.Air)
        end
    elseif actionMode=="Paint" then
        local halfSize=sizeVec/2
        local region=Region3.new(pos-halfSize,pos+halfSize):ExpandToGrid(4)
        local mats,occs=Terrain:ReadVoxels(region,4)
        local changed=false
        local radius=math.max(sx,sy,sz)/2
        for x=1,mats.Size.X do
            for y=1,mats.Size.Y do
                for z=1,mats.Size.Z do
                    if mats[x][y][z]~=Enum.Material.Air and mats[x][y][z]~=mat then
                        if shape=="Ball" then
                            local voxelPos=region.CFrame.Position-(region.Size/2)+Vector3.new(x*4-2,y*4-2,z*4-2)
                            if (voxelPos-pos).Magnitude<=radius then mats[x][y][z]=mat;changed=true end
                        else
                            mats[x][y][z]=mat;changed=true
                        end
                    end
                end
            end
        end
        if changed then Terrain:WriteVoxels(region,4,mats,occs) end
    else
        if shape=="Block" then
            Terrain:FillBlock(cf,adjustedSize,mat)
            if rockMix then
                local rockRadius=math.max(adjustedSize.X,adjustedSize.Y,adjustedSize.Z)/2
                for i=1,math.random(3,8) do
                    local offset=Vector3.new(math.random(-rockRadius,rockRadius),math.random(-rockRadius/2,rockRadius/2),math.random(-rockRadius,rockRadius))
                    if offset.Magnitude<=rockRadius then
                        Terrain:FillBall(pos+offset,math.random(2,5),Enum.Material.Rock)
                    end
                end
            end
        elseif shape=="Wedge" then
            Terrain:FillWedge(cf,sizeVec,mat)
            if rockMix then
                local rockRadius=math.max(sizeVec.X,sizeVec.Y,sizeVec.Z)/2
                for i=1,math.random(2,6) do
                    local offset=Vector3.new(math.random(-rockRadius,rockRadius),math.random(-rockRadius/2,0),math.random(-rockRadius,rockRadius))
                    if offset.Magnitude<=rockRadius then
                        Terrain:FillBall(pos+offset,math.random(2,4),Enum.Material.Rock)
                    end
                end
            end
        else
            local radius=math.max(sx,sy,sz)/2
            Terrain:FillBall(pos,radius,mat)
            if rockMix then
                for i=1,math.random(4,10) do
                    local angle=math.random()*math.pi*2
                    local dist=math.random()*radius*0.8
                    local offset=Vector3.new(math.cos(angle)*dist,math.random(-radius/3,radius/3),math.sin(angle)*dist)
                    Terrain:FillBall(pos+offset,math.random(1,4),Enum.Material.Rock)
                end
            end
        end
    end
    if smoothOn and actionMode~="Flatten" and actionMode~="Paint" and actionMode~="Erase" then
        ApplySmoothTerrain(pos,sizeVec,mat,smoothInt,smoothMode)
    end
    return d
end

