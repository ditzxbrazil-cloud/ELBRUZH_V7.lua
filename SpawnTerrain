local function UpdateColor(type, direction)
    if type == "Grass" then
        currentGrassColorIndex = currentGrassColorIndex + direction
        if currentGrassColorIndex < 1 then currentGrassColorIndex = #grassColors elseif currentGrassColorIndex > #grassColors then currentGrassColorIndex = 1 end
        grassDisplay.Text = grassColors[currentGrassColorIndex].name
        grassDisplay.BackgroundColor3 = grassColors[currentGrassColorIndex].color
    elseif type == "Leafy" then
        currentLeafyGrassColorIndex = currentLeafyGrassColorIndex + direction
        if currentLeafyGrassColorIndex < 1 then currentLeafyGrassColorIndex = #leafyGrassColors elseif currentLeafyGrassColorIndex > #leafyGrassColors then currentLeafyGrassColorIndex = 1 end
        leafyDisplay.Text = leafyGrassColors[currentLeafyGrassColorIndex].name
        leafyDisplay.BackgroundColor3 = leafyGrassColors[currentLeafyGrassColorIndex].color
    elseif type == "Ground" then
        currentGroundColorIndex = currentGroundColorIndex + direction
        if currentGroundColorIndex < 1 then currentGroundColorIndex = #groundColors elseif currentGroundColorIndex > #groundColors then currentGroundColorIndex = 1 end
        groundDisplay.Text = groundColors[currentGroundColorIndex].name
        groundDisplay.BackgroundColor3 = groundColors[currentGroundColorIndex].color
    end
    ApplyMaterialColors()
end

