    code=code.."local Terrain=workspace:WaitForChild('Terrain')\n\n"
    code=code.."local grassColors={"
    for i,c in ipairs(grassColors) do code=code..(i>1 and "," or "").."Color3.fromRGB("..math.floor(c.c.R*255)..","..math.floor(c.c.G*255)..","..math.floor(c.c.B*255)..")" end
    code=code.."}\nlocal leafyGrassColors={"
    for i,c in ipairs(leafyGrassColors) do code=code..(i>1 and "," or "").."Color3.fromRGB("..math.floor(c.c.R*255)..","..math.floor(c.c.G*255)..","..math.floor(c.c.B*255)..")" end
    code=code.."}\nlocal groundColors={"
    for i,c in ipairs(groundColors) do code=code..(i>1 and "," or "").."Color3.fromRGB("..math.floor(c.c.R*255)..","..math.floor(c.c.G*255)..","..math.floor(c.c.B*255)..")" end
    code=code.."}\n\n"
    
    code=code.."local function ApplySmoothTerrain(centerPos,sizeVec,material,intensity,mode)\n"
    code=code.."    local radius=math.max(sizeVec.X,sizeVec.Y,sizeVec.Z)/2\n"
    code=code.."    local layers=intensity or 2\n"
    code=code.."    for layer=1,layers do\n"
    code=code.."        local layerRadius=radius+(layer*2)\n"
    code=code.."        local layerSize=math.max(2,6-layer)\n"
    code=code.."        local angleStep=360/(8*layer)\n"
    code=code.."        for angle=0,359,angleStep do\n"
    code=code.."            local rad=math.rad(angle)\n"
    code=code.."            local offsetY=0\n"
    code=code.."            if mode=='Noise' then offsetY=math.random(-4,4) elseif mode=='Gradient' then offsetY=math.random(-2,2) end\n"
    code=code.."            local offset=Vector3.new(math.cos(rad)*layerRadius,offsetY,math.sin(rad)*layerRadius)\n"
    code=code.."            local pos=centerPos+offset\n"
    code=code.."            if mode=='Soft Edge' then Terrain:FillBall(pos,layerSize/1.5,material)\n"
    code=code.."            elseif mode=='Noise' then if math.random()>0.4 then Terrain:FillBall(pos,layerSize/2,material) end\n"
    code=code.."            elseif mode=='Gradient' then if math.random()>0.2 then Terrain:FillBall(pos,layerSize/2,material) end\n"
    code=code.."            elseif mode=='Blend' then Terrain:FillBall(pos,layerSize,material) end\n"
    code=code.."        end\n"
    code=code.."    end\n"
    code=code.."end\n\n"
    
    code=code.."local function BL(d)\n"
    code=code.."    local pos=Vector3.new(d[1],d[2],d[3])\n"
    code=code.."    local mats={Grass=Enum.Material.Grass,LeafyGrass=Enum.Material.LeafyGrass,Rock=Enum.Material.Rock,Sand=Enum.Material.Sand,Water=Enum.Material.Water,Snow=Enum.Material.Snow,Mud=Enum.Material.Mud,Ground=Enum.Material.Ground,Ice=Enum.Material.Ice,CrackedLava=Enum.Material.CrackedLava,Basalt=Enum.Material.Basalt,Slate=Enum.Material.Slate,Pebble=Enum.Material.Pebble,Limestone=Enum.Material.Limestone,Salt=Enum.Material.Salt}\n"
    code=code.."    local mat=mats[d[7]] or Enum.Material.Grass\n"
    code=code.."    local shape,actionMode=d[8] or 'Ball',d[18] or 'Build'\n"
    code=code.."    local sizeVec=Vector3.new(d[4],d[5],d[6])\n"
    code=code.."    local brushStr=d[19] or 5\n"
    code=code.."    local rockMix=d[20] or false\n"
    code=code.."    pcall(function() Terrain:SetMaterialColor(Enum.Material.Grass,grassColors[d[9] or 3]) end)\n"
    code=code.."    pcall(function() Terrain:SetMaterialColor(Enum.Material.LeafyGrass,leafyGrassColors[d[10] or 3]) end)\n"
    code=code.."    pcall(function() Terrain:SetMaterialColor(Enum.Material.Ground,groundColors[d[11] or 2]) end)\n"
    code=code.."    local cf=CFrame.new(pos)*CFrame.Angles(math.rad(d[12] or 0),math.rad(d[13] or 0),math.rad(d[14] or 0))\n"
    code=code.."    local strengthMultiplier=brushStr/5\n"
    code=code.."    local adjustedSize=sizeVec*strengthMultiplier\n"
    code=code.."    if actionMode=='Erase' then\n"
    code=code.."        if shape=='Block' then Terrain:FillBlock(cf,adjustedSize,Enum.Material.Air)\n"
    code=code.."        elseif shape=='Wedge' then Terrain:FillWedge(cf,adjustedSize,Enum.Material.Air)\n"
    code=code.."        else Terrain:FillBall(pos,math.max(adjustedSize.X,adjustedSize.Y,adjustedSize.Z)/2,Enum.Material.Air) end\n"
    code=code.."    elseif actionMode=='Flatten' then\n"
    code=code.."        local baseCf=CFrame.new(pos)*CFrame.Angles(0,math.rad(d[13] or 0),0)\n"
    code=code.."        if shape=='Block' then Terrain:FillBlock(baseCf,Vector3.new(d[4],2,d[6]),mat); Terrain:FillBlock(baseCf*CFrame.new(0,(d[5]/2)+1,0),Vector3.new(d[4],d[5],d[6]),Enum.Material.Air)\n"
    code=code.."        elseif shape=='Wedge' then Terrain:FillWedge(cf,sizeVec,mat); Terrain:FillBlock(baseCf*CFrame.new(0,(d[5]/2)+1,0),Vector3.new(d[4],d[5],d[6]),Enum.Material.Air)\n"
    code=code.."        else local radius=math.max(d[4],d[5],d[6])/2; Terrain:FillBall(pos,radius,mat); Terrain:FillBlock(baseCf*CFrame.new(0,radius,0),Vector3.new(d[4],radius*2,d[6]),Enum.Material.Air) end\n"
    code=code.."    elseif actionMode=='Paint' then\n"
    code=code.."        local halfSize=sizeVec/2\n"
    code=code.."        local region=Region3.new(pos-halfSize,pos+halfSize):ExpandToGrid(4)\n"
    code=code.."        local m,o=Terrain:ReadVoxels(region,4)\n"
    code=code.."        local r=math.max(d[4],d[5],d[6])/2\n"
    code=code.."        for x=1,m.Size.X do for y=1,m.Size.Y do for z=1,m.Size.Z do\n"
    code=code.."            if m[x][y][z]~=Enum.Material.Air and m[x][y][z]~=mat then\n"
    code=code.."                if shape=='Ball' then local vPos=region.CFrame.Position-(region.Size/2)+Vector3.new(x*4-2,y*4-2,z*4-2); if (vPos-pos).Magnitude<=r then m[x][y][z]=mat end\n"
    code=code.."                else m[x][y][z]=mat end\n"
    code=code.."            end\n"
    code=code.."        end end end\n"
    code=code.."        Terrain:WriteVoxels(region,4,m,o)\n"
    code=code.."    else\n"
    code=code.."        if shape=='Block' then Terrain:FillBlock(cf,adjustedSize,mat)\n"
    code=code.."        elseif shape=='Wedge' then Terrain:FillWedge(cf,sizeVec,mat)\n"
    code=code.."        else Terrain:FillBall(pos,math.max(d[4],d[5],d[6])/2,mat) end\n"
    code=code.."        if rockMix then\n"
    code=code.."            local rockRadius=math.max(adjustedSize.X,adjustedSize.Y,adjustedSize.Z)/2\n"
    code=code.."            for i=1,math.random(4,10) do\n"
    code=code.."                local angle=math.random()*math.pi*2\n"
    code=code.."                local dist=math.random()*rockRadius*0.8\n"
    code=code.."                local offset=Vector3.new(math.cos(angle)*dist,math.random(-rockRadius/3,rockRadius/3),math.sin(angle)*dist)\n"
    code=code.."                Terrain:FillBall(pos+offset,math.random(1,4),Enum.Material.Rock)\n"
    code=code.."            end\n"
    code=code.."        end\n"
    code=code.."    end\n"
    code=code.."    if d[15] and actionMode~='Flatten' and actionMode~='Paint' and actionMode~='Erase' then ApplySmoothTerrain(pos,sizeVec,mat,d[17],d[16]) end\n"
    code=code.."end\n\n"
    
    local batchSize=20
    local numBatches=math.ceil(#SpawnedData/batchSize)
    for b=1,numBatches do
        code=code.."for _,d in ipairs({"
        local startIdx=(b-1)*batchSize+1
        local endIdx=math.min(b*batchSize,#SpawnedData)
        for i=startIdx,endIdx do
            local d=SpawnedData[i]
            local sEnabled=d[15] and "true" or "false"
            local rMix=d[20] and "true" or "false"
            code=code.."{"..d[1]..","..d[2]..","..d[3]..","..d[4]..","..d[5]..","..d[6]..",'"..d[7].."','"..(d[8] or "Ball").."',"..(d[9] or 3)..","..(d[10] or 3)..","..(d[11] or 2)..","..(d[12] or 0)..","..(d[13] or 0)..","..(d[14] or 0)..","..sEnabled..",'"..(d[16] or "Soft Edge").."',"..(d[17] or 5)..",'"..(d[18] or "Build").."',"..(d[19] or 5)..","..rMix.."}"
            if i<<endIdx then code=code.."," end
        end
        code=code.."})do BL(d)end\n"
    end
    code=code.."\nprint('[Terrain] "..#SpawnedData.." blocks spawned!')"
    return code
end

