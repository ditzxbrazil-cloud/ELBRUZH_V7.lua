--// MOVE REVIEW DRAG SYSTEM
local moveReviewDrag = false
local moveReviewStartPos = nil
local moveReviewStartFrame = nil

moveReviewTitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        moveReviewDrag = true
        moveReviewStartPos = input.Position
        moveReviewStartFrame = moveReviewWin.Position
    end
end)

moveReviewTitleBar.InputEnded:Connect(function()
    moveReviewDrag = false
end)

UserInputService.InputChanged:Connect(function(input)
    pcall(function()
        if moveReviewDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - moveReviewStartPos
            local newPos = UDim2.new(moveReviewStartFrame.X.Scale, moveReviewStartFrame.X.Offset + delta.X, moveReviewStartFrame.Y.Scale, moveReviewStartFrame.Y.Offset + delta.Y)
            moveReviewWin.Position = newPos
        end
    end)
end)

--// MOVE REVIEW FUNCTIONS
local MoveReviewLastPosition = nil

local function OpenMoveReviewWindow()
    moveReviewWin.Visible = true
    moveReviewIcon.Visible = false
    MoveReviewLastPosition = moveReviewWin.Position
end

local function MinimizeMoveReviewWindow()
    moveReviewWin.Visible = false
    moveReviewIcon.Visible = true
    if MoveReviewLastPosition then
        moveReviewIcon.Position = UDim2.new(MoveReviewLastPosition.X.Scale, MoveReviewLastPosition.X.Offset + 37, MoveReviewLastPosition.Y.Scale, MoveReviewLastPosition.Y.Offset + 47)
    end
end

local function CloseMoveReviewWindow()
    moveReviewWin.Visible = false
    moveReviewIcon.Visible = false
end

local function EnableMoveReview()
    MoveReviewEnabled = true
    MoveReviewOffset = 0
    moveReviewToggleBtn.Text = "Move: ON"
    moveReviewToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
    moveReviewInfo.Text = "ON = Gunakan tombol UP/DOWN"
    moveReviewWin.Position = UDim2.new(0.5, -60, 0.5, -70)
    MoveReviewLastPosition = moveReviewWin.Position
    OpenMoveReviewWindow()
    UpdatePreview()
end

local function DisableMoveReview()
    MoveReviewEnabled = false
    MoveReviewOffset = 0
    moveReviewToggleBtn.Text = "Move: OFF"
    moveReviewToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    moveReviewInfo.Text = "OFF = Preview mengikuti raycast normal"
