            self.gui.recordBtn.Text = "🔴 RECORDING"
            self.gui.recordIcon.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        end
    end)
end

function App:refreshWalkList()
    local walks = self.dataManager:list()
    self.gui:updateWalkList(walks,
        function(name)
            local walk = self.dataManager:load(name)
            if walk then
                self.currentWalk = walk
                self.currentWalkName = name
                self.gui.loadedInfoLabel.Text = "Loaded: " .. name .. " (" .. #walk.points .. " points)"
                self.gui:updateTimeline(walk)
                self:pushUndo(walk)
            end
        end,
        function(name)
            self.dataManager:delete(name)
            self:refreshWalkList()
            if self.currentWalkName == name then
                self.currentWalk = nil
                self.currentWalkName = nil
                self.gui.loadedInfoLabel.Text = "No walk loaded"
                self.gui:updateTimeline(nil)
            end
        end
    )
end

function App:pushUndo(walkData)
    if walkData then
        table.insert(self.undoStack, walkData)
        if #self.undoStack > CONFIG.MaxUndoSteps then
            table.remove(self.undoStack, 1)
        end
        self.redoStack = {}
    end
end

function App:undo()
    if #self.undoStack > 1 then
        local current = table.remove(self.undoStack)
        table.insert(self.redoStack, current)
        local previous = self.undoStack[#self.undoStack]
        self.currentWalk = previous
        self.gui:updateTimeline(previous)
        self.gui.loadedInfoLabel.Text = "Undo: " .. (self.currentWalkName or "walk")
    end
end

