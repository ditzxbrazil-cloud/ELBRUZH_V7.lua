-- Optional: Command line interface for advanced users
local function createCommandBar()
    local cmdBar = Instance.new("Frame")
    cmdBar.Size = UDim2.new(0, 400, 0, 30)
    cmdBar.Position = UDim2.new(1, -410, 1, -40)
    cmdBar.BackgroundColor3 = Color3.fromRGB(20,20,30)
    cmdBar.Parent = game.CoreGui
    
    local cmdInput = Instance.new("TextBox")
    cmdInput.Size = UDim2.new(1, 0, 1, 0)
    cmdInput.PlaceholderText = "Command: /help"
    cmdInput.BackgroundColor3 = Color3.fromRGB(40,40,55)
    cmdInput.TextColor3 = Color3.fromRGB(255,255,255)
    cmdInput.Font = Enum.Font.Gotham
    cmdInput.Parent = cmdBar
    
    cmdInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local cmd = cmdInput.Text
            cmdInput.Text = ""
            if cmd == "/help" then
                app.gui:showModal("Commands", "/load <name> - load walk\n/save <name> - save current\n/play - play\n/stop - stop\n/speed <val> - set speed\n/list - list walks\n/cut <from> <to> - cut\n/undo - undo last edit", {{text="OK"}})
            elseif cmd:match("/load .+") then
                local name = cmd:match("/load (.+)")
                local w = app.dataManager:load(name)
                if w then
                    app.currentWalk = w
                    app.currentWalkName = name
                    app.gui.loadedInfoLabel.Text = "Loaded: " .. name
                    app.gui:updateTimeline(w)
                end
            elseif cmd:match("/save .+") then
                if app.currentWalk then
                    local name = cmd:match("/save (.+)")
                    app.currentWalk.name = name
                    app.dataManager:save(name, app.currentWalk)
                    app:refreshWalkList()
                end
            elseif cmd == "/play" then
                if app.currentWalk then
                    if app.player then app.player:stop() end
                    app.player = WalkPlayer:new(app.currentWalk, app.character, app.walkSpeed)
                    app.player:play()
                end
            elseif cmd == "/stop" then
                if app.player then app.player:stop() end
            elseif cmd:match("/speed .+") then
                local sp = tonumber(cmd:match("/speed (.+)"))
                if sp then
                    app.walkSpeed = math.clamp(sp, CONFIG.MinSpeed, CONFIG.MaxSpeed)
                    app.gui.speedLabel.Text = "Speed: " .. string.format("%.1f", app.walkSpeed)
                    if app.player then app.player:setSpeed(app.walkSpeed) end
                end
            elseif cmd == "/list" then
                local walks = app.dataManager:list()
                app.gui:showModal("Walks", table.concat(walks, "\n"), {{text="OK"}})
            elseif cmd == "/undo" then
                app:undo()
            end
        end
    end)
end

createCommandBar()

-- End of script
print("Auto Walk Pro loaded. Use GUI or /help for commands.")
