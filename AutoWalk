local function refreshJoinerLists()
    -- Clear lists
    for _, child in pairs(AvailableScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in pairs(QueueScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    -- Populate available
    local allSaves = loadFromDisk()
    for name, info in pairs(allSaves) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 35)
        btn.Text = "📄 " .. name
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 11
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        btn.Parent = AvailableScroll
        
        btn.MouseButton1Click:Connect(function()
            selectedQueueItem = {name = name, data = info.data}
            -- Highlight selection
            for _, other in pairs(AvailableScroll:GetChildren()) do
                if other:IsA("TextButton") then
                    other.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
        end)
    end
    
    -- Populate queue
    for i, item in ipairs(joinQueue) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 30)
        btn.Text = string.format("%d. %s", i, item.name)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 11
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        btn.Parent = QueueScroll
        
        btn.MouseButton1Click:Connect(function()
            for _, other in pairs(QueueScroll:GetChildren()) do
                if other:IsA("TextButton") then
                    other.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
        end)
    end
    
    AvailableScroll.CanvasSize = UDim2.new(0, 0, 0, #AvailableScroll:GetChildren() * 40)
    QueueScroll.CanvasSize = UDim2.new(0, 0, 0, #QueueScroll:GetChildren() * 35)
end

