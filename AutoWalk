-- ==================== UTILITY FUNCTIONS ==================== --

local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    local ms = math.floor((seconds % 1) * 10)
    return string.format("%02d:%02d.%d", mins, secs, ms)
end

local function calculateDistance(positions)
    local total = 0
    for i = 2, #positions do
        total = total + (positions[i].cf.Position - positions[i-1].cf.Position).Magnitude
    end
    return math.floor(total * 10) / 10
end

local function calculateDuration(positions)
    if #positions < 2 then return 0 end
    return positions[#positions].time - positions[1].time
end

-- ==================== STORAGE FUNCTIONS ==================== --

local function saveWalks()
    pcall(function()
        if writefile then
            local data = HttpService:JSONEncode(savedWalks)
            writefile("shhhhnayy05_WalkData.json", data)
        end
    end)
end

local function loadWalks()
    pcall(function()
        if readfile and isfile and isfile("shhhhnayy05_WalkData.json") then
            savedWalks = HttpService:JSONDecode(readfile("shhhhnayy05_WalkData.json"))
        end
    end)
    if type(savedWalks) ~= "table" then savedWalks = {} end
end

