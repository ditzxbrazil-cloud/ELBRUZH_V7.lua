            local walkData = loadWalk(selectedFile)
            if walkData and walkData.data then
                FileDetailWindow.Visible = false
                playReplay(walkData.data)
            end
        end
    end)
    
    DeleteFileBtn.MouseButton1Click:Connect(function()
        if selectedFile then
            deleteWalk(selectedFile)
            selectedFile = nil
            FileDetailWindow.Visible = false
            refreshFileList()
        end
    end)
    
    -- Editor
    EditorBtn.MouseButton1Click:Connect(function()
        local allSaves = loadFromDisk()
        local names = {}
        for name, _ in pairs(allSaves) do
            table.insert(names, name)
        end
        
        if #names > 0 then
            EditorFileDropdown.Text = names[1]
            selectedFile = names[1]
            local walkData = loadWalk(names[1])
            if walkData then
                TimelineInfo.Text = string.format("Durasi: %s | Titik: %d", 
                    formatTime(walkData.duration), walkData.points)
            end
        end
        
        EditorWindow.Visible = true
    end)
    
    CloseEditorBtn.MouseButton1Click:Connect(function()
        EditorWindow.Visible = false
    end)
    
    EditorFileDropdown.MouseButton1Click:Connect(function()
        local allSaves = loadFromDisk()
        local names = {}
        for name, _ in pairs(allSaves) do
            table.insert(names, name)
        end
        
        local current = EditorFileDropdown.Text
        for i, name in ipairs(names) do
            if name == current and names[i+1] then
                EditorFileDropdown.Text = names[i+1]
                selectedFile = names[i+1]
                break
            elseif name == current then
                EditorFileDropdown.Text = names[1]
                selectedFile = names[1]
                break
            end
        end
        
        local walkData = loadWalk(selectedFile)
        if walkData then
            TimelineInfo.Text = string.format("Durasi: %s | Titik: %d", 
                formatTime(walkData.duration), walkData.points)
        end
    end)
    
    ApplyTrimBtn.MouseButton1Click:Connect(function()
        if selectedFile then
            local walkData = loadWalk(selectedFile)
            if walkData and walkData.data then
                local trimStart = tonumber(StartTrimInput.Text) or 0
                local trimEnd = tonumber(EndTrimInput.Text) or walkData.duration
                
                local newData = {}
                for _, point in ipairs(walkData.data) do
                    if point.timestamp >= trimStart and point.timestamp <= trimEnd then
                        point.timestamp = point.timestamp - trimStart
                        table.insert(newData, point)
                    end
                end
                
                PathData = newData
                totalDistance = walkData.distance
                hasUnsavedData = true
                
                StatusText.Text = "DIPOTONG - Simpan sebagai baru!"
                StatusText.TextColor3 = Color3.fromRGB(255, 200, 100)
            end
        end
    end)
    
    SaveTrimBtn.MouseButton1Click:Connect(function()
        SavePrompt.Visible = true
        EditorWindow.Visible = false
    end)
    
    CancelTrimBtn.MouseButton1Click:Connect(function()
        EditorWindow.Visible = false
    end)
    
    -- Joiner
    JoinerBtn.MouseButton1Click:Connect(function()
        refreshAvailableList()
        refreshQueueList()
        JoinerWindow.Visible = true
    end)
    
    CloseJoinerBtn.MouseButton1Click:Connect(function()
        JoinerWindow.Visible = false
    end)
    
    AddToQueueBtn.MouseButton1Click:Connect(function()
        if selectedQueueFile then
            table.insert(queueList, selectedQueueFile)
            refreshQueueList()
        end
    end)
    
    RemoveFromQueueBtn.MouseButton1Click:Connect(function()
        if #queueList > 0 then
            table.remove(queueList)
            refreshQueueList()
        end
    end)
    
    ClearQueueBtn.MouseButton1Click:Connect(function()
        queueList = {}
        refreshQueueList()
    end)
    
    PlayQueueBtn.MouseButton1Click:Connect(function()
        if #queueList == 0 then return end
        
        task.spawn(function()
            for _, name in ipairs(queueList) do
                local walkData = loadWalk(name)
                if walkData and walkData.data then
                    StatusText.Text = "MEMUTAR: " .. name
                    playReplay(walkData.data)
                    task.wait(1)
                end
            end
            StatusText.Text = "ANTRIAN SELESAI"
        end)
    end)
    
    SaveQueueBtn.MouseButton1Click:Connect(function()
        if #queueList == 0 then return end
        
        local combinedData = {}
        local totalDur = 0
        local totalDist = 0
        
        for _, name in ipairs(queueList) do
            local walkData = loadWalk(name)
            if walkData and walkData.data then
                for _, point in ipairs(walkData.data) do
                    local newPoint = {}
                    for k, v in pairs(point) do
                        newPoint[k] = v
                    end
                    newPoint.timestamp = point.timestamp + totalDur
                    table.insert(combinedData, newPoint)
                end
                totalDur = totalDur + walkData.duration
                totalDist = totalDist + walkData.distance
            end
        end
        
        PathData = combinedData
        totalDistance = totalDist
        hasUnsavedData = true
        
        SavePrompt.Visible = true
        JoinerWindow.Visible = false
        
        SaveInfo.Text = string.format("Durasi: %s | Jarak: %.1fm | Titik: %d",
            formatTime(totalDur), totalDist, #combinedData)
    end)
    
    -- Keyboard Shortcuts
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.Home then
            MainFrame.Visible = not MainFrame.Visible
            MinimizedIcon.Visible = not MainFrame.Visible
        elseif input.KeyCode == Enum.KeyCode.Insert then
            if isRecording then
                stopRecording()
            else
                startRecording()
            end
        end
    end)
    
    print("AUTO WALK SHHHHNAYY05 AKTIF")
    print("Shortcut: INSERT = Record/Stop | HOME = Toggle GUI")
end

-- Jalankan GUI
createGUI()
