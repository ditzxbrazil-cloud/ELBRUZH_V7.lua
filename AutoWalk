-- File I/O (executor support)
local function fileExists(path)
    if isfile then return isfile(path) end
    return false
end

local function writeFile(path, content)
    if writefile then writefile(path, content) end
end

local function readFile(path)
    if readfile then return readfile(path) end
    return nil
end

local function listFiles(folder)
    if listfiles then return listfiles(folder) end
    return {}
end

local function deleteFile(path)
    if delfile then delfile(path) end
end

local function makeFolderIfNeeded(folder)
    if makefolder and not isfolder then
        pcall(makefolder, folder)
    elseif isfolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
end

-- ================================ DATA MANAGER ===================================
local DataManager = {}
DataManager.__index = DataManager

function DataManager:new()
    local obj = setmetatable({}, self)
    obj.folder = CONFIG.StorageFolder
    makeFolderIfNeeded(obj.folder)
    return obj
end

function DataManager:getPath(name)
    return self.folder .. "/" .. name .. ".json"
end

function DataManager:save(name, data)
    local path = self:getPath(name)
    local json = jsonEncode(data)
    writeFile(path, json)
    return true
end

function DataManager:load(name)
    local path = self:getPath(name)
    if fileExists(path) then
        local content = readFile(path)
        if content then
            return jsonDecode(content)
        end
    end
    return nil
end

function DataManager:list()
    local files = listFiles(self.folder)
    local saves = {}
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(saves, name)
        end
    end
    table.sort(saves)
    return saves
end

function DataManager:delete(name)
    local path = self:getPath(name)
    if fileExists(path) then
        deleteFile(path)
    end
end

-- ================================ WALK DATA STRUCTURE ============================
-- WalkData = {
--     name = string,
--     points = {{time=number, cframe=CFrame, velocity=Vector3?}},
--     duration = number,
--     speedMultiplier = number,
--     waypoints = {index=number, name=string}?,
--     created = os.time(),
--     version = 1
-- }

local WalkUtils = {}

function WalkUtils.createEmpty(name)
    return {
        name = name,
        points = {},
        duration = 0,
        speedMultiplier = 1,
        waypoints = {},
        created = os.time(),
        version = 1
    }
end

function WalkUtils.addPoint(walk, time, cframe)
    table.insert(walk.points, {time = time, cframe = cframe})
    walk.duration = time
end

function WalkUtils.cut(walk, startTime, endTime)
    local newPoints = {}
    for _, p in ipairs(walk.points) do
        if p.time >= startTime and p.time <= endTime then
            table.insert(newPoints, {time = p.time - startTime, cframe = p.cframe})
        end
    end
    local newWalk = WalkUtils.createEmpty(walk.name .. "_cut")
    newWalk.points = newPoints
    newWalk.duration = endTime - startTime
    newWalk.speedMultiplier = walk.speedMultiplier
    newWalk.waypoints = {}
    for _, wp in ipairs(walk.waypoints or {}) do
        if wp.time >= startTime and wp.time <= endTime then
            table.insert(newWalk.waypoints, {time = wp.time - startTime, name = wp.name})
        end
    end
    return newWalk
end

function WalkUtils.join(walks, useMount, mountSpeed)
    local newPoints = {}
    local timeOffset = 0
    local newWaypoints = {}
    for i, walk in ipairs(walks) do
        for _, p in ipairs(walk.points) do
            table.insert(newPoints, {time = p.time + timeOffset, cframe = p.cframe})
        end
        for _, wp in ipairs(walk.waypoints or {}) do
            table.insert(newWaypoints, {time = wp.time + timeOffset, name = wp.name})
        end
        if useMount and i < #walks then
            local lastCF = walk.points[#walk.points].cframe
            local nextCF = walks[i+1].points[1].cframe
            local distance = (nextCF.Position - lastCF.Position).Magnitude
            local travelTime = distance / (mountSpeed or 16)
            local steps = math.floor(travelTime / 0.1)
            for step = 1, steps do
                local t = step / steps
                local cf = lastCF:Lerp(nextCF, t)
                table.insert(newPoints, {time = timeOffset + walk.duration + t * travelTime, cframe = cf})
            end
            timeOffset = timeOffset + walk.duration + travelTime
        else
            timeOffset = timeOffset + walk.duration
        end
    end
    local joined = WalkUtils.createEmpty("joined_" .. os.time())
    joined.points = newPoints
    joined.duration = newPoints[#newPoints].time
    joined.waypoints = newWaypoints
    return joined
end

-- ================================ WALK PLAYER ENGINE ==============================
local WalkPlayer = {}
WalkPlayer.__index = WalkPlayer

function WalkPlayer:new(walkData, character, speed)
    local obj = setmetatable({}, self)
    obj.walkData = walkData
    obj.character = character
    obj.rootPart = character:WaitForChild("HumanoidRootPart")
    obj.humanoid = character:WaitForChild("Humanoid")
    obj.speed = speed or walkData.speedMultiplier or 1
    obj.isPlaying = false
    obj.isPaused = false
    obj.currentTime = 0
    obj.lastIndex = 1
    obj.connection = nil
    obj.onComplete = nil
    obj.onStuck = nil
    obj.lastPosition = nil
    obj.stuckTimer = 0
    obj.autoJump = true
    return obj
end

function WalkPlayer:play(fromTime)
    if self.isPlaying then self:stop() end
    self.isPlaying = true
    self.isPaused = false
    self.currentTime = fromTime or 0
    self.lastIndex = 1
    self.lastPosition = self.rootPart.Position
    self.stuckTimer = 0
    
    local points = self.walkData.points
    local startTime = tick()
    local speed = self.speed
    
    self.connection = RunService.Heartbeat:Connect(function(delta)
        if not self.isPlaying or self.isPaused then return end
        self.currentTime = self.currentTime + (delta * speed)
        if self.currentTime >= self.walkData.duration then
            self:stop()
            if self.onComplete then self.onComplete() end
            return
        end
        
        -- Interpolasi posisi
        local targetIndex = #points
        for i = self.lastIndex, #points do
            if points[i].time >= self.currentTime then
                targetIndex = i
                break
            end
        end
        if targetIndex > #points then return end
        
        local p1 = points[math.max(1, targetIndex-1)]
        local p2 = points[targetIndex]
        if not p1 then p1 = p2 end
        local t = (self.currentTime - p1.time) / (p2.time - p1.time)
        local newCFrame = p1.cframe:Lerp(p2.cframe, t)
        self.rootPart.CFrame = newCFrame
        self.lastIndex = targetIndex
        
        -- Anti stuck detection
        local newPos = self.rootPart.Position
        if (newPos - self.lastPosition).Magnitude < 0.5 then
            self.stuckTimer = self.stuckTimer + delta
            if self.stuckTimer > CONFIG.AntiStuckTimeout then
                if self.onStuck then self.onStuck() end
                self.stuckTimer = 0
            end
        else
            self.stuckTimer = 0
        end
        self.lastPosition = newPos
        
        -- Auto jump sederhana
        if self.autoJump then
            local rayOrigin = self.rootPart.Position + Vector3.new(0, 2, 0)
            local rayDirection = self.rootPart.CFrame.LookVector * CONFIG.AutoJumpThreshold
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {self.character}
            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
            local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            if result and result.Normal.Y < 0.5 then
                self.humanoid.Jump = true
            end
        end
    end)
end

function WalkPlayer:pause()
    self.isPaused = true
end

function WalkPlayer:resume()
    self.isPaused = false
end

function WalkPlayer:stop()
    if self.connection then
        self.connection:Disconnect()
        self.connection = nil
    end
    self.isPlaying = false
end

function WalkPlayer:setSpeed(speed)
    self.speed = speed
end

function WalkPlayer:seek(time)
    self.currentTime = math.clamp(time, 0, self.walkData.duration)
    self.lastIndex = 1
    -- langsung set posisi
    local points = self.walkData.points
    for i = #points, 1, -1 do
        if points[i].time <= self.currentTime then
            self.rootPart.CFrame = points[i].cframe
            self.lastIndex = i
            break
        end
    end
end

-- ================================ RECORDER ENGINE ================================
local Recorder = {}
Recorder.__index = Recorder

function Recorder:new(character)
    local obj = setmetatable({}, self)
    obj.character = character
    obj.rootPart = character:WaitForChild("HumanoidRootPart")
    obj.isRecording = false
    obj.data = nil
    obj.startTime = 0
    obj.lastTime = 0
    obj.connection = nil
    obj.onDataUpdate = nil
    return obj
end

function Recorder:start()
    if self.isRecording then return end
    self.isRecording = true
    self.data = WalkUtils.createEmpty("recording_" .. os.time())
    self.startTime = tick()
    self.lastTime = 0
    self.connection = RunService.Heartbeat:Connect(function()
        if not self.isRecording then return end
        local now = tick() - self.startTime
        if now - self.lastTime >= CONFIG.RecordInterval then
            WalkUtils.addPoint(self.data, now, self.rootPart.CFrame)
            self.lastTime = now
            if self.onDataUpdate then
                self.onDataUpdate(now, #self.data.points)
            end
        end
    end)
end

function Recorder:stop()
    if not self.isRecording then return end
    self.isRecording = false
    if self.connection then
        self.connection:Disconnect()
        self.connection = nil
    end
    return self.data
end

