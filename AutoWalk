        if endFrame > totalFrames then endFrame = totalFrames end

        local previewData = {}
        for i = startFrame, endFrame do
            table.insert(previewData, pathData[i])
        end

        -- Play preview with current speed
        local speedMult = State.OpenDetailWindow and State.OpenDetailWindow.CurrentMultiplier or 1.0
        PlayWalk({PathData = previewData, Duration = "Preview"}, speedMult, GUI)
    end)

    -- Concatenate Function
    ConcatBtn.MouseButton1Click:Connect(function()
        if not selectedConcatFile then
            GUI.StatusLabel.Text = "Status: Pilih file dulu!"
            GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end

        local concatData = LoadFromFile(selectedConcatFile)
        if not concatData then
            GUI.StatusLabel.Text = "Status: Gagal load file!"
            return
        end

        local concatPath = concatData.PathData or concatData.Path or {}
        if #concatPath == 0 then
            GUI.StatusLabel.Text = "Status: File kosong!"
            return
        end

        -- Concatenate: current + selected
        for _, frame in ipairs(concatPath) do
            table.insert(pathData, frame)
