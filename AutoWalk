-- === MANAJEMEN DATA === --
local function saveToDisk(allSaves)
    local success, err = pcall(function()
        writefile(SAVE_FILE_NAME, HttpService:JSONEncode(allSaves))
    end)
    if not success then
        warn("Gagal menyimpan: " .. tostring(err))
    end
end

local function loadFromDisk()
    local success, result = pcall(function()
        if isfile(SAVE_FILE_NAME) then
            return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
        end
        return {}
    end)
    if success then
        return result or {}
    else
        warn("Gagal memuat: " .. tostring(result))
        return {}
    end
end

