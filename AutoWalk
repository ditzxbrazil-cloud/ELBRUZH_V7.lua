                walkData = walk
                break
            end
        end
        
        if not walkData then return end
        
        local previewStart = tonumber(PreviewInput.Text) or 0
        local startTime = tonumber(StartTimeInput.Text) or 0
        local endTime = tonumber(EndTimeInput.Text) or walkData.duration
        
        -- Filter positions for preview
        local previewPositions = {}
        for _, pos in ipairs(walkData.positions) do
            if pos.Time >= previewStart and pos.Time >= startTime and pos.Time <= endTime then
                table.insert(previewPositions, pos)
            end
        end
        
        if #previewPositions > 1 then
            local previewWalk = {
                name = "Preview",
                positions = previewPositions,
                duration = calculateDuration(previewPositions),
                distance = calculateDistance(previewPositions),
                speedMod = walkData.speedMod or 0
            }
