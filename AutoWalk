local function storeToSlot(slotIndex, pathData)
    if not pathData or #pathData == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "SHHHHNAYY05",
            Text = "No path to store!",
            Duration = 3
        })
        return false
    end
    
    if slotIndex < 1 or slotIndex > 5 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "SHHHHNAYY05",
            Text = "Invalid slot! (1-5)",
            Duration = 3
        })
        return false
    end
    
    -- Deep copy path data
    WalkData.MergeSlots[slotIndex] = {}
    for _, point in ipairs(pathData) do
        table.insert(WalkData.MergeSlots[slotIndex], {
            cf_raw = point.cf_raw,
            velocity = point.velocity,
            state = point.state,
            time = point.time
        })
    end
    
    updateMergeSlotsDisplay()
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "SHHHHNAYY05",
        Text = "Stored to slot #" .. slotIndex .. " (" .. #pathData .. " points)",
        Duration = 3
    })
    return true
end

local function appendSlotToCurrent(slotIndex)
    local slot = WalkData.MergeSlots[slotIndex]
    if not slot or #slot == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "SHHHHNAYY05",
            Text = "Slot #" .. slotIndex .. " is empty!",
            Duration = 3
        })
        return
    end
    
    if #WalkData.CurrentPath == 0 then
        -- If current is empty, just copy
        WalkData.CurrentPath = {}
        for _, point in ipairs(slot) do
            table.insert(WalkData.CurrentPath, {
                cf_raw = point.cf_raw,
                velocity = point.velocity,
                state = point.state,
                time = point.time
            })
        end
    else
        -- Append with time offset
        local lastTime = WalkData.CurrentPath[#WalkData.CurrentPath].time
        local slotStartTime = slot[1].time
        local timeOffset = lastTime - slotStartTime + 0.1
        
        for _, point in ipairs(slot) do
            table.insert(WalkData.CurrentPath, {
                cf_raw = point.cf_raw,
                velocity = point.velocity,
                state = point.state,
                time = point.time + timeOffset
            })
        end
    end
    
    updateStats()
    TrimEndInput.Text = tostring(#WalkData.CurrentPath)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "SHHHHNAYY05",
        Text = "Appended slot #" .. slotIndex .. " (" .. #slot .. " points)",
        Duration = 3
    })
end

local function insertSlotAtPosition(slotIndex, position)
    local slot = WalkData.MergeSlots[slotIndex]
    if not slot or #slot == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "SHHHHNAYY05",
            Text = "Slot #" .. slotIndex .. " is empty!",
            Duration = 3
        })
        return
    end
    
    if #WalkData.CurrentPath == 0 then
        WalkData.CurrentPath = {}
        for _, point in ipairs(slot) do
            table.insert(WalkData.CurrentPath, {
                cf_raw = point.cf_raw,
                velocity = point.velocity,
                state = point.state,
                time = point.time
            })
        end
    else
        position = math.max(1, math.min(position, #WalkData.CurrentPath + 1))
        
        -- Calculate time offset for inserted segment
        local insertTime = 0
        if position > 1 then
            insertTime = WalkData.CurrentPath[position - 1].time
        end
        
        -- Adjust times in slot
        local adjustedSlot = {}
        local slotStartTime = slot[1].time
        for _, point in ipairs(slot) do
            table.insert(adjustedSlot, {
                cf_raw = point.cf_raw,
                velocity = point.velocity,
                state = point.state,
                time = insertTime + (point.time - slotStartTime) + 0.05
            })
        end
        
        -- Insert at position
        for i = #adjustedSlot, 1, -1 do
            table.insert(WalkData.CurrentPath, position, adjustedSlot[i])
        end
        
        -- Recalculate all times after insertion
        for i = position + #adjustedSlot, #WalkData.CurrentPath do
            if i > 1 then
                local prevTime = WalkData.CurrentPath[i - 1].time
                local currTime = WalkData.CurrentPath[i].time
                if currTime <= prevTime then
                    WalkData.CurrentPath[i].time = prevTime + 0.03
                end
            end
        end
    end
    
    updateStats()
    TrimEndInput.Text = tostring(#WalkData.CurrentPath)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "SHHHHNAYY05",
        Text = "Inserted slot #" .. slotIndex .. " at position " .. position,
        Duration = 3
    })
end

local function mergeAllSlots()
    local totalPoints = 0
    local mergedPath = {}
    
    for i = 1, 5 do
        local slot = WalkData.MergeSlots[i]
        if slot and #slot > 0 then
            local slotStartTime = slot[1].time
            local timeOffset = 0
            
            if #mergedPath > 0 then
                timeOffset = mergedPath[#mergedPath].time - slotStartTime + 0.1
            end
            
            for _, point in ipairs(slot) do
                table.insert(mergedPath, {
                    cf_raw = point.cf_raw,
                    velocity = point.velocity,
                    state = point.state,
                    time = point.time + timeOffset
                })
            end
            
            totalPoints = totalPoints + #slot
        end
    end
    
    if totalPoints == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "SHHHHNAYY05",
            Text = "No slots to merge!",
            Duration = 3
        })
        return
    end
    
    WalkData.CurrentPath = mergedPath
    updateStats()
    TrimEndInput.Text = tostring(#WalkData.CurrentPath)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "SHHHHNAYY05",
        Text = "Merged all slots! Total: " .. totalPoints .. " points",
        Duration = 3
    })
end

