ApplyTrimBtn.MouseButton1Click:Connect(function()
    if editorData then
        local startTime = tonumber(StartTrimInput.Text) or 0
        local endTime = tonumber(EndTrimInput.Text) or editorData.duration
        
        local newData = {}
        local newTotalDistance = 0
        local lastPos = nil
        
        for _, point in ipairs(editorData.data) do
            if point.timestamp >= startTime and point.timestamp <= endTime then
                local newPoint = cloneTable(point)
                newPoint.timestamp = point.timestamp - startTime
                -- Hitung ulang jarak (opsional)
                if lastPos then
                    local pos = Vector3.new(point.position[1], point.position[2], point.position[3])
                    newTotalDistance = newTotalDistance + (pos - lastPos).Magnitude
                end
                lastPos = Vector3.new(point.position[1], point.position[2], point.position[3])
                table.insert(newData, newPoint)
            end
        end
        
        editorData.data = newData
        editorData.duration = endTime - startTime
        editorData.points = #newData
        editorData.distance = newTotalDistance
        TimelineInfo.Text = string.format("Durasi: %s | Titik: %d", 
            formatTime(editorData.duration), editorData.points)
