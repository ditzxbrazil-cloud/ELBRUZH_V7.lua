--// ============================================
--// CORE FUNCTIONS - PLAYBACK (PERBAIKAN TOTAL)
--// ============================================

local function StartPlayback(fileData, GUI, speedMultiplier)
    if State.IsPlaying then return end
    
    local pathData = fileData.PathData or fileData.Path or {}
    if #pathData == 0 then
        GUI.StatusLabel.Text = "Status: No path data!"
        return
    end
    
    State.IsPlaying = true
    State.CurrentIndex = 1
    State.CurrentSpeedMultiplier = speedMultiplier or 1.0
    
    -- Update UI
    GUI.StatusLabel.Text = "Status: Playing..."
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    
    -- PERBAIKAN: Matikan collisions
    local char = LocalPlayer.Character
    if not char then 
        State.IsPlaying = false
        return 
    end
    
    local originalCollisions = {}
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then 
            originalCollisions[v] = v.CanCollide
            v.CanCollide = false 
        end
    end
    
    -- PERBAIKAN: Gunakan for loop dengan task.wait seperti logika asli
    local playConnection
    
    playConnection = task.spawn(function()
        for i = 1, #pathData do
            if not State.IsPlaying then break end
            
            -- Re-check character
            char = LocalPlayer.Character
            if not char then break end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            
            if not hrp or not hum then break end
            
            local data = pathData[i]
            if not data then continue end
            
            -- PERBAIKAN: Reconstruct CFrame dari table
            if data.cf then
                local cf = data.cf
                if typeof(cf) == "table" then
                    -- Reconstruct dari komponen
                    local pos = Vector3.new(cf.x or 0, cf.y or 0, cf.z or 0)
                    local look = Vector3.new(cf.rx or 0, cf.ry or 0, cf.rz or 0)
                    local up = Vector3.new(cf.ux or 0, cf.uy or 0, cf.uz or 0)
                    local right = look:Cross(up)
                    
                    hrp.CFrame = CFrame.fromMatrix(pos, right, up)
                else
                    hrp.CFrame = cf
                end
            end
            
            -- PERBAIKAN: Reconstruct Velocity
            if data.velocity then
                if typeof(data.velocity) == "table" then
                    hrp.Velocity = Vector3.new(
                        data.velocity.x or 0, 
                        data.velocity.y or 0, 
                        data.velocity.z or 0
                    )
                else
                    hrp.Velocity = data.velocity
                end
            end
            
            -- PERBAIKAN: Set State
            if data.state then
                local stateName = tostring(data.state)
                -- Convert string ke Enum
                for _, enum in pairs(Enum.HumanoidStateType:GetEnumItems()) do
                    if tostring(enum) == stateName then
                        if hum:GetState() ~= enum then
                            hum:ChangeState(enum)
                        end
                        break
                    end
                end
            end
            
            State.CurrentIndex = i
            
            -- PERBAIKAN: Wait dengan speed multiplier
            if State.CurrentSpeedMultiplier > 0 then
                task.wait(0.03 / State.CurrentSpeedMultiplier)
            else
                task.wait(0.03)
            end
        end
        
        -- Playback finished atau dihentikan
        State.IsPlaying = false
        
        -- Kembalikan collisions
        char = LocalPlayer.Character
        if char then
            for v, original in pairs(originalCollisions) do
                if v and v.Parent then 
                    v.CanCollide = original 
                end
            end
        end
        
        GUI.StatusLabel.Text = "Status: Playback finished"
        GUI.StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end)
    
    State.PlayConnection = {Disconnect = function() State.IsPlaying = false end}
end

local function StopPlayback(GUI)
    State.IsPlaying = false
    
    if State.PlayConnection then
        State.PlayConnection = nil
    end
    
    GUI.StatusLabel.Text = "Status: Playback stopped"
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
end

