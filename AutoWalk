                State.OpenDetailWindow = nil
                RefreshFileList(GUI)
                GUI.StatusLabel.Text = "Status: Deleted '" .. fileName .. "'"
            end
        end)
        
        confirmDialog.NoBtn.MouseButton1Click:Connect(function()
            confirmDialog.ScreenGui:Destroy()
        end)
    end)
    
    -- Video Editor button
    windowData.EditorBtn.MouseButton1Click:Connect(function()
        CreateVideoEditorWindow(fileName, fileData, GUI)
    end)
end

--// ============================================
--// MAIN INITIALIZATION
--// ============================================

local function Initialize()
    -- Wait for character
    if not Character or not Humanoid or not HRP then
        Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        Humanoid = Character:WaitForChild("Humanoid")
        HRP = Character:WaitForChild("HumanoidRootPart")
    end
    
    -- Create GUI
    local GUI = CreateMainGUI()
    
    -- Setup events
    GUI.RecordBtn.MouseButton1Click:Connect(function()
        if State.IsRecording then
            StopRecording(GUI)
        else
            StartRecording(GUI)
        end
    end)
    
    GUI.PauseBtn.MouseButton1Click:Connect(function()
        PauseRecording(GUI)
    end)
    
    GUI.SaveBtn.MouseButton1Click:Connect(function()
        if #State.PathData > 0 and not State.IsRecording then
            local jumpCount = CountJumps(State.PathData)
            local duration = FormatDuration(State.RecordDuration)
            
            local SaveDialog = CreateSaveDialog(duration, jumpCount)
            
            SaveDialog.CancelBtn.MouseButton1Click:Connect(function()
                SaveDialog.ScreenGui:Destroy()
            end)
            
            SaveDialog.SaveConfirmBtn.MouseButton1Click:Connect(function()
                local fileName = SaveDialog.InputBox.Text:gsub("[^%w%s_-]", ""):sub(1, 50)
                if fileName == "" then
                    fileName = "Walk_" .. os.time()
                end
                
                local data = {
                    PathData = State.PathData,
                    DisplayName = SaveDialog.InputBox.Text,
                    Duration = duration,
                    JumpCount = jumpCount,
                    SpeedMultiplier = 1.0,
                    RecordDate = os.date("%Y-%m-%d %H:%M:%S"),
                    WalkSpeed = GetWalkSpeed()
                }
                
                local success, err = SaveToFile(fileName, data)
                if success then
                    SaveDialog.ScreenGui:Destroy()
                    GUI.StatusLabel.Text = "Status: Saved '" .. fileName .. "'"
                    RefreshFileList(GUI)
                else
                    SaveDialog.InputBox.Text = "Error!"
                    SaveDialog.InputBox.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
            end)
        else
            GUI.StatusLabel.Text = "Status: No data to save!"
            GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
    
    -- Minimize button
    GUI.MinimizeBtn.MouseButton1Click:Connect(function()
        GUI.MainFrame.Visible = false
        
        if State.MinimizedIcon then
            pcall(function() State.MinimizedIcon.ScreenGui:Destroy() end)
        end
        
        State.MinimizedIcon = CreateMinimizedIcon()
        
        State.MinimizedIcon.IconBtn.MouseButton1Click:Connect(function()
            GUI.MainFrame.Visible = true
            pcall(function() State.MinimizedIcon.ScreenGui:Destroy() end)
            State.MinimizedIcon = nil
        end)
    end)
    
    -- Close button
    GUI.CloseBtn.MouseButton1Click:Connect(function()
        StopPlayback()
        StopRecording(GUI)
        GUI.ScreenGui:Destroy()
        
        if State.TimerOverlay then
            pcall(function() State.TimerOverlay.ScreenGui:Destroy() end)
        end
        if State.MinimizedIcon then
            pcall(function() State.MinimizedIcon.ScreenGui:Destroy() end)
        end
        if State.OpenDetailWindow then
            pcall(function() State.OpenDetailWindow.ScreenGui:Destroy() end)
        end
        if State.EditorWindow then
            pcall(function() State.EditorWindow.ScreenGui:Destroy() end)
        end
    end)
    
    -- Refresh file list
    RefreshFileList(GUI)
    
    -- Character respawn handler
    LocalPlayer.CharacterAdded:Connect(function(newChar)
        Character = newChar
        Humanoid = Character:WaitForChild("Humanoid")
        HRP = Character:WaitForChild("HumanoidRootPart")
        
        -- Stop any active playback/recording
        StopPlayback()
        if State.IsRecording then
            StopRecording(GUI)
        end
    end)
    
    return GUI
end

--// Start
local Success, Error = pcall(Initialize)
if not Success then
    warn("shhhhnayy05 AutoWalk Error: " .. tostring(Error))
end

