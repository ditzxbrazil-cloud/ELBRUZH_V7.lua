local function loadWalks()
    local loaded = false
    
    -- Try DataStore first
    if useDataStore then
        pcall(function()
            local data = DataStore:GetAsync("Walks_" .. Player.UserId)
            if data and type(data) == "table" then
                savedWalks = data
                loaded = true
            end
        end)
    end
    
    -- Try file system as backup
    if not loaded then
        pcall(function()
            if readfile and isfile then
                if isfile("AutoWalkSaves_" .. Player.Name .. ".json") then
                    local data = readfile("AutoWalkSaves_" .. Player.Name .. ".json")
                    savedWalks = game:GetService("HttpService"):JSONDecode(data)
                    loaded = true
                end
            end
        end)
    end
    
    -- Default empty if nothing loaded
    if not loaded then
        savedWalks = {}
    end
end

