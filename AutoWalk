-- ==================== UTILITY FUNCTIONS ==================== --

local function round(num, decimals)
    if decimals then
        return tonumber(string.format("%." .. decimals .. "f", num))
    end
    return math.floor(num + 0.5)
end

local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    local ms = math.floor((seconds % 1) * 10)
    return string.format("%02d:%02d.%d", mins, secs, ms)
end

local function calculateDistance(positions)
    local totalDistance = 0
    for i = 2, #positions do
        totalDistance = totalDistance + (positions[i].Position - positions[i-1].Position).Magnitude
    end
    return round(totalDistance, 1)
end

local function calculateDuration(positions)
    if #positions < 2 then return 0 end
    return positions[#positions].Time - positions[1].Time
end

local function getWalkSpeed()
    return baseWalkSpeed + walkSpeedModifier
end

local function createTween(obj, properties, duration, easingStyle, callback)
    local tween = TweenService:Create(
        obj, 
        TweenInfo.new(duration, easingStyle or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        properties
    )
    if callback then
        tween.Completed:Connect(callback)
    end
    tween:Play()
    return tween
end

