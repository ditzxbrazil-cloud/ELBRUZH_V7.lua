PlayQueueBtn.MouseButton1Click:Connect(function()
    if #queueList == 0 then return end
    
    task.spawn(function()
        for _, name in ipairs(queueList) do
            local walkData = loadWalk(name)
            if walkData and walkData.data then
                StatusText.Text = "▶ MEMUTAR: " .. name
                playReplay(walkData.data)
                task.wait(1)
            end
        end
        StatusText.Text = "✅ ANTRIAN SELESAI"
    end)
end)

SaveQueueBtn.MouseButton1Click:Connect(function()
    if #queueList == 0 then return end
    
    local combinedData = {}
    local totalDur = 0
    local totalDist = 0
    
    for _, name in ipairs(queueList) do
        local walkData = loadWalk(name)
        if walkData and walkData.data then
            for _, point in ipairs(walkData.data) do
                local newPoint = {}
                for k, v in pairs(point) do
                    newPoint[k] = v
                end
                newPoint.timestamp = point.timestamp + totalDur
                table.insert(combinedData, newPoint)
            end
            totalDur = totalDur + walkData.duration
            totalDist = totalDist + walkData.distance
        end
    end
    
    PathData = combinedData
    totalDistance = totalDist
    hasUnsavedData = true
    
    SavePrompt.Visible = true
    JoinerWindow.Visible = false
    
    SaveInfo.Text = string.format("Durasi: %s | Jarak: %.1fm | Titik: %d",
        formatTime(totalDur), totalDist, #combinedData)
end)

-- === KEYBOARD SHORTCUTS === --
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Home then
        -- Toggle GUI visibility
        MainFrame.Visible = not MainFrame.Visible
        MinimizedIcon.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.Insert then
        -- Quick record toggle
        if isRecording then
            stopRecording()
        else
            if hasUnsavedData then
                NewRecordWarningWindow.Visible = true
            else
                startRecording()
            end
        end
    end
end)

