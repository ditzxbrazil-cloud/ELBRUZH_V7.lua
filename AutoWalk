    StopButton.TextSize = 13
    StopButton.Font = Enum.Font.GothamBold
    StopButton.Text = "⏹ Stop"
    StopButton.Parent = ScreenGui
    
    local StopCorner = Instance.new("UICorner")
    StopCorner.CornerRadius = UDim.new(0.5, 0)
    StopCorner.Parent = StopButton
    
    local positions = walkData.positions
    local currentIndex = 1
    local speedMod = walkData.speedMod or 0
    
    -- Set walk speed
    pcall(function()
        Humanoid.WalkSpeed = getWalkSpeed() + speedMod
    end)
    
    local stopRequested = false
    
    StopButton.MouseButton1Click:Connect(function()
        stopRequested = true
        isPlaying = false
    end)
    
    -- Playback loop
    playConnection = RunService.Heartbeat:Connect(function()
        if not isPlaying or stopRequested or currentIndex > #positions then
            playConnection:Disconnect()
            pcall(function()
                Humanoid.WalkSpeed = getWalkSpeed()
            end)
            PlaybackFrame:Destroy()
            StopButton:Destroy()
            isPlaying = false
            return
        end
        
        local targetPosition = positions[currentIndex].Position
        local targetCFrame = targetPosition
        
        -- Check distance to target
        local distance = (RootPart.Position - targetCFrame.Position).Magnitude
        
        if distance > 1 then
            -- Move towards target
            local direction = (targetCFrame.Position - RootPart.Position).Unit
            Humanoid:MoveTo(targetCFrame.Position)
        else
            -- Reached waypoint, move to next
            currentIndex = currentIndex + 1
        end
    end)
end

