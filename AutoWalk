--// ============================================
--// UTILITY FUNCTIONS
--// ============================================

local function FormatDuration(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

local function CountJumps(pathData)
    local count = 0
    for i = 2, #pathData do
        if pathData[i].Jump and not pathData[i-1].Jump then
            count = count + 1
        end
    end
    return count
end

--// ============================================
--// FILE SYSTEM
--// ============================================

local function EnsureFolder()
    pcall(function()
        if not isfolder(CONFIG.FolderName) then
            makefolder(CONFIG.FolderName)
        end
    end)
end

local function SaveToFile(fileName, data)
    EnsureFolder()
    local cleanName = tostring(fileName):gsub("[^%w%s_-]", ""):sub(1, 50)
    if cleanName == "" then cleanName = "Walk_" .. tostring(os.time()) end
    
    local filePath = CONFIG.FolderName .. "/" .. cleanName .. CONFIG.FileExtension
    
    local jsonData
    local encodeSuccess = pcall(function()
        jsonData = HttpService:JSONEncode(data)
    end)
    
    if not encodeSuccess then return false, "JSON Encode failed" end
    
    local writeSuccess = pcall(function()
        writefile(filePath, jsonData)
    end)
    
    return writeSuccess, cleanName
end

local function LoadFromFile(fileName)
    local filePath = CONFIG.FolderName .. "/" .. fileName .. CONFIG.FileExtension
    if not isfile(filePath) then return nil end
    
    local success, data = pcall(function()
        local content = readfile(filePath)
        return HttpService:JSONDecode(content)
    end)
    
    return success and data or nil
end

local function DeleteFile(fileName)
    local filePath = CONFIG.FolderName .. "/" .. fileName .. CONFIG.FileExtension
    if isfile(filePath) then
        delfile(filePath)
        return true
    end
    return false
end

local function ListFiles()
    EnsureFolder()
    local files = {}
    local success, result = pcall(function()
        return listfiles(CONFIG.FolderName)
    end)
    
    if success and result then
        for _, filePath in ipairs(result) do
            local pattern = CONFIG.FolderName .. "/([^/]+)" .. CONFIG.FileExtension:gsub("%.", "%%.") .. "$"
            local fileName = filePath:match(pattern)
            if fileName then table.insert(files, fileName) end
        end
    end
    
    table.sort(files)
    return files
end

