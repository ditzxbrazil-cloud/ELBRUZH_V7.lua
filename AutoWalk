function GUI:updateTimeline(walkData)
    for _, child in ipairs(self.timelineFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    if not walkData or #walkData.points == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 1, 0)
        empty.BackgroundTransparency = 1
        empty.Text = "No data"
        empty.TextColor3 = Color3.fromRGB(150,150,150)
        empty.Parent = self.timelineFrame
        return
    end
    local duration = walkData.duration
    if duration <= 0 then return end
    local width = self.timelineFrame.AbsoluteSize.X - 10
    local pixelsPerSec = width / duration
    for i, point in ipairs(walkData.points) do
        if i % 10 == 0 then -- tampilkan setiap 10 titik saja
            local x = point.time * pixelsPerSec
            local marker = Instance.new("Frame")
            marker.Size = UDim2.new(0, 2, 1, 0)
            marker.Position = UDim2.new(0, x, 0, 0)
            marker.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
            marker.Parent = self.timelineFrame
        end
    end
    -- waypoint markers
    for _, wp in ipairs(walkData.waypoints or {}) do
        local x = wp.time * pixelsPerSec
        local marker = Instance.new("Frame")
        marker.Size = UDim2.new(0, 6, 1, 0)
        marker.Position = UDim2.new(0, x-3, 0, 0)
        marker.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        marker.Parent = self.timelineFrame
    end
end

