-- === SISTEM PENANDA === --
local TerrainViewer = {
    Enabled = false,
    Markers = {},
    CurrentIndex = 1
}

local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

local function calculateDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

-- === FUNGSI UTAMA === --

local function updateTimer()
    if isRecording then
        local elapsed = tick() - recordStartTime
        TimerLabel.Text = formatTime(elapsed)
    end
end

local function startRecording()
    PathData = {}
    isRecording = true
    hasUnsavedData = true
    recordStartTime = tick()
    totalDistance = 0
    lastPosition = nil
    
    RecordIcon.Text = "⏹"
    RecordIcon.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    StatusText.Text = "🔴 SEDANG MEREKAM..."
    StatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
    
    task.spawn(function()
        while isRecording do
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if hrp and hum then
                local currentPos = hrp.Position
                
                if lastPosition then
                    totalDistance = totalDistance + calculateDistance(lastPosition, currentPos)
                end
                lastPosition = currentPos
                
                table.insert(PathData, {
                    cf_raw = {hrp.CFrame:GetComponents()},
                    position = {currentPos.X, currentPos.Y, currentPos.Z},
                    velocity = {hrp.Velocity.X, hrp.Velocity.Y, hrp.Velocity.Z},
                    state = hum:GetState().Value,
                    timestamp = tick() - recordStartTime,
                    distance = totalDistance
                })
            end
            
            updateTimer()
            RunService.Heartbeat:Wait()
        end
    end)
end

local function stopRecording()
    isRecording = false
    RecordIcon.Text = "⏺"
    RecordIcon.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    StatusText.Text = "⏹ BERHENTI - Siap Disimpan"
    StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    local duration = #PathData > 0 and PathData[#PathData].timestamp or 0
    SaveInfo.Text = string.format("Durasi: %s | Jarak: %.1fm | Titik: %d", 
        formatTime(duration), totalDistance, #PathData)
end

local function discardRecording()
    isRecording = false
    hasUnsavedData = false
    PathData = {}
    totalDistance = 0
    lastPosition = nil
    RecordIcon.Text = "⏺"
    RecordIcon.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    StatusText.Text = "🗑 DIBUANG"
    StatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
    task.delay(2, function()
        StatusText.Text = "Siap Merekam"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    end)
end

-- === PLAY WALK DENGAN LOGIKA ELBRUZH === --
local function playReplay(dataToPlay, startIndex, endIndex)
    if not dataToPlay or #dataToPlay == 0 or isPlaying then return end
    
    startIndex = startIndex or 1
    endIndex = endIndex or #dataToPlay
    
    isPlaying = true
    StatusText.Text = "▶ SEDANG BERJALAN..."
    StatusText.TextColor3 = Color3.fromRGB(100, 200, 255)
    
    local char = LP.Character
    if not char then 
        isPlaying = false
        return 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if not hrp or hum then
        isPlaying = false
        return
    end
    
    -- Anti-Collision (dari Elbruzh)
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = false 
        end
    end
    
    local i = startIndex
    while i <= endIndex and isPlaying do
        local point = dataToPlay[i]
        if not point then break end
        
        -- Konversi data ke CFrame
        local cf = CFrame.new(unpack(point.cf_raw))
        
        -- Hitung kecepatan berdasarkan jarak ke point berikutnya
        local targetPos = cf.Position
        local currentPos = hrp.Position
        local distance = (targetPos - currentPos).Magnitude
        
        -- Gunakan tween untuk pergerakan smooth
        local speed = currentSpeed * 16 -- Base speed 16
        local duration = math.max(distance / speed, 0.05)
        
        local tweenInfo = TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        )
        
        local tween = TweenService:Create(hrp, tweenInfo, {
            CFrame = cf
        })
        
        tween:Play()
        tween.Completed:Wait()
        
        i = i + 1
        TimerLabel.Text = formatTime(point.timestamp or 0)
    end
    
    -- Restore collision
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = true 
        end
    end
    
    isPlaying = false
    StatusText.Text = "✅ SELESAI"
    StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    task.delay(2, function()
        StatusText.Text = "Siap Merekam"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    end)
end

