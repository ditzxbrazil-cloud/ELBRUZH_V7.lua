local function showNotification(text, duration)
    duration = duration or 3
    local notif = Instance.new("Frame")
    notif.Name = "shhhhnayy05_Notification"
    notif.Size = UDim2.new(0, 300, 0, 50)
    notif.Position = UDim2.new(0.5, -150, 0, -60)
    notif.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    notif.BorderSizePixel = 0
    notif.Parent = ScreenGui
    
    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 8)
    notifCorner.Parent = notif
    
    local notifStroke = Instance.new("UIStroke")
    notifStroke.Color = Color3.fromRGB(100, 100, 150)
    notifStroke.Thickness = 1
    notifStroke.Parent = notif
    
    local notifLabel = Instance.new("TextLabel")
    notifLabel.Size = UDim2.new(1, -20, 1, 0)
    notifLabel.Position = UDim2.new(0, 10, 0, 0)
    notifLabel.BackgroundTransparency = 1
    notifLabel.TextColor3 = Color3.new(1, 1, 1)
    notifLabel.TextSize = 13
    notifLabel.Font = Enum.Font.Gotham
    notifLabel.Text = text
    notifLabel.TextWrapped = true
    notifLabel.Parent = notif
    
    -- Animate in
    createTween(notif, {Position = UDim2.new(0.5, -150, 0, 20)}, 0.3)
    
    wait(duration)
    
    -- Animate out
    createTween(notif, {Position = UDim2.new(0.5, -150, 0, -60)}, 0.3)
    wait(0.3)
    notif:Destroy()
end

