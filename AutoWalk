local function updateStats()
    local duration = 0
    if WalkData.isRecording then
        duration = tick() - startTime
    end
    StatsLabel.Text = string.format("Points: %d | Time: %.1fs", #WalkData.CurrentPath, duration)
    
    -- Update merge window
    local mergeInfo = MergeScroll:FindFirstChild("shhhhnayy05_CurrentPathInfo")
    if mergeInfo then
        mergeInfo.Text = string.format("Points: %d | Duration: %.1fs", #WalkData.CurrentPath, duration)
    end
    
    -- Update trim window
    local trimInfo = TrimScroll:FindFirstChild("shhhhnayy05_TrimPathInfo")
    if trimInfo then
        trimInfo.Text = string.format("Current Path: %d points", #WalkData.CurrentPath)
    end
end

local function startRecording()
    if WalkData.isRecording then return end
    
    WalkData.CurrentPath = {}
    WalkData.isRecording = true
    startTime = tick()
    
    RecBtn.Visible = false
    StopBtn.Visible = true
    
    recordingConnection = RunService.Heartbeat:Connect(function()
        if not WalkData.isRecording then return end
        
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if hrp and hum then
            local cf = hrp.CFrame
            table.insert(WalkData.CurrentPath, {
                cf_raw = {cf:GetComponents()},
                velocity = {hrp.Velocity.X, hrp.Velocity.Y, hrp.Velocity.Z},
                state = hum:GetState().Value,
                time = tick() - startTime
            })
        end
        
        updateStats()
    end)
end

local function stopRecording()
    WalkData.isRecording = false
    if recordingConnection then
        recordingConnection:Disconnect()
        recordingConnection = nil
    end
    
    RecBtn.Visible = true
    StopBtn.Visible = false
    
    updateStats()
    TrimStartInput.Text = "1"
    TrimEndInput.Text = tostring(#WalkData.CurrentPath)
end

-- === PLAY WALK SYSTEM (Speed yang benar) ===
local function playWalk(pathData, speed, isPreview)
    if WalkData.isPlaying or #pathData == 0 then return end
    
    WalkData.isPlaying = true
    
    if isPreview then
        PreviewBtn.Text = "⏹ STOP"
        PreviewBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    else
        PlayWalkBtn.Text = "⏹ STOP WALK"
        PlayWalkBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    end
    
    local char = LP.Character
    if not char then 
        WalkData.isPlaying = false
        if isPreview then
            PreviewBtn.Text = "👁 PREVIEW"
            PreviewBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
        else
            PlayWalkBtn.Text = "▶ PLAY WALK"
            PlayWalkBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        end
        return 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if not hrp or not hum then
        WalkData.isPlaying = false
        if isPreview then
            PreviewBtn.Text = "👁 PREVIEW"
            PreviewBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
        else
            PlayWalkBtn.Text = "▶ PLAY WALK"
            PlayWalkBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        end
        return
    end
    
    -- Disable collisions
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = false 
        end
    end

    -- Set walk speed untuk animasi (semakin tinggi speed = semakin cepat jalan/berlari)
    local baseWalkSpeed = 16
    hum.WalkSpeed = baseWalkSpeed * speed

    -- Loop dengan frame skipping berdasarkan speed
    local i = 1
    while i <= #pathData and WalkData.isPlaying do
        local data = pathData[i]
        local targetCF = CFrame.new(unpack(data.cf_raw))
        
        -- Apply CFrame dan Velocity
        hrp.CFrame = targetCF
        hrp.Velocity = Vector3.new(unpack(data.velocity)) * speed
        
        -- Apply State
        if hum:GetState().Value ~= data.state then
            hum:ChangeState(data.state)
        end
        
        -- Tunggu berdasarkan speed (semakin tinggi speed = semakin cepat loop)
        local waitFrames = math.max(1, math.floor(1/speed))
        for _ = 1, waitFrames do
             RunService.Heartbeat:Wait()
        end
        
        -- Advance index berdasarkan speed (semakin tinggi = loncat lebih banyak frame)
        i = i + math.max(1, math.round(speed))
    end

    -- Restore
    if char then
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then 
                v.CanCollide = true 
            end
        end
    end
    
    hum.WalkSpeed = baseWalkSpeed
    WalkData.isPlaying = false
    
    if isPreview then
        PreviewBtn.Text = "👁 PREVIEW"
        PreviewBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
    else
        PlayWalkBtn.Text = "▶ PLAY WALK"
        PlayWalkBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end
end

