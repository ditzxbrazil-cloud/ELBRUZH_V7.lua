TrimExecuteBtn.MouseButton1Click:Connect(function()
    local startIdx = tonumber(TrimStartInput.Text) or 1
    local endIdx = tonumber(TrimEndInput.Text) or #WalkData.CurrentPath
    
    startIdx = math.max(1, math.floor(startIdx))
    endIdx = math.min(#WalkData.CurrentPath, math.floor(endIdx))
    
    if startIdx > endIdx then
        game:GetService("StarterGui"):SetCore("SendNotification", {
