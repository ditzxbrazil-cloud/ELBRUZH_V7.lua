        local walkData = loadWalk(selectedFile)
        if walkData then
            trimStart = tonumber(StartTrimInput.Text) or 0
            trimEnd = tonumber(EndTrimInput.Text) or walkData.duration
            
            TrimPreviewInfo.Text = string.format("Preview: %s - %s (Durasi: %s)",
                formatTime(trimStart), formatTime(trimEnd), 
                formatTime(trimEnd - trimStart))
        end
    end
end)

ApplyTrimBtn.MouseButton1Click:Connect(function()
    if selectedFile then
        local walkData = loadWalk(selectedFile)
        if walkData and walkData.data then
            trimStart = tonumber(StartTrimInput.Text) or 0
            trimEnd = tonumber(EndTrimInput.Text) or walkData.duration
            
            local newData = {}
            for _, point in ipairs(walkData.data) do
                if point.timestamp >= trimStart and point.timestamp <= trimEnd then
                    point.timestamp = point.timestamp - trimStart
                    table.insert(newData, point)
                end
            end
            
            walkData.data = newData
            walkData.duration = trimEnd - trimStart
            walkData.points = #newData
            
            -- Update in memory (will be saved with new name)
            PathData = newData
            totalDistance = walkData.distance -- Approximate
            hasUnsavedData = true
            
            StatusText.Text = "✂️ DIPOTONG - Simpan sebagai baru!"
            StatusText.TextColor3 = Color3.fromRGB(255, 200, 100)
        end
    end
end)

