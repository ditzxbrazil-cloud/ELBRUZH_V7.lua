-- === SISTEM PENANDA === --
local TerrainViewer = {
    Enabled = false,
    Markers = {},
    CurrentIndex = 1
}

local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

local function calculateDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

-- === FUNGSI UTAMA === --

local function updateTimer()
    if isRecording then
        local elapsed = tick() - recordStartTime
        TimerLabel.Text = formatTime(elapsed)
    end
end

local function startRecording()
    PathData = {}
    isRecording = true
    hasUnsavedData = true
    recordStartTime = tick()
    totalDistance = 0
    lastPosition = nil
    
    RecordIcon.Text = "⏹"
    RecordIcon.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    StatusText.Text = "🔴 SEDANG MEREKAM..."
    StatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
    
    task.spawn(function()
        while isRecording do
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if hrp and hum then
                local currentPos = hrp.Position
                
                if lastPosition then
                    totalDistance = totalDistance + calculateDistance(lastPosition, currentPos)
                end
                lastPosition = currentPos
                
                table.insert(PathData, {
                    cf_raw = {hrp.CFrame:GetComponents()},
                    position = {currentPos.X, currentPos.Y, currentPos.Z},
                    velocity = {hrp.Velocity.X, hrp.Velocity.Y, hrp.Velocity.Z},
                    state = hum:GetState().Value,
                    timestamp = tick() - recordStartTime,
                    distance = totalDistance
                })
            end
            
            updateTimer()
            RunService.Heartbeat:Wait()
        end
    end)
end

local function stopRecording()
    isRecording = false
    RecordIcon.Text = "⏺"
    RecordIcon.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    StatusText.Text = "⏹ BERHENTI - Siap Disimpan"
    StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    local duration = #PathData > 0 and PathData[#PathData].timestamp or 0
    SaveInfo.Text = string.format("Durasi: %s | Jarak: %.1fm | Titik: %d", 
        formatTime(duration), totalDistance, #PathData)
end

local function discardRecording()
    isRecording = false
    hasUnsavedData = false
    PathData = {}
    totalDistance = 0
    lastPosition = nil
    RecordIcon.Text = "⏺"
    RecordIcon.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    StatusText.Text = "🗑 DIBUANG"
    StatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
    task.delay(2, function()
        StatusText.Text = "Siap Merekam"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    end)
end

-- === PLAY WALK DENGAN LOGIKA ELBRUZH === --
local function playReplay(dataToPlay, startIndex, endIndex)
    if not dataToPlay or #dataToPlay == 0 or isPlaying then return end
    
    startIndex = startIndex or 1
    endIndex = endIndex or #dataToPlay
    
    isPlaying = true
    StatusText.Text = "▶ SEDANG BERJALAN..."
    StatusText.TextColor3 = Color3.fromRGB(100, 200, 255)
    
    local char = LP.Character
    if not char then 
        isPlaying = false
        return 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if not hrp or not hum then
        isPlaying = false
        return
    end
    
    -- Anti-Collision (dari Elbruzh)
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = false 
        end
    end
    
    local i = startIndex
    while i <= endIndex and isPlaying do
        local data = dataToPlay[i]
        if not data then break end
        
        local targetCF = CFrame.new(unpack(data.cf_raw))
        
        hrp.CFrame = targetCF
        hrp.Velocity = Vector3.new(unpack(data.velocity)) * currentSpeed
        
        -- Sync State (dari Elbruzh)
        if hum:GetState().Value ~= data.state then
            hum:ChangeState(data.state)
        end
        
        -- Marker untuk Review Mode
        if TerrainViewer.Enabled and i % 10 == 0 then
            local marker = Instance.new("Part")
            marker.Size = Vector3.new(2, 2, 2)
            marker.Shape = Enum.PartType.Ball
            marker.BrickColor = BrickColor.new("Bright yellow")
            marker.Material = Enum.Material.Neon
            marker.Position = hrp.Position + Vector3.new(0, 5, 0)
            marker.Anchored = true
            marker.CanCollide = false
            marker.Parent = Workspace

            local billboard = Instance.new("BillboardGui")
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.AlwaysOnTop = true
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.Parent = marker

            local markerText = Instance.new("TextLabel")
            markerText.Size = UDim2.new(1, 0, 1, 0)
            markerText.BackgroundTransparency = 1
            markerText.Text = tostring(i)
            markerText.TextColor3 = Color3.new(1, 1, 1)
            markerText.TextStrokeTransparency = 0
            markerText.Font = Enum.Font.GothamBold
            markerText.TextSize = 14
            markerText.Parent = billboard

            table.insert(TerrainViewer.Markers, marker)
            task.delay(2, function()
                marker:Destroy()
            end)
        end
        
        local nextIndex = math.min(i + math.floor(10 * currentSpeed), endIndex)
        local waitTime = (dataToPlay[nextIndex].timestamp - data.timestamp) / currentSpeed
        task.wait(math.max(waitTime, 0.01))
        i = nextIndex + 1
    end
    
    -- Restore Collision
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = true 
        end
    end
    
    isPlaying = false
    StatusText.Text = "✓ SELESAI"
    StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
end

