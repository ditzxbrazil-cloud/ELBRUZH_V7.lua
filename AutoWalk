    local combinedData = {}
    local timeOffset = 0
    
    for _, item in ipairs(joinQueue) do
        if item.data then
            for _, point in ipairs(item.data) do
                local newPoint = table.clone(point)
                newPoint.timestamp = point.timestamp + timeOffset
                table.insert(combinedData, newPoint)
