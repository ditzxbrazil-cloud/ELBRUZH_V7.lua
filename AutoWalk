-- Toggle Window Function
local function toggleWindow(windowName)
    local windowData = Windows[windowName]
    if not windowData or not windowData.Frame then return end
    
    windowData.Visible = not windowData.Visible
    windowData.Frame.Visible = windowData.Visible
    
    -- Update button color
    if windowData.Button then
        if windowData.Visible then
            windowData.Button.BackgroundColor3 = CONFIG.COLOR_ACCENT
        else
            windowData.Button.BackgroundColor3 = CONFIG.COLOR_SECONDARY
        end
    end
    
    -- Animation
    if windowData.Visible then
        windowData.Frame.Size = UDim2.new(0, CONFIG.GUI_WIDTH * 0.9, 0, CONFIG.GUI_HEIGHT * 0.9)
        TweenService:Create(windowData.Frame, TweenInfo.new(0.2), {
            Size = UDim2.new(0, CONFIG.GUI_WIDTH, 0, CONFIG.GUI_HEIGHT)
        }):Play()
    end
end

-- Recording Functions
local function startRecording()
    if isRecording then return end
    
    isRecording = true
    currentRecording = {}
    local startTime = tick()
    
    RecordIcon.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    TimerFrame.Visible = true
    RecordInfoFrame.Visible = true
    
    recordConnection = RunService.Heartbeat:Connect(function()
        if not isRecording then return end
        
        local char = Player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            
            if hrp and hum then
                table.insert(currentRecording, {
                    cf = hrp.CFrame,
                    velocity = hrp.Velocity,
                    state = hum:GetState(),
                    time = tick() - startTime
                })
            end
        end
        
        TimerLabel.Text = formatTime(tick() - startTime)
    end)
end

local function stopRecording()
    if not isRecording then return end
    
    isRecording = false
    if recordConnection then
        recordConnection:Disconnect()
        recordConnection = nil
    end
    
    RecordIcon.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TimerFrame.Visible = false
    RecordInfoFrame.Visible = false
    
    -- Auto open save dialog if has data
    if #currentRecording > 10 then
        -- Create save dialog
        createSaveDialog()
    end
end

-- Play Function (Your Logic)
local function playWalk(walkData)
    if isPlaying or isRecording then return end
    if not walkData or not walkData.positions or #walkData.positions == 0 then return end
    
    isPlaying = true
    PlayBtn.Text = "⏹ Stop"
    PlayBtn.BackgroundColor3 = CONFIG.COLOR_DANGER
    
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    
    -- Disable collisions
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    
    for i = 1, #walkData.positions do
        if not isPlaying then break end
        
        local data = walkData.positions[i]
        
        -- 1. Force Position
        hrp.CFrame = data.cf
        
        -- 2. Force Animation State (ANTI KAKU)
        if hum:GetState() ~= data.state then
            hum:ChangeState(data.state)
        end
        
        -- 3. Visual Velocity
        hrp.Velocity = data.velocity
        
        RunService.Heartbeat:Wait()
    end
    
    -- Restore collisions
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end
    
    isPlaying = false
    PlayBtn.Text = "▶️ Play"
    PlayBtn.BackgroundColor3 = CONFIG.COLOR_SUCCESS
end

