local App = {}
App.__index = App

function App:new()
    local obj = setmetatable({}, self)
    obj.dataManager = DataManager:new()
    obj.gui = GUI:new()
    obj.currentWalk = nil
    obj.currentWalkName = nil
    obj.recorder = nil
    obj.player = nil
    obj.walkSpeed = CONFIG.WalkSpeedDefault
    obj.recording = false
    obj.recordDataPoints = 0
    obj.undoStack = {}
    obj.redoStack = {}
    return obj
end

function App:init()
    self.gui:create()
    self:bindEvents()
    self:refreshWalkList()
    self:setupCharacter()
    game.Players.LocalPlayer.CharacterAdded:Connect(function() self:setupCharacter() end)
end

function App:setupCharacter()
    local player = game.Players.LocalPlayer
    self.character = player.Character or player.CharacterAdded:Wait()
    self.humanoid = self.character:WaitForChild("Humanoid")
    self.rootPart = self.character:WaitForChild("HumanoidRootPart")
    self.recorder = Recorder:new(self.character)
    self.recorder.onDataUpdate = function(time, points)
        self.recordDataPoints = points
        self.gui.recordTimeLabel.Text = string.format("⏱️ Record time: %.2f s (%d points)", time, points)
    end
end

function App:bindEvents()
    -- Record
    self.gui.recordBtn.MouseButton1Click:Connect(function()
        if self.recording then return end
        self.recording = true
        self.recorder:start()
        self.gui.recordBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        self.gui.recordBtn.Text = "🔴 RECORDING"
        -- Juga update icon record
        self.gui.recordIcon.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    end)
    
    self.gui.stopRecordBtn.MouseButton1Click:Connect(function()
        if not self.recording then return end
        self.recording = false
        local walkData = self.recorder:stop()
        self.currentWalk = walkData
        self.currentWalkName = nil
        self.gui.recordBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        self.gui.recordBtn.Text = "🔴 RECORD"
        self.gui.recordIcon.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        self.gui.loadedInfoLabel.Text = "Recorded walk ready to save"
        self.gui:updateTimeline(walkData)
        self:pushUndo(walkData)
    end)
    
    -- Save
    self.gui.saveBtn.MouseButton1Click:Connect(function()
        if not self.currentWalk or #self.currentWalk.points == 0 then
            self.gui:showModal("Error", "No recorded walk to save", {{text="OK", color=Color3.fromRGB(100,100,120)}})
            return
        end
        self.gui:showInputModal("Save Walk", "Enter walk name", function(name)
            if name == "" then name = "walk_" .. os.time() end
            self.currentWalk.name = name
            self.dataManager:save(name, self.currentWalk)
            self.refreshWalkList()
            self.gui:showModal("Saved", "Walk '" .. name .. "' saved successfully", {{text="OK", color=Color3.fromRGB(100,200,100)}})
        end)
    end)
    
    -- Speed
    self.gui.speedMinus.MouseButton1Click:Connect(function()
        self.walkSpeed = math.max(CONFIG.MinSpeed, self.walkSpeed - CONFIG.SpeedStep)
        self.gui.speedLabel.Text = "Speed: " .. string.format("%.1f", self.walkSpeed)
        if self.player then self.player:setSpeed(self.walkSpeed) end
    end)
    self.gui.speedPlus.MouseButton1Click:Connect(function()
        self.walkSpeed = math.min(CONFIG.MaxSpeed, self.walkSpeed + CONFIG.SpeedStep)
        self.gui.speedLabel.Text = "Speed: " .. string.format("%.1f", self.walkSpeed)
        if self.player then self.player:setSpeed(self.walkSpeed) end
    end)
    
    -- Playback
    self.gui.playBtn.MouseButton1Click:Connect(function()
        if not self.currentWalk then
            self.gui:showModal("Error", "Load a walk first", {{text="OK"}})
            return
        end
        if self.player and self.player.isPlaying then
            self.player:stop()
        end
        self.player = WalkPlayer:new(self.currentWalk, self.character, self.walkSpeed)
        self.player.onComplete = function()
            self.gui:showModal("Complete", "Walk finished", {{text="OK"}})
        end
        self.player:play()
    end)
    
    self.gui.pauseBtn.MouseButton1Click:Connect(function()
        if self.player and self.player.isPlaying then
            if self.player.isPaused then
                self.player:resume()
                self.gui.pauseBtn.Text = "⏸ PAUSE"
            else
                self.player:pause()
                self.gui.pauseBtn.Text = "▶ RESUME"
            end
        end
    end)
    
    self.gui.stopPlayBtn.MouseButton1Click:Connect(function()
        if self.player then
            self.player:stop()
            self.player = nil
            self.gui.pauseBtn.Text = "⏸ PAUSE"
        end
    end)
    
    -- Cut editor
    self.gui.cutBtn.MouseButton1Click:Connect(function()
        if not self.currentWalk then
            self.gui:showModal("Error", "Load a walk first", {{text="OK"}})
            return
        end
        self:openCutEditor()
    end)
    
    -- Join editor
    self.gui.joinBtn.MouseButton1Click:Connect(function()
        self:openJoinEditor()
    end)
    
    -- Record icon (floating)
    self.gui.recordIcon.MouseButton1Click:Connect(function()
        if self.recording then
            self.recording = false
            local walkData = self.recorder:stop()
            self.currentWalk = walkData
            self.gui.recordBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            self.gui.recordBtn.Text = "🔴 RECORD"
            self.gui.recordIcon.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
