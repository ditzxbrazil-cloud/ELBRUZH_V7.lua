    -- === FUNGSI HELPER === --
    local function formatTime(seconds)
        local mins = math.floor(seconds / 60)
        local secs = math.floor(seconds % 60)
        return string.format("%02d:%02d", mins, secs)
    end
    
    local function calculateDistance(pos1, pos2)
        return (pos1 - pos2).Magnitude
    end
    
    -- === FUNGSI REKAM === --
    local function updateTimer()
        if isRecording then
            local elapsed = tick() - recordStartTime
            TimerLabel.Text = formatTime(elapsed)
        end
    end
    
    local function startRecording()
        PathData = {}
        isRecording = true
        hasUnsavedData = true
        recordStartTime = tick()
        totalDistance = 0
        lastPosition = nil
        
        RecordIcon.Text = "STOP"
        RecordIcon.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        StatusText.Text = "SEDANG MEREKAM..."
        StatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        task.spawn(function()
            while isRecording do
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                
                if hrp and hum then
                    local currentPos = hrp.Position
                    
                    if lastPosition then
                        totalDistance = totalDistance + calculateDistance(lastPosition, currentPos)
                    end
                    lastPosition = currentPos
                    
                    table.insert(PathData, {
                        cf_raw = {hrp.CFrame:GetComponents()},
                        position = {currentPos.X, currentPos.Y, currentPos.Z},
                        velocity = {hrp.Velocity.X, hrp.Velocity.Y, hrp.Velocity.Z},
                        state = hum:GetState().Value,
                        timestamp = tick() - recordStartTime,
                        distance = totalDistance
                    })
                end
                
                updateTimer()
                RunService.Heartbeat:Wait()
            end
        end)
    end
    
    local function stopRecording()
        isRecording = false
        RecordIcon.Text = "REC"
        RecordIcon.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StatusText.Text = "BERHENTI - Siap Disimpan"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        local duration = #PathData > 0 and PathData[#PathData].timestamp or 0
        SaveInfo.Text = string.format("Durasi: %s | Jarak: %.1fm", 
            formatTime(duration), totalDistance)
    end
    
    -- === PLAY WALK === --
    local function playReplay(dataToPlay)
        if not dataToPlay or #dataToPlay == 0 or isPlaying then return end
        
        isPlaying = true
        StatusText.Text = "SEDANG BERJALAN..."
        StatusText.TextColor3 = Color3.fromRGB(100, 200, 255)
        
        local char = LP.Character
        if not char then 
            isPlaying = false
            return 
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        
        if not hrp or not hum then
            isPlaying = false
            return
        end
        
        -- Anti-Collision
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then 
                v.CanCollide = false 
            end
        end
        
        for _, data in ipairs(dataToPlay) do
            if not isPlaying then break end
            
            local targetCF = CFrame.new(unpack(data.cf_raw))
            hrp.CFrame = targetCF
            hrp.Velocity = Vector3.new(unpack(data.velocity)) * currentSpeed
            
            if hum:GetState().Value ~= data.state then
                hum:ChangeState(data.state)
            end
            
            RunService.Heartbeat:Wait()
        end
        
        -- Reset collision
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then 
                v.CanCollide = true 
            end
        end
        
        isPlaying = false
        StatusText.Text = "SELESAI"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        task.delay(2, function()
            if not isRecording and not isPlaying then
                StatusText.Text = "Siap Merekam"
                StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
        end)
    end
    
    -- === SIMPAN & LOAD === --
    local function saveWalk(name)
        if #PathData == 0 then
            StatusText.Text = "TIDAK ADA DATA!"
            StatusText.TextColor3 = Color3.fromRGB(255, 100, 100)
            return false
        end
        
        local allSaves = loadFromDisk()
        
        allSaves[name] = {
            data = PathData,
            duration = PathData[#PathData].timestamp,
            distance = totalDistance,
            points = #PathData,
            savedAt = os.date("%Y-%m-%d %H:%M:%S")
        }
        
        saveToDisk(allSaves)
        hasUnsavedData = false
        
        StatusText.Text = "TERSIMPAN: " .. name
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        return true
    end
    
    local function loadWalk(name)
        local allSaves = loadFromDisk()
        return allSaves[name]
    end
    
    local function deleteWalk(name)
        local allSaves = loadFromDisk()
        allSaves[name] = nil
        saveToDisk(allSaves)
    end
    
