-- ==================== RECORDING FUNCTIONS ==================== --

local function startRecording()
    if isRecording then return end
    
    isRecording = true
    currentRecording = {}
    startTime = tick()
    
    -- Update UI
    RecordIcon.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    TimerFrame.Visible = true
    RecordInfoFrame.Visible = true
    RecordToolTip.Text = "Stop Recording"
    
    -- Recording loop
    recordConnection = RunService.Heartbeat:Connect(function()
        if not isRecording then return end
        
        local character = Player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and rootPart and humanoid.MoveDirection.Magnitude > 0 then
                local waypoint = {
                    Position = rootPart.CFrame,
                    Time = tick() - startTime
                }
                table.insert(currentRecording, waypoint)
            end
        end
        
        -- Update timer
        local elapsed = tick() - startTime
        TimerLabel.Text = formatTime(elapsed)
        RecordInfoLabel.Text = "⏺ Recording... " .. formatTime(elapsed)
    end)
end

local function stopRecording()
    if not isRecording then return end
    
    isRecording = false
    
    if recordConnection then
        recordConnection:Disconnect()
        recordConnection = nil
    end
    
    -- Update UI
    RecordIcon.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    TimerFrame.Visible = false
    RecordInfoFrame.Visible = false
    RecordToolTip.Text = "Record Walk"
    
    -- Show save dialog if recording has content
    if #currentRecording > 1 then
        createSaveDialog()
    else
        currentRecording = {}
    end
end

local function toggleRecording()
    if isRecording then
        stopRecording()
    else
        startRecording()
    end
end

