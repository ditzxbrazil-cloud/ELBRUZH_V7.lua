            GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end

        -- Trim data
        local trimmedData = {}
        for i = startFrame, endFrame do
            table.insert(trimmedData, pathData[i])
        end

        -- Update fileData
        fileData.PathData = trimmedData
        fileData.Path = trimmedData
        fileData.Points = #trimmedData

        -- Recalculate duration
        local newDuration = FormatDuration(#trimmedData * CONFIG.RecordInterval)
        fileData.Duration = newDuration

        GUI.StatusLabel.Text = "Status: Trimmed " .. startFrame .. "-" .. endFrame .. " (" .. #trimmedData .. " frames)"
