-- ==================== PLAYBACK FUNCTION (Using Your Logic) ==================== --

function playWalk(walkData)
    if isPlaying then return end
    if isRecording then return end
    
    isPlaying = true
    
    Character = Player.Character or Player.CharacterAdded:Wait()
    local hrp = Character:WaitForChild("HumanoidRootPart")
    local hum = Character:WaitForChild("Humanoid")
    
    -- Disable collisions temporarily
    for _, v in pairs(Character:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = false 
        end
    end
    
    -- Playback notification
    local PlaybackFrame = Instance.new("Frame")
    PlaybackFrame.Name = "shhhhnayy05_PlaybackFrame"
    PlaybackFrame.Size = UDim2.new(0, 200, 0, 40)
    PlaybackFrame.Position = UDim2.new(0.5, -100, 0, 100)
    PlaybackFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    PlaybackFrame.BorderSizePixel = 0
    PlaybackFrame.Parent = ScreenGui
    
    local PlaybackCorner = Instance.new("UICorner")
    PlaybackCorner.CornerRadius = UDim.new(0.5, 0)
    PlaybackCorner.Parent = PlaybackFrame
    
    local PlaybackStroke = Instance.new("UIStroke")
    PlaybackStroke.Color = Color3.fromRGB(50, 150, 50)
    PlaybackStroke.Thickness = 2
    PlaybackStroke.Parent = PlaybackFrame
    
    local PlaybackLabel = Instance.new("TextLabel")
    PlaybackLabel.Name = "shhhhnayy05_PlaybackLabel"
    PlaybackLabel.Size = UDim2.new(1, -10, 1, 0)
    PlaybackLabel.Position = UDim2.new(0, 5, 0, 0)
    PlaybackLabel.BackgroundTransparency = 1
    PlaybackLabel.TextColor3 = Color3.new(1, 1, 1)
    PlaybackLabel.TextSize = 14
    PlaybackLabel.Font = Enum.Font.GothamBold
    PlaybackLabel.Text = "▶️ Playing..."
    PlaybackLabel.Parent = PlaybackFrame
    
    local StopButton = Instance.new("TextButton")
    StopButton.Name = "shhhhnayy05_StopButton"
    StopButton.Size = UDim2.new(0, 80, 0, 35)
    StopButton.Position = UDim2.new(0.5, -40, 0, 150)
    StopButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    StopButton.TextColor3 = Color3.new(1, 1, 1)
    StopButton.TextSize = 13
    StopButton.Font = Enum.Font.GothamBold
    StopButton.Text = "⏹ Stop"
    StopButton.Parent = ScreenGui
    
    local StopCorner = Instance.new("UICorner")
    StopCorner.CornerRadius = UDim.new(0.5, 0)
    StopCorner.Parent = StopButton
    
    local stopRequested = false
    
    StopButton.MouseButton1Click:Connect(function()
        stopRequested = true
        isPlaying = false
    end)
    
    -- Playback using your logic with state
    local positions = walkData.positions
    
    for i = 1, #positions do
        if not isPlaying or stopRequested then break end
        
        local data = positions[i]
        
        -- 1. Force Position (Smooth)
        hrp.CFrame = data.cf
        
        -- 2. Force Animation State (ANTI STIFF JUMP)
        if hum:GetState() ~= data.state then
            hum:ChangeState(data.state)
        end
        
        -- 3. Give visual velocity so Roblox Animate script works
        hrp.Velocity = data.velocity
        
        RunService.Heartbeat:Wait()
    end
    
    -- Restore collisions
    for _, v in pairs(Character:GetChildren()) do
        if v:IsA("BasePart") then 
            v.CanCollide = true 
        end
    end
    
    PlaybackFrame:Destroy()
    StopButton:Destroy()
    isPlaying = false
end

-- ==================== RECORDING FUNCTIONS ==================== --

local function startRecording()
    if isRecording then return end
    
    isRecording = true
    currentRecording = {}
    startTime = tick()
    
    RecordIcon.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    TimerFrame.Visible = true
    RecordInfoFrame.Visible = true
    RecordToolTip.Text = "Stop Recording"
    
    recordConnection = RunService.Heartbeat:Connect(function()
        if not isRecording then return end
        
        local char = Player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            
            if hrp and hum then
                -- Record state: Important so jump isn't stiff
                table.insert(currentRecording, {
                    cf = hrp.CFrame,
                    velocity = hrp.Velocity,
                    state = hum:GetState(), -- Record if Jumping, Running, or Falling
                    time = tick() - startTime
                })
            end
        end
        
        local elapsed = tick() - startTime
        TimerLabel.Text = formatTime(elapsed)
        RecordInfoLabel.Text = "⏺ Recording... " .. formatTime(elapsed)
    end)
end

local function stopRecording()
    if not isRecording then return end
    
    isRecording = false
    
    if recordConnection then
        recordConnection:Disconnect()
        recordConnection = nil
    end
    
    RecordIcon.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    TimerFrame.Visible = false
