-- === FUNGSI CLONE MANUAL (PERBAIKAN) === --
local function cloneTable(original)
    local copy = {}
    for k, v in pairs(original) do
        if type(v) == "table" then
            copy[k] = cloneTable(v)
        else
            copy[k] = v
        end
    end
    return copy
end

-- === MANAJEMEN DATA === --
local function saveToDisk(allSaves)
    writefile(SAVE_FILE_NAME, HttpService:JSONEncode(allSaves))
end

local function loadFromDisk()
    if isfile(SAVE_FILE_NAME) then
        return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
    end
    return {}
end

