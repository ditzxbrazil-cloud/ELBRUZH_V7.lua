            if walk.name == walkName then
                walkData = walk
                walkIndex = i
                break
            end
        end
        
        if not walkData then return end
        
        local startTime = tonumber(StartTimeInput.Text) or 0
        local endTime = tonumber(EndTimeInput.Text) or walkData.duration
        
        -- Filter positions
        local newPositions = {}
        for _, pos in ipairs(walkData.positions) do
            if pos.Time >= startTime and pos.Time <= endTime then
                -- Adjust time relative to new start
                local adjustedPos = {
                    Position = pos.Position,
                    Time = pos.Time - startTime
                }
                table.insert(newPositions, adjustedPos)
            end
        end
        
        if #newPositions > 1 then
            local cutWalk = {
                name = walkData.name .. "_Cut",
                positions = newPositions,
                duration = calculateDuration(newPositions),
                distance = calculateDistance(newPositions),
                speedMod = walkData.speedMod or 0,
                timestamp = os.time()
