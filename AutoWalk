local function clearMarkers()
    for _, marker in pairs(TerrainViewer.Markers) do
        if marker then marker:Destroy() end
    end
    TerrainViewer.Markers = {}
    TerrainViewer.CurrentIndex = 1
end

local function createMarker(position, color, number)
    local marker = Instance.new("Part")
    marker.Name = "shhhhnayy05_Marker_" .. tostring(number)
    marker.Shape = Enum.PartType.Ball
    marker.Size = Vector3.new(2, 2, 2)
    marker.Position = position + Vector3.new(0, 3, 0)
    marker.Anchored = true
    marker.CanCollide = false
    marker.Color = color or Color3.fromRGB(0, 255, 255)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.3
    marker.Parent = Workspace
    
    -- Billboard GUI untuk nomor
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 50, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = marker
    
    local numberLabel = Instance.new("TextLabel")
    numberLabel.Size = UDim2.new(1, 0, 1, 0)
    numberLabel.Text = tostring(number)
    numberLabel.TextColor3 = Color3.new(1, 1, 1)
    numberLabel.TextSize = 20
    numberLabel.Font = Enum.Font.GothamBold
    numberLabel.BackgroundTransparency = 1
    numberLabel.Parent = billboard
    
    table.insert(TerrainViewer.Markers, marker)
    return marker
end

local function showPathMarkers(data, startIdx, endIdx, color)
    clearMarkers()
    if not data or #data == 0 then return end
    
    startIdx = startIdx or 1
    endIdx = endIdx or #data
    
    for i = startIdx, endIdx, math.max(1, math.floor((endIdx - startIdx) / 20)) do
        local point = data[i]
        if point and point.position then
            local pos = Vector3.new(unpack(point.position))
            createMarker(pos, color, i)
        end
    end
end

local function highlightTrimSection(data, trimStart, trimEnd)
    clearMarkers()
    if not data or #data == 0 then return end
    
    -- Mark titik sebelum trim (merah)
    for i = 1, trimStart - 1, math.max(1, math.floor(trimStart / 10)) do
        local point = data[i]
        if point and point.position then
            local pos = Vector3.new(unpack(point.position))
            createMarker(pos, Color3.fromRGB(255, 50, 50), i)
        end
    end
    
    -- Mark titik dalam trim (hijau)
    for i = trimStart, trimEnd, math.max(1, math.floor((trimEnd - trimStart) / 15)) do
        local point = data[i]
        if point and point.position then
            local pos = Vector3.new(unpack(point.position))
            createMarker(pos, Color3.fromRGB(50, 255, 50), i)
        end
    end
    
    -- Mark titik setelah trim (kuning)
    for i = trimEnd + 1, #data, math.max(1, math.floor((#data - trimEnd) / 10)) do
        local point = data[i]
        if point and point.position then
            local pos = Vector3.new(unpack(point.position))
            createMarker(pos, Color3.fromRGB(255, 255, 50), i)
        end
    end
end

-- === FUNGSI UTILITY EDITOR === --
local function findIndexByTimestamp(data, targetTime)
    if not data or #data == 0 then return 1 end
    
    for i, point in ipairs(data) do
        if point.timestamp >= targetTime then
            return i
        end
    end
    return #data
end

local function trimData(data, startTime, endTime)
    if not data or #data == 0 then return {} end
    
    local startIdx = findIndexByTimestamp(data, startTime)
    local endIdx = findIndexByTimestamp(data, endTime)
    
    local trimmed = {}
    for i = startIdx, endIdx do
        if data[i] then
            local newPoint = table.clone(data[i])
            -- Adjust timestamp relatif
            newPoint.timestamp = data[i].timestamp - startTime
            table.insert(trimmed, newPoint)
        end
    end
    
    return trimmed
end

