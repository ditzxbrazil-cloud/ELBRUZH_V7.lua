local function StartRecording(GUI)
    if State.IsRecording then return end
    
    State.IsRecording = true
    State.IsPaused = false
    State.PathData = {}
    State.CurrentIndex = 1
    State.RecordStartTime = tick()
    
    -- Create timer overlay
    if not State.TimerOverlay then
        CreateTimerOverlay()
    else
        State.TimerOverlay.ScreenGui.Enabled = true
    end
    
    -- Update UI
    GUI.RecordBtn.Text = "⏹ Stop"
    GUI.RecordBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    GUI.PauseBtn.Text = "⏸ Pause"
    GUI.PauseBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    GUI.StatusLabel.Text = "Status: Recording..."
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    
    -- PERBAIKAN: Simpan original collisions
    local char = LocalPlayer.Character
    if char then
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then
                State.OriginalCollisions[v] = v.CanCollide
                v.CanCollide = false
            end
        end
    end
    
    -- Record loop
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not State.IsRecording then 
            connection:Disconnect() 
            return 
        end
        
        if State.IsPaused then return end
        
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if hrp and hum then
            -- PERBAIKAN: Simpan data dengan format yang bisa di-serialize
            local cf = hrp.CFrame
            local vel = hrp.Velocity
            
            table.insert(State.PathData, {
                cf = {
                    x = cf.X, y = cf.Y, z = cf.Z,
                    rx = cf.LookVector.X, ry = cf.LookVector.Y, rz = cf.LookVector.Z,
                    ux = cf.UpVector.X, uy = cf.UpVector.Y, uz = cf.UpVector.Z
                },
                velocity = {x = vel.X, y = vel.Y, z = vel.Z},
                state = tostring(hum:GetState()),
                Time = tick() - State.RecordStartTime
            })
            
            -- Update timer
            local elapsed = tick() - State.RecordStartTime
            local formatted = FormatDuration(elapsed)
            GUI.TimerLabel.Text = "⏱ " .. formatted
            if State.TimerOverlay then
                State.TimerOverlay.TimerLabel.Text = "⏱ " .. formatted
            end
        end
    end)
    
    State.RecordConnection = connection
end

local function StopRecording(GUI)
    if not State.IsRecording then return end
    
    State.IsRecording = false
    
    if State.RecordConnection then
        State.RecordConnection:Disconnect()
        State.RecordConnection = nil
    end
    
    -- PERBAIKAN: Restore collisions
    local char = LocalPlayer.Character
    if char then
        for v, original in pairs(State.OriginalCollisions) do
            if v and v.Parent then
                v.CanCollide = original
            end
        end
    end
    State.OriginalCollisions = {}
    
    -- Hide timer overlay
    if State.TimerOverlay then
        State.TimerOverlay.ScreenGui.Enabled = false
    end
    
    -- Calculate duration
    State.RecordDuration = tick() - State.RecordStartTime
    
    -- Update UI
    GUI.RecordBtn.Text = "⏺ Record"
    GUI.RecordBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    GUI.PauseBtn.Text = "⏸ Pause"
    GUI.PauseBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    GUI.StatusLabel.Text = "Status: Recorded " .. #State.PathData .. " frames"
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    -- Show save dialog
    local jumpCount = CountJumps(State.PathData)
    local SaveDialog = CreateSaveDialog(FormatDuration(State.RecordDuration), jumpCount)
    
    SaveDialog.CancelBtn.MouseButton1Click:Connect(function()
        SaveDialog.ScreenGui:Destroy()
        GUI.StatusLabel.Text = "Status: Recording discarded"
    end)
    
    SaveDialog.SaveConfirmBtn.MouseButton1Click:Connect(function()
        local fileName = SaveDialog.InputBox.Text
        if fileName == "" then
            fileName = "Walk_" .. os.time()
        end
        
        local data = {
            PathData = State.PathData,
            DisplayName = fileName,
            Duration = FormatDuration(State.RecordDuration),
            JumpCount = jumpCount,
            SpeedMultiplier = 1.0
        }
        
        local success, result = SaveToFile(fileName, data)
        if success then
            SaveDialog.ScreenGui:Destroy()
            GUI.StatusLabel.Text = "Status: Saved as '" .. result .. "'"
            RefreshFileList(GUI)
        else
            SaveDialog.InputBox.Text = "Error saving!"
            SaveDialog.InputBox.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end

local function PauseRecording(GUI)
    if not State.IsRecording then return end
    
    State.IsPaused = not State.IsPaused
    
