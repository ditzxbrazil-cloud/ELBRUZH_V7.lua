-- === UTILITY FUNCTIONS ===
local function shhhhnayy05_generateId()
    return tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
end

local function shhhhnayy05_formatTime()
    return os.date("%H:%M:%S")
end

local function shhhhnayy05_saveToDisk(allSaves)
    local success = pcall(function()
        writefile(CONFIG.SaveFileName, HttpService:JSONEncode(allSaves))
    end)
    return success
end

local function shhhhnayy05_loadFromDisk()
    local success, result = pcall(function()
        if isfile(CONFIG.SaveFileName) then
            return HttpService:JSONDecode(readfile(CONFIG.SaveFileName))
        end
        return {}
    end)
    if success then return result end
    return {}
end

