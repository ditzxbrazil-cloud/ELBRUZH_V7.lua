--// ============================================

local function StartRecording(GUI)
    if State.IsRecording then return end
    
    State.IsRecording = true
    State.IsPaused = false
    State.PathData = {}
    State.CurrentIndex = 1
    State.RecordStartTime = tick()
    
    -- Create timer overlay
    if State.TimerOverlay then
        pcall(function() State.TimerOverlay.ScreenGui:Destroy() end)
    end
    State.TimerOverlay = CreateTimerOverlay()
    
    -- Disable collisions during recording
    pcall(function()
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                State.OriginalCollisions[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end)
    
    GUI.RecordBtn.Text = "⏹ Stop"
    GUI.RecordBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    GUI.StatusLabel.Text = "Status: Recording..."
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    State.RecordConnection = RunService.Heartbeat:Connect(function()
        if not State.IsRecording or State.IsPaused then return end
        
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local currentTime = tick() - State.RecordStartTime
        
        -- Record position, rotation, and jump state
        local frameData = {
            Position = hrp.Position,
            Rotation = hrp.CFrame.LookVector,
            Time = currentTime,
            Jump = Humanoid.Jump
        }
        
        table.insert(State.PathData, frameData)
        
        -- Update timer
        local duration = FormatDuration(currentTime)
        GUI.TimerLabel.Text = "⏱ " .. duration
        if State.TimerOverlay then
            State.TimerOverlay.TimerLabel.Text = "⏱ " .. duration
        end
    end)
end

local function StopRecording(GUI)
    if not State.IsRecording then return end
    
    State.IsRecording = false
    State.RecordDuration = tick() - State.RecordStartTime
    
    if State.RecordConnection then
        State.RecordConnection:Disconnect()
        State.RecordConnection = nil
    end
    
    -- Restore collisions
    pcall(function()
        for part, canCollide in pairs(State.OriginalCollisions) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
    end)
    State.OriginalCollisions = {}
    
    -- Remove timer overlay
    if State.TimerOverlay then
        pcall(function() State.TimerOverlay.ScreenGui:Destroy() end)
        State.TimerOverlay = nil
    end
    
    GUI.RecordBtn.Text = "⏺ Record"
    GUI.RecordBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    GUI.StatusLabel.Text = "Status: Recorded " .. #State.PathData .. " frames"
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    -- Auto open save dialog
    local jumpCount = CountJumps(State.PathData)
    local duration = FormatDuration(State.RecordDuration)
    
    local SaveDialog = CreateSaveDialog(duration, jumpCount)
    
    SaveDialog.CancelBtn.MouseButton1Click:Connect(function()
        SaveDialog.ScreenGui:Destroy()
        GUI.StatusLabel.Text = "Status: Recording discarded"
    end)
    
    SaveDialog.SaveConfirmBtn.MouseButton1Click:Connect(function()
        local fileName = SaveDialog.InputBox.Text:gsub("[^%w%s_-]", ""):sub(1, 50)
        if fileName == "" then
            fileName = "Walk_" .. os.time()
        end
        
        local data = {
            PathData = State.PathData,
            DisplayName = SaveDialog.InputBox.Text,
            Duration = duration,
            JumpCount = jumpCount,
            SpeedMultiplier = 1.0,
            RecordDate = os.date("%Y-%m-%d %H:%M:%S"),
            WalkSpeed = GetWalkSpeed()
        }
        
        local success, err = SaveToFile(fileName, data)
        if success then
            SaveDialog.ScreenGui:Destroy()
            GUI.StatusLabel.Text = "Status: Saved '" .. fileName .. "'"
            GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            RefreshFileList(GUI)
        else
            SaveDialog.InputBox.Text = "Error saving!"
            SaveDialog.InputBox.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end

local function PauseRecording(GUI)
    if not State.IsRecording then return end
    
    State.IsPaused = not State.IsPaused
    
    if State.IsPaused then
        GUI.PauseBtn.Text = "▶ Resume"
        GUI.PauseBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 100)
        GUI.StatusLabel.Text = "Status: Paused"
        if State.TimerOverlay then
            State.TimerOverlay.StatusLabel.Text = "Paused"
        end
    else
        GUI.PauseBtn.Text = "⏸ Pause"
        GUI.PauseBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        GUI.StatusLabel.Text = "Status: Recording..."
        if State.TimerOverlay then
            State.TimerOverlay.StatusLabel.Text = "Recording..."
        end
    end
end

--// ============================================
--// PLAYBACK FUNCTIONS - SYNCED WITH ANIMATION
--// ============================================

local function PlayWalk(fileData, speedMultiplier, GUI)
    if State.IsPlaying then
        GUI.StatusLabel.Text = "Status: Already playing!"
        return
    end
    
    local pathData = fileData.PathData or fileData.Path or {}
    if #pathData == 0 then
        GUI.StatusLabel.Text = "Status: No data to play!"
        return
    end
    
    State.IsPlaying = true
    State.CurrentIndex = 1
    State.CurrentSpeedMultiplier = speedMultiplier or 1.0
    
    -- Get original walk speed and animation
    local originalWalkSpeed = Humanoid.WalkSpeed
    local originalAnimSpeed = 1.0
    
    -- Calculate target speed based on multiplier
    local targetSpeed = (fileData.WalkSpeed or 16) * speedMultiplier
    
    -- Set humanoid speed
    Humanoid.WalkSpeed = targetSpeed
    
    -- Animation speed sync - adjust animation speed to match walk speed
    local animSpeed = speedMultiplier
    if animSpeed > 3 then animSpeed = 3 end -- Cap animation speed
    
    GUI.StatusLabel.Text = "Status: Playing " .. #pathData .. " frames at " .. speedMultiplier .. "x"
    GUI.StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    
    -- Disable collisions during playback
    pcall(function()
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                State.OriginalCollisions[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end)
    
    local startTime = tick()
    local totalFrames = #pathData
    
    State.PlayConnection = RunService.Heartbeat:Connect(function()
        if not State.IsPlaying then return end
        
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            State.IsPlaying = false
            return
        end
        
        -- Calculate current frame based on time and speed
        local elapsed = (tick() - startTime) * speedMultiplier
        local frameIndex = math.floor(elapsed / CONFIG.RecordInterval) + 1
        
        if frameIndex > totalFrames then
            -- End of playback
            if State.LoopPlayback then
                startTime = tick()
                frameIndex = 1
            else
                -- Stop playback
                State.IsPlaying = false
                if State.PlayConnection then
                    State.PlayConnection:Disconnect()
                    State.PlayConnection = nil
                end
                
                -- Restore original state
                Humanoid.WalkSpeed = originalWalkSpeed
                pcall(function()
                    for part, canCollide in pairs(State.OriginalCollisions) do
                        if part and part.Parent then
                            part.CanCollide = canCollide
                        end
                    end
                end)
                State.OriginalCollisions = {}
                
                GUI.StatusLabel.Text = "Status: Playback finished"
                GUI.StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                return
            end
        end
        
        State.CurrentIndex = math.min(frameIndex, totalFrames)
        local frame = pathData[State.CurrentIndex]
        
        -- Smooth movement with interpolation
        local nextFrame = pathData[State.CurrentIndex + 1]
        if nextFrame then
            local alpha = (elapsed % CONFIG.RecordInterval) / CONFIG.RecordInterval
            hrp.CFrame = CFrame.new(
                frame.Position:Lerp(nextFrame.Position, alpha),
                frame.Position:Lerp(nextFrame.Position, alpha) + frame.Rotation:Lerp(nextFrame.Rotation, alpha)
            )
        else
            hrp.CFrame = CFrame.new(frame.Position, frame.Position + frame.Rotation)
        end
        
        -- Handle jumps
        if frame.Jump and not Humanoid.Jump then
            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        
        -- Sync animation speed
        if Humanoid then
            -- Adjust animation speed to match movement speed
            local currentAnimSpeed = Humanoid.WalkSpeed / 16
            if currentAnimSpeed ~= animSpeed then
                -- This ensures animation matches the speed
                for _, track in pairs(Humanoid:GetPlayingAnimationTracks()) do
                    if track:IsA("AnimationTrack") then
                        track:AdjustSpeed(animSpeed)
                    end
                end
            end
        end
    end)
end

local function StopPlayback()
    State.IsPlaying = false
    if State.PlayConnection then
        State.PlayConnection:Disconnect()
        State.PlayConnection = nil
    end
    
    -- Restore collisions
    pcall(function()
        for part, canCollide in pairs(State.OriginalCollisions) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
    end)
    State.OriginalCollisions = {}
    
    -- Reset animation speed
    if Humanoid then
        for _, track in pairs(Humanoid:GetPlayingAnimationTracks()) do
            if track:IsA("AnimationTrack") then
                track:AdjustSpeed(1)
            end
        end
    end
end

