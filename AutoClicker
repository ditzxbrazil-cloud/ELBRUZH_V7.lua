local function shhhhnayy05_CreateClickEffect(position)
    if not shhhhnayy05.VisualFeedback then return end
    
    local effect = shhhhnayy05_Create("Part", {
        Name = "shhhhnayy05_ClickEffect",
        Shape = Enum.PartType.Ball,
        Size = Vector3.new(0.5, 0.5, 0.5),
        Position = position,
        Color = Color3.fromRGB(0, 255, 136),
        Material = Enum.Material.Neon,
        Transparency = 0.3,
        CanCollide = false,
        Anchored = true,
        Parent = shhhhnayy05_Folder
    })
    
    shhhhnayy05_Tween(effect, {
        Size = Vector3.new(2, 2, 2),
        Transparency = 1
    }, 0.3)
    
    game:GetService("Debris"):AddItem(effect, 0.3)
end

local function shhhhnayy05_UpdateTargetLine()
    if not shhhhnayy05.ShowTargetLine or not shhhhnayy05.Clicking then
        for _, child in ipairs(shhhhnayy05_Folder:GetChildren()) do
            if child.Name == "shhhhnayy05_TargetLine" then
                child:Destroy()
            end
        end
        return
    end
    
    local targetPos = nil
    
    if shhhhnayy05.TargetMode == "Mouse" then
        local mouseRay = Mouse.UnitRay
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        
        local result = Workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000, raycastParams)
        if result then
            targetPos = result.Position
        end
    elseif shhhhnayy05.TargetMode == "Player" and shhhhnayy05.SelectedPlayer then
        local char = shhhhnayy05.SelectedPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            targetPos = char.HumanoidRootPart.Position
        end
    elseif shhhhnayy05.TargetMode == "Part" and shhhhnayy05.SelectedPart then
        targetPos = shhhhnayy05.SelectedPart.Position
    elseif shhhhnayy05.TargetMode == "Position" and shhhhnayy05.TargetPosition then
        targetPos = shhhhnayy05.TargetPosition
    end
    
    if targetPos then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local existingLine = shhhhnayy05_Folder:FindFirstChild("shhhhnayy05_TargetLine")
            if existingLine then
                existingLine:Destroy()
            end
            
            local distance = (targetPos - hrp.Position).Magnitude
            local midPoint = (hrp.Position + targetPos) / 2
            local line = shhhhnayy05_Create("Part", {
                Name = "shhhhnayy05_TargetLine",
                Size = Vector3.new(0.1, 0.1, distance),
                CFrame = CFrame.lookAt(midPoint, targetPos),
                Color = Color3.fromRGB(255, 50, 50),
                Material = Enum.Material.Neon,
                Transparency = 0.5,
                CanCollide = false,
                Anchored = true,
                Parent = shhhhnayy05_Folder
            })
        end
    end
end

-- ═══════════════════════════════════════════════════
-- CLICK LOGIC
-- ═══════════════════════════════════════════════════

local function shhhhnayy05_PerformClick()
    if not shhhhnayy05.Clicking then return end
    
    local targetPos = nil
    local targetInstance = nil
    
    if shhhhnayy05.TargetMode == "Mouse" then
        local mouseRay = Mouse.UnitRay
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        
        local result = Workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000, raycastParams)
        if result then
            targetPos = result.Position
            targetInstance = result.Instance
        end
    elseif shhhhnayy05.TargetMode == "Player" and shhhhnayy05.SelectedPlayer then
        local char = shhhhnayy05.SelectedPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            targetPos = char.HumanoidRootPart.Position
            targetInstance = char.HumanoidRootPart
        end
    elseif shhhhnayy05.TargetMode == "Part" and shhhhnayy05.SelectedPart then
        targetPos = shhhhnayy05.SelectedPart.Position
        targetInstance = shhhhnayy05.SelectedPart
    elseif shhhhnayy05.TargetMode == "Position" and shhhhnayy05.TargetPosition then
        targetPos = shhhhnayy05.TargetPosition
    end
    
    if targetPos then
        for i = 1, shhhhnayy05.MultiClick do
            -- Simulate click based on type
            if shhhhnayy05.ClickType == "Left" then
                if targetInstance then
                    -- Fire click detectors
                    for _, v in ipairs(targetInstance:GetDescendants()) do
                        if v:IsA("ClickDetector") then
                            fireclickdetector(v)
                        end
                    end
                    -- Fire proximity prompts
                    for _, v in ipairs(targetInstance:GetDescendants()) do
                        if v:IsA("ProximityPrompt") then
                            fireproximityprompt(v)
                        end
                    end
                end
                
                -- Virtual input for UI
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true, game, 0)
                task.wait(0.01)
                vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 0)
                
            elseif shhhhnayy05.ClickType == "Right" then
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 1, true, game, 0)
                task.wait(0.01)
                vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 1, false, game, 0)
                
            elseif shhhhnayy05.ClickType == "Middle" then
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 2, true, game, 0)
                task.wait(0.01)
                vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 2, false, game, 0)
            end
            
            shhhhnayy05.Stats.TotalClicks = shhhhnayy05.Stats.TotalClicks + 1
            shhhhnayy05.Stats.SessionClicks = shhhhnayy05.Stats.SessionClicks + 1
            
            if shhhhnayy05.SoundEffect then
                shhhhnayy05_Sound:Play()
            end
            
            shhhhnayy05_CreateClickEffect(targetPos)
        end
    end
end

-- ═══════════════════════════════════════════════════
-- MAIN CLICK LOOP
-- ═══════════════════════════════════════════════════

local shhhhnayy05_ClickConnection = nil

local function shhhhnayy05_StartClicking()
    if shhhhnayy05.Clicking then return end
    
    shhhhnayy05.Clicking = true
    shhhhnayy05.Stats.SessionClicks = 0
    shhhhnayy05.Stats.StartTime = tick()
    
    shhhhnayy05_ClickConnection = task.spawn(function()
        while shhhhnayy05.Clicking do
            if shhhhnayy05.BreakOnDeath then
                local char = LocalPlayer.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health <= 0 then
                    shhhhnayy05.StopClicking()
                    break
                end
            end
            
            shhhhnayy05_PerformClick()
            shhhhnayy05_UpdateTargetLine()
            
            local delayTime = 1 / shhhhnayy05.CPS
            if shhhhnayy05.RandomDelay then
                delayTime = math.random(shhhhnayy05.MinDelay * 100, shhhhnayy05.MaxDelay * 100) / 100
            end
            
            task.wait(delayTime)
        end
    end)
end

function shhhhnayy05.StopClicking()
    shhhhnayy05.Clicking = false
    if shhhhnayy05_ClickConnection then
        shhhhnayy05_ClickConnection = nil
    end
    
    for _, child in ipairs(shhhhnayy05_Folder:GetChildren()) do
        if child.Name == "shhhhnayy05_TargetLine" then
            child:Destroy()
        end
    end
end

