local function shhhhnayy05_UpdateStatus()
    if shhhhnayy05.Clicking then
        shhhhnayy05_StatusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        shhhhnayy05_StatusText.Text = "ON"
        shhhhnayy05_StatusText.TextColor3 = Color3.fromRGB(0, 255, 100)
        shhhhnayy05_ToggleBtn.Text = "⏸ PAUSE"
        shhhhnayy05_ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
    else
        shhhhnayy05_StatusDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        shhhhnayy05_StatusText.Text = "OFF"
        shhhhnayy05_StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        shhhhnayy05_ToggleBtn.Text = "▶ START"
        shhhhnayy05_ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end
end

local function shhhhnayy05_UpdateStats()
    shhhhnayy05_TotalClicksLabel.Text = "Total: " .. shhhhnayy05.Stats.TotalClicks
    shhhhnayy05_SessionClicksLabel.Text = "Session: " .. shhhhnayy05.Stats.SessionClicks
    
    if shhhhnayy05.Clicking and shhhhnayy05.Stats.StartTime > 0 then
        local elapsed = tick() - shhhhnayy05.Stats.StartTime
        local realCPS = elapsed > 0 and shhhhnayy05_Round(shhhhnayy05.Stats.SessionClicks / elapsed, 1) or 0
        shhhhnayy05_CPSRealLabel.Text = "Real CPS: " .. realCPS
        shhhhnayy05_TimeLabel.Text = "Time: " .. shhhhnayy05_FormatTime(elapsed)
    else
        shhhhnayy05_CPSRealLabel.Text = "Real CPS: 0"
    end
end

local function shhhhnayy05_UpdateTargetDisplay()
    if shhhhnayy05.TargetMode == "Mouse" then
        shhhhnayy05_TargetDisplay.Text = "Current: Mouse Position"
        shhhhnayy05_SelectPlayerBtn.Visible = false
        shhhhnayy05_SelectPartBtn.Visible = false
    elseif shhhhnayy05.TargetMode == "Player" then
        local name = shhhhnayy05.SelectedPlayer and shhhhnayy05.SelectedPlayer.Name or "None"
        shhhhnayy05_TargetDisplay.Text = "Current: " .. name
        shhhhnayy05_SelectPlayerBtn.Visible = true
        shhhhnayy05_SelectPartBtn.Visible = false
    elseif shhhhnayy05.TargetMode == "Part" then
        local name = shhhhnayy05.SelectedPart and shhhhnayy05.SelectedPart.Name or "None"
        shhhhnayy05_TargetDisplay.Text = "Current: " .. name
        shhhhnayy05_SelectPlayerBtn.Visible = false
        shhhhnayy05_SelectPartBtn.Visible = true
    elseif shhhhnayy05.TargetMode == "Position" then
        local pos = shhhhnayy05.TargetPosition and tostring(shhhhnayy05_Round(shhhhnayy05.TargetPosition.X)) .. "," .. tostring(shhhhnayy05_Round(shhhhnayy05.TargetPosition.Y)) .. "," .. tostring(shhhhnayy05_Round(shhhhnayy05.TargetPosition.Z)) or "None"
        shhhhnayy05_TargetDisplay.Text = "Current: " .. pos
        shhhhnayy05_SelectPlayerBtn.Visible = false
        shhhhnayy05_SelectPartBtn.Visible = false
    end
end

local function shhhhnayy05_RefreshPlayerList()
    for _, child in ipairs(shhhhnayy05_PWScroll:GetChildren()) do
        if child:IsA("TextButton") then
