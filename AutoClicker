local function shhhhnayy05_Create(instanceType, properties)
    local instance = Instance.new(instanceType)
    for prop, value in pairs(properties) do
        instance[prop] = value
    end
    return instance
end

local function shhhhnayy05_Tween(object, properties, duration, easingStyle, easingDirection)
    local tween = TweenService:Create(object, TweenInfo.new(duration or 0.3, easingStyle or Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

local function shhhhnayy05_Round(num, decimals)
    decimals = decimals or 2
    local mult = 10 ^ decimals
    return math.floor(num * mult + 0.5) / mult
end

local function shhhhnayy05_FormatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

local function shhhhnayy05_GetDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function shhhhnayy05_GetPlayerList()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, player)
        end
    end
    return list
end

local function shhhhnayy05_GetPartList()
    local list = {}
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "shhhhnayy05_TargetLine" and part.Name ~= "shhhhnayy05_ClickEffect" then
            table.insert(list, part)
        end
    end
    return list
end

local function shhhhnayy05_WorldToScreen(position)
    local camera = Workspace.CurrentCamera
    local screenPos, onScreen = camera:WorldToViewportPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

