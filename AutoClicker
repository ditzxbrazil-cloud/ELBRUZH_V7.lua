-- Toggles
local function shhhhnayy05_ToggleButton(btn, value, onText, offText, onColor, offColor)
    value = not value
    if value then
        btn.Text = onText
        btn.BackgroundColor3 = onColor
    else
        btn.Text = offText
        btn.BackgroundColor3 = offColor
    end
    return value
end

