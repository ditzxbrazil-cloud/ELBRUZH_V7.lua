    Instance.new("UICorner", plsBtn).CornerRadius = UDim.new(0, 4)
    
    local function update(newVal)
        newVal = math.clamp(tonumber(newVal) or 1, 1, maxVal)
        BrushSettings[cfgKey] = newVal
        valInput.Text = tostring(newVal)
    end
    minBtn.MouseButton1Click:Connect(function() update(BrushSettings[cfgKey] - 1) end)
    plsBtn.MouseButton1Click:Connect(function() update(BrushSettings[cfgKey] + 1) end)
    valInput.FocusLost:Connect(function() update(valInput.Text) end)
end

