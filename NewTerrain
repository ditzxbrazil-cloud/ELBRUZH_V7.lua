local function handleSizeInput(box, type)
    local val = tonumber(box.Text)
    if val then
        local clamped = math.clamp(math.floor(val), 1, 500)
        if type == "X" then SizeX = clamped; box.Text = tostring(SizeX) elseif type == "Y" then SizeY = clamped; box.Text = tostring(SizeY) elseif type == "Z" then SizeZ = clamped; box.Text = tostring(SizeZ) end
        UpdatePreview()
    end
end

