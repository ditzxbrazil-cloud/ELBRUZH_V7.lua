            local changed = false
            for x = 1, mats.Size.X do
                for y = 1, mats.Size.Y do
                    for z = 1, mats.Size.Z do
                        if mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= mat then
                            mats[x][y][z] = mat
                            changed = true
                        end
                    end
                end
            end
            if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
            
        else
            -- Ball paint
            local region = Region3.new(pos - sizeVec, pos + sizeVec):ExpandToGrid(4)
            local mats, occs = Terrain:ReadVoxels(region, 4)
            local radius = math.max(sx, sy, sz) / 2
            local changed = false
            for x = 1, mats.Size.X do
                for y = 1, mats.Size.Y do
                    for z = 1, mats.Size.Z do
                        local voxelPos = region.CFrame * CFrame.new(
                            (x - 1) * 4 - (mats.Size.X - 1) * 2,
                            (y - 1) * 4 - (mats.Size.Y - 1) * 2,
                            (z - 1) * 4 - (mats.Size.Z - 1) * 2
                        )
                        local dist = (voxelPos.Position - pos).Magnitude
                        if dist <= radius and mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= mat then
                            mats[x][y][z] = mat
                            changed = true
                        end
                    end
                end
            end
            if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
        end
        
    else
        -- NORMAL ADD - PAKAI SHAPE YANG DIPILIH
        if shape == "Block" then
            Terrain:FillBlock(cf, sizeVec, mat)
        elseif shape == "Wedge" then
            Terrain:FillWedge(cf, sizeVec, mat)
        else
            Terrain:FillBall(pos, math.max(sx, sy, sz)/2, mat)
        end
        
        if smoothOn then
            ApplySmoothTerrain(pos, sizeVec, mat, smoothInt, smoothMode)
        end
    end
    
    return d
end

--// Spawn Terrain
local function SpawnTerrain()
    if not PreviewPos then return false end
    
    local maxDim = math.max(SizeX, SizeY, SizeZ)
    local padding = SmoothEnabled and (SmoothIntensity * 8) or 6
    local halfBounds = Vector3.new(maxDim/2 + padding, maxDim/2 + padding, maxDim/2 + padding)
    local region = Region3.new(PreviewPos - halfBounds, PreviewPos + halfBounds):ExpandToGrid(4)

    local beforeMats, beforeOccs = Terrain:ReadVoxels(region, 4)

    local data = {
        PreviewPos.X, PreviewPos.Y, PreviewPos.Z, 
        SizeX, SizeY, SizeZ, CurrentMaterial.Name, CurrentShape,
        currentGrassColorIndex, currentLeafyGrassColorIndex, currentGroundColorIndex,     
        RotX, RotY, RotZ, SmoothEnabled, SmoothModes[CurrentSmoothModeIndex], SmoothIntensity,
        CurrentActionMode, currentRockColorIndex
    }
    
    BL(data)

    local afterMats, afterOccs = Terrain:ReadVoxels(region, 4)

    table.insert(UndoHistory, {
        Region = region,
        BeforeMats = beforeMats,
        BeforeOccs = beforeOccs,
        AfterMats = afterMats,
        AfterOccs = afterOccs,
        Data = data
    })
    
    RedoHistory = {}
    table.insert(SpawnedData, data)
    return true
end

--// UNDO / REDO
local function Undo()
    if #UndoHistory == 0 then return false, "Nothing to undo" end
    local lastNode = table.remove(UndoHistory)
    table.insert(RedoHistory, lastNode)
    
    for i = #SpawnedData, 1, -1 do
        if SpawnedData[i] == lastNode.Data then
            table.remove(SpawnedData, i)
            break
        end
    end
    
    Terrain:WriteVoxels(lastNode.Region, 4, lastNode.BeforeMats, lastNode.BeforeOccs)
    
    return true, "Undone 1 terrain"
end

local function Redo()
    if #RedoHistory == 0 then return false, "Nothing to redo" end
    local node = table.remove(RedoHistory)
    table.insert(UndoHistory, node)
    table.insert(SpawnedData, node.Data)
    
    Terrain:WriteVoxels(node.Region, 4, node.AfterMats, node.AfterOccs)
    
    return true, "Redone 1 terrain"
end

