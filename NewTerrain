end)
UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and mouseDrawing then
        mouseDrawing = false
        BrushSettings.FlattenLevel = nil
        if #ActiveStrokePositions > 0 then
            table.insert(UndoHistory, {
                IsBrushStroke = true,
                Positions = ActiveStrokePositions,
                Sizes = ActiveStrokeSizes
            })
            RedoHistory = {}
        end
    end
end)


--// Raycast Original
local function GetRaycast()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    
    local filterList = {}
    if PreviewPart then table.insert(filterList, PreviewPart) end
    if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
    if IgnoreTerrain and Terrain then table.insert(filterList, Terrain) end
    
    params.FilterDescendantsInstances = filterList
    return Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
end

--// Create Preview
local function CreatePreview()
    if PreviewPart then PreviewPart:Destroy() end
    PreviewPart = Instance.new("Part")
    
    if CurrentShape == "Ball" then
        PreviewPart.Shape = Enum.PartType.Ball
    elseif CurrentShape == "Wedge" then
        PreviewPart.Shape = Enum.PartType.Wedge
    else
        PreviewPart.Shape = Enum.PartType.Block
    end
    
    PreviewPart.Material = Enum.Material.ForceField
    PreviewPart.Color = Color3.fromRGB(255, 255, 255)
    PreviewPart.Transparency = 0.7
    PreviewPart.CanCollide = false
    PreviewPart.Anchored = true
    PreviewPart.CastShadow = false
    PreviewPart.Parent = Workspace
    
    local selectionBox = Instance.new("SelectionBox")
    selectionBox.Name = "EdgeOutline"
    selectionBox.LineThickness = 0.05
    selectionBox.Color3 = Color3.fromRGB(0, 255, 255)
    selectionBox.SurfaceColor3 = Color3.fromRGB(0, 255, 255)
    selectionBox.SurfaceTransparency = 1
    selectionBox.Adornee = PreviewPart
    selectionBox.Parent = PreviewPart
end

--// SNAP FUNCTION
local function SnapPosition(pos)
    if not SnapEnabled then return pos end
    local snappedX, snappedY, snappedZ = pos.X, pos.Y, pos.Z
    
    if SnapAxis.X then snappedX = math.floor(pos.X / GridSize + 0.5) * GridSize end
    if SnapAxis.Y then snappedY = math.floor(pos.Y / GridSize + 0.5) * GridSize end
    if SnapAxis.Z then snappedZ = math.floor(pos.Z / GridSize + 0.5) * GridSize end
    
    return Vector3.new(snappedX, snappedY, snappedZ)
end

--// VISUAL GRID FUNCTION
local function UpdateGridVisual()
    for _, line in ipairs(GridLines) do line:Destroy() end
    GridLines = {}
    if not ShowGridVisual then return end
    
    local playerPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position
    if not playerPos then return end
    
    local range = 100 
    local startX = math.floor((playerPos.X - range) / GridSize) * GridSize
    local endX = math.floor((playerPos.X + range) / GridSize) * GridSize
    local startZ = math.floor((playerPos.Z - range) / GridSize) * GridSize
    local endZ = math.floor((playerPos.Z + range) / GridSize) * GridSize
    
    for z = startZ, endZ, GridSize do
        local line = Instance.new("Part")
        line.Size = Vector3.new(range * 2, 0.1, 0.1)
        line.CFrame = CFrame.new(playerPos.X, playerPos.Y - 1, z)
        line.Anchored = true; line.CanCollide = false; line.Transparency = 0.8; line.Color = Color3.fromRGB(255, 255, 0); line.Material = Enum.Material.Neon;
        line.Parent = Workspace
        table.insert(GridLines, line)
    end
    for x = startX, endX, GridSize do
        local line = Instance.new("Part")
        line.Size = Vector3.new(0.1, 0.1, range * 2)
        line.CFrame = CFrame.new(x, playerPos.Y - 1, playerPos.Z)
        line.Anchored = true; line.CanCollide = false; line.Transparency = 0.8; line.Color = Color3.fromRGB(255, 255, 0); line.Material = Enum.Material.Neon;
        line.Parent = Workspace
        table.insert(GridLines, line)
    end
end

spawn(function() while wait(2) do if ShowGridVisual then UpdateGridVisual() end end end)

--// Update Preview
local function UpdatePreview()
    if BrushSettings.Enabled then 
        if PreviewPart then PreviewPart.Transparency = 1; PreviewPart.EdgeOutline.Transparency = 1 end
        return 
    end

    if not PreviewPart then CreatePreview() end
    
    -- SYSTEM MOVE & LOCK
    if not MoveModeEnabled then
        local result = GetRaycast()
        if result then
            local rawPos = result.Position
            LockedPosition = SnapEnabled and SnapPosition(rawPos) or rawPos
            PreviewPos = LockedPosition
        else
            PreviewPos = nil
        end
    else
        if LockedPosition then
            PreviewPos = LockedPosition + MoveOffset
        else
            PreviewPos = nil
        end
    end
    
    if PreviewPos then
        PreviewPart.Size = Vector3.new(SizeX, SizeY, SizeZ)
        
        if CurrentActionMode == "Flatten" then
            local cf = CFrame.new(PreviewPos) * CFrame.Angles(0, math.rad(RotY), 0) 
            PreviewPart.CFrame = cf * CFrame.new(0, SizeY/2, 0)
        elseif CurrentActionMode == "Paint" then
            local cf = CFrame.new(PreviewPos) * CFrame.Angles(0, math.rad(RotY), 0)
            PreviewPart.CFrame = cf
            PreviewPart.Size = Vector3.new(SizeX, 1, SizeZ) -- Paint preview is flat
        else
            local cf = CFrame.new(PreviewPos) * CFrame.Angles(math.rad(RotX), math.rad(RotY), math.rad(RotZ))
            PreviewPart.CFrame = cf
        end
        PreviewPart.Transparency = 0.65
        PreviewPart.EdgeOutline.Transparency = 0
        
        if SnapEnabled then
            PreviewPart.Color = Color3.fromRGB(100, 255, 150)
            PreviewPart.EdgeOutline.Color3 = Color3.fromRGB(100, 255, 150)
        elseif MoveModeEnabled then
            PreviewPart.Color = Color3.fromRGB(255, 100, 255)
            PreviewPart.EdgeOutline.Color3 = Color3.fromRGB(255, 100, 255)
        elseif CurrentActionMode == "Erase" then
            PreviewPart.Color = Color3.fromRGB(255, 50, 50)
            PreviewPart.EdgeOutline.Color3 = Color3.fromRGB(255, 50, 50)
        else
            PreviewPart.Color = Color3.fromRGB(255, 255, 255)
            PreviewPart.EdgeOutline.Color3 = Color3.fromRGB(0, 255, 255)
        end
    else
        PreviewPart.Transparency = 1
        PreviewPart.EdgeOutline.Transparency = 1
    end
end

