ySetBtn.MouseButton1Click:Connect(function() handleSizeInput(yValue, "Y") end)
zSetBtn.MouseButton1Click:Connect(function() handleSizeInput(zValue, "Z") end)

-- ALL button (set semua sekaligus)
allSetBtn.MouseButton1Click:Connect(function()
    local val = tonumber(xValue.Text)
    if val then
        local clamped = math.clamp(math.floor(val), 1, 500)
        SizeX, SizeY, SizeZ = clamped, clamped, clamped
        xValue.Text = tostring(SizeX)
        yValue.Text = tostring(SizeY)
        zValue.Text = tostring(SizeZ)
        UpdatePreview()
    end
end)

-- Plus/Minus per axis
xMinus.MouseButton1Click:Connect(function() SizeX = math.max(1, SizeX - 1); xValue.Text = tostring(SizeX); UpdatePreview() end)
xPlus.MouseButton1Click:Connect(function() SizeX = math.min(500, SizeX + 1); xValue.Text = tostring(SizeX); UpdatePreview() end)
yMinus.MouseButton1Click:Connect(function() SizeY = math.max(1, SizeY - 1); yValue.Text = tostring(SizeY); UpdatePreview() end)
yPlus.MouseButton1Click:Connect(function() SizeY = math.min(500, SizeY + 1); yValue.Text = tostring(SizeY); UpdatePreview() end)
zMinus.MouseButton1Click:Connect(function() SizeZ = math.max(1, SizeZ - 1); zValue.Text = tostring(SizeZ); UpdatePreview() end)
zPlus.MouseButton1Click:Connect(function() SizeZ = math.min(500, SizeZ + 1); zValue.Text = tostring(SizeZ); UpdatePreview() end)

-- FocusLost juga works
xValue.FocusLost:Connect(function() handleSizeInput(xValue, "X") end)
yValue.FocusLost:Connect(function() handleSizeInput(yValue, "Y") end)
zValue.FocusLost:Connect(function() handleSizeInput(zValue, "Z") end)

-- Rotation
rxMinus.MouseButton1Click:Connect(function() RotX = (RotX - 15) % 360; rxValue.Text = tostring(RotX) .. "°"; UpdatePreview() end); rxPlus.MouseButton1Click:Connect(function() RotX = (RotX + 15) % 360; rxValue.Text = tostring(RotX) .. "°"; UpdatePreview() end)
ryMinus.MouseButton1Click:Connect(function() RotY = (RotY - 15) % 360; ryValue.Text = tostring(RotY) .. "°"; UpdatePreview() end); ryPlus.MouseButton1Click:Connect(function() RotY = (RotY + 15) % 360; ryValue.Text = tostring(RotY) .. "°"; UpdatePreview() end)
rzMinus.MouseButton1Click:Connect(function() RotZ = (RotZ - 15) % 360; rzValue.Text = tostring(RotZ) .. "°"; UpdatePreview() end); rzPlus.MouseButton1Click:Connect(function() RotZ = (RotZ + 15) % 360; rzValue.Text = tostring(RotZ) .. "°"; UpdatePreview() end)
rotResetBtn.MouseButton1Click:Connect(function() RotX, RotY, RotZ = 0, 0, 0; rxValue.Text, ryValue.Text, rzValue.Text = "0°", "0°", "0°"; UpdatePreview() end)

-- Undo/Redo
undoBtn.MouseButton1Click:Connect(function() local success, msg = Undo(); status.Text = success and ("↩️ " .. msg .. " (" .. #SpawnedData .. ")") or ("↩️ " .. msg); status.TextColor3 = success and Color3.fromRGB(255, 200, 100) or Color3.fromRGB(255, 100, 100) end)
redoBtn.MouseButton1Click:Connect(function() local success, msg = Redo(); status.Text = success and ("↪️ " .. msg .. " (" .. #SpawnedData .. ")") or ("↪️ " .. msg); status.TextColor3 = success and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(255, 100, 100) end)

-- Window Controls
minBtn.MouseButton1Click:Connect(function() panel.Visible = false; minIcon.Visible = true end)
minIcon.MouseButton1Click:Connect(function() minIcon.Visible = false; panel.Visible = true end)
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)
scriptBtn.MouseButton1Click:Connect(function() codeText.Text = GenerateScript(); scriptWin.Visible = true end)
closeScriptBtn.MouseButton1Click:Connect(function() scriptWin.Visible = false end)
copyBtn.MouseButton1Click:Connect(function() if setclipboard then setclipboard(codeText.Text); copyBtn.Text = "Copied!"; delay(1.5, function() copyBtn.Text = "Copy" end) end end)

matIcon.MouseButton1Click:Connect(function() matWin.Visible = not matWin.Visible end)
matCloseBtn.MouseButton1Click:Connect(function() matWin.Visible = false end)

clearBtn.MouseButton1Click:Connect(function()
    while #UndoHistory > 0 do Undo() end
    SpawnedData, UndoHistory, RedoHistory = {}, {}, {}
    status.Text = "🗑️ Session cleared!"
    status.TextColor3 = Color3.fromRGB(255, 100, 100)
end)

spawnBtn.MouseButton1Click:Connect(function()
    if PreviewPos then
        TweenService:Create(spawnBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 45, 0, 45)}):Play()
        wait(0.1)
        TweenService:Create(spawnBtn, TweenInfo.new(0.2), {Size = UDim2.new(0, 50, 0, 50)}):Play()
        
        if SpawnTerrain() then
            status.Text = "✅ Spawned! (" .. #SpawnedData .. " total)"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
        else
            status.Text = "❌ Failed!"
            status.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    else
        status.Text = "❌ Aim at ground!"
        status.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

