--// BRUSH FUNCTIONS & LOGIC
local function ApplyBrushBlock(pos, size)
    -- Multi-layer Rock Logic
    if BrushSettings.RockLayerOn then
        Terrain:FillBlock(CFrame.new(pos - Vector3.new(0, size.Y * 0.3, 0)), Vector3.new(size.X, size.Y * 0.6, size.Z), Enum.Material.Rock)
        Terrain:FillBlock(CFrame.new(pos + Vector3.new(0, size.Y * 0.2, 0)), Vector3.new(size.X, size.Y * 0.5, size.Z), CurrentMaterial.Mat)
    else
        Terrain:FillBlock(CFrame.new(pos), size, CurrentMaterial.Mat)
    end
end

local function applySmoothBrush(hitPos, gridSize, radius, strength)
    local center = Vector3.new(math.floor(hitPos.X/gridSize)*gridSize, math.floor(hitPos.Y/gridSize)*gridSize, math.floor(hitPos.Z/gridSize)*gridSize)
    for x = -radius, radius, gridSize do
        for z = -radius, radius, gridSize do
            local dist = math.sqrt(x*x + z*z)
            if dist > radius then continue end
            
            local falloff = 1 - (dist / radius)
            falloff = falloff * falloff -- quadratic falloff
            
            local heightOffset = strength * falloff * 1.5
            local randomVar = math.random(-1, 1) * 0.5
            local pos = center + Vector3.new(x, heightOffset + randomVar, z)
            local size = Vector3.new(gridSize + 1, math.max(2, strength * falloff * 2 + 2), gridSize + 1)
            
            ApplyBrushBlock(pos, size)
            table.insert(ActiveStrokePositions, pos)
            table.insert(ActiveStrokeSizes, size)
        end
    end
end

local function applyFlattenBrush(hitPos, gridSize, radius)
    if not BrushSettings.FlattenLevel then
        BrushSettings.FlattenLevel = math.floor(hitPos.Y / gridSize) * gridSize
    end
    local flattenY = BrushSettings.FlattenLevel
    local centerX = math.floor(hitPos.X / gridSize) * gridSize
    local centerZ = math.floor(hitPos.Z / gridSize) * gridSize
    
    for x = -radius, radius, gridSize do
        for z = -radius, radius, gridSize do
            local dist = math.sqrt(x*x + z*z)
            if dist > radius then continue end
            
            local pos = Vector3.new(centerX + x, flattenY, centerZ + z)
            local size = Vector3.new(gridSize + 1, 4, gridSize + 1)
            
            -- Hapus area di posisi tersebut dahulu (untuk meratakan)
            Terrain:FillBlock(CFrame.new(pos), size, Enum.Material.Air)
            -- Isi dengan material
            ApplyBrushBlock(pos, size)
            
            table.insert(ActiveStrokePositions, pos)
            table.insert(ActiveStrokeSizes, size)
        end
    end
end

local function applyNoiseBrush(hitPos, gridSize, radius, strength)
    local center = Vector3.new(math.floor(hitPos.X/gridSize)*gridSize, math.floor(hitPos.Y/gridSize)*gridSize, math.floor(hitPos.Z/gridSize)*gridSize)
    for x = -radius, radius, gridSize do
        for z = -radius, radius, gridSize do
            local dist = math.sqrt(x*x + z*z)
            if dist > radius then continue end
            
            local noise1 = math.sin((center.X + x) * 0.3) * math.cos((center.Z + z) * 0.3)
            local noise2 = math.sin((center.X + x) * 0.7 + (center.Z + z) * 0.5) * 0.5
            local heightNoise = (noise1 + noise2) * strength
            
            local pos = center + Vector3.new(x, heightNoise * 1.5, z)
            local size = Vector3.new(gridSize + 1, math.max(3, math.abs(heightNoise) * 1.5 + 3), gridSize + 1)
            
            ApplyBrushBlock(pos, size)
            table.insert(ActiveStrokePositions, pos)
            table.insert(ActiveStrokeSizes, size)
        end
    end
end

local function applySpikeBrush(hitPos, gridSize, radius, strength)
    local center = Vector3.new(math.floor(hitPos.X/gridSize)*gridSize, math.floor(hitPos.Y/gridSize)*gridSize, math.floor(hitPos.Z/gridSize)*gridSize)
    for x = -radius, radius, gridSize do
        for z = -radius, radius, gridSize do
            local dist = math.sqrt(x*x + z*z)
            if dist > radius then continue end
            
            local falloff = 1 - (dist / radius)
            local sharpFalloff = falloff ^ 4 -- Bentuk mengerucut tajam
            local height = strength * sharpFalloff * 3
            
            local pos = center + Vector3.new(x, height, z)
            local size = Vector3.new(gridSize + 1, math.max(2, height * 2 + 2), gridSize + 1)
            
            ApplyBrushBlock(pos, size)
            table.insert(ActiveStrokePositions, pos)
            table.insert(ActiveStrokeSizes, size)
        end
    end
end

local function applyPlateauBrush(hitPos, gridSize, radius, strength)
    local center = Vector3.new(math.floor(hitPos.X/gridSize)*gridSize, math.floor(hitPos.Y/gridSize)*gridSize, math.floor(hitPos.Z/gridSize)*gridSize)
    for x = -radius, radius, gridSize do
        for z = -radius, radius, gridSize do
            local dist = math.sqrt(x*x + z*z)
            if dist > radius then continue end
            
            -- Bentuk Plateau: Datar di 70% radius awal, lalu curam ke bawah
            local platFalloff = 0
            if dist < radius * 0.7 then
                platFalloff = 1
            else
                platFalloff = 1 - ((dist - (radius * 0.7)) / (radius * 0.3))
            end
            
            local height = strength * platFalloff * 2
            local pos = center + Vector3.new(x, height, z)
            local size = Vector3.new(gridSize + 1, math.max(2, height * 1.5 + 2), gridSize + 1)
            
            ApplyBrushBlock(pos, size)
            table.insert(ActiveStrokePositions, pos)
            table.insert(ActiveStrokeSizes, size)
        end
    end
end

local function ExecuteBrush(x, y)
    local ray = Camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local filterList = {}
    if PreviewPart then table.insert(filterList, PreviewPart) end
    if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filterList
    
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if not result then return end
    
    local hitPos = result.Position
    local gridSize = math.clamp(math.floor(BrushSettings.Size / 15), 2, 5) -- Dinamis agar tidak lag
    if gridSize < 2 then gridSize = 2 end
    
    local radius = BrushSettings.Size
    local strength = BrushSettings.Strength
    
    if BrushSettings.Mode == "Smooth" then applySmoothBrush(hitPos, gridSize, radius, strength)
    elseif BrushSettings.Mode == "Flatten" then applyFlattenBrush(hitPos, gridSize, radius)
    elseif BrushSettings.Mode == "Noise" then applyNoiseBrush(hitPos, gridSize, radius, strength)
    elseif BrushSettings.Mode == "Spike" then applySpikeBrush(hitPos, gridSize, radius, strength)
    elseif BrushSettings.Mode == "Plateau" then applyPlateauBrush(hitPos, gridSize, radius, strength)
    end
end

--// BRUSH TOUCH HANDLERS
UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    if gameProcessed or not BrushSettings.Enabled then return end
    
    local guiObjects = LocalPlayer.PlayerGui:GetGuiObjectsAtPosition(touch.Position.X, touch.Position.Y)
    if #guiObjects > 0 then return end
    
    BrushSettings.IsDrawing = true
    BrushSettings.LastTouchPos = touch.Position
    ActiveStrokePositions = {}
    ActiveStrokeSizes = {}
    
    ExecuteBrush(touch.Position.X, touch.Position.Y)
end)

UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
    if gameProcessed or not BrushSettings.Enabled or not BrushSettings.IsDrawing then return end
    
    if BrushSettings.LastTouchPos then
        local dist = (touch.Position - BrushSettings.LastTouchPos).Magnitude
        if dist < 15 then return end -- Mencegah tumpukan spawn berlebihan (lag)
    end
    
    BrushSettings.LastTouchPos = touch.Position
    ExecuteBrush(touch.Position.X, touch.Position.Y)
end)

UserInputService.TouchEnded:Connect(function(touch, gameProcessed)
    if BrushSettings.IsDrawing then
        BrushSettings.IsDrawing = false
        BrushSettings.LastTouchPos = nil
        BrushSettings.FlattenLevel = nil
        
        -- Daftarkan ke sistem Undo ELBRUZH
        if #ActiveStrokePositions > 0 then
            table.insert(UndoHistory, {
                IsBrushStroke = true,
                Positions = ActiveStrokePositions,
                Sizes = ActiveStrokeSizes
            })
            RedoHistory = {}
        end
    end
end)

-- PC Fallback for Brush
local mouseDrawing = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not BrushSettings.Enabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        mouseDrawing = true
        ActiveStrokePositions = {}
