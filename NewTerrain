--// SMOOTH TERRAIN ALGORITHM - 4 BENAR-BENAR BEDA VISUAL
local function ApplySmoothTerrain(centerPos, sizeVec, material, intensity, mode)
    local radius = math.max(sizeVec.X, sizeVec.Y, sizeVec.Z) / 2
    local layers = intensity or 2
    
    if mode == "Soft Edge" then
        -- Pinggiran halus yang menyebar ke luar
        for layer = 1, layers do
            local layerRadius = radius + (layer * 3)
            local layerSize = math.max(2, 8 - layer)
            local angleStep = 360 / (12 * layer)
            for angle = 0, 359, angleStep do
                local rad = math.rad(angle)
                local offset = Vector3.new(math.cos(rad) * layerRadius, math.random(-1, 1), math.sin(rad) * layerRadius)
                Terrain:FillBall(centerPos + offset, layerSize / 2, material)
            end
        end
        
    elseif mode == "Noise" then
        -- Acak bergejolak, banyak variasi tinggi
        local seed = math.random(1, 10000)
        for i = 1, layers * 15 do
            local angle = math.random() * 360
            local dist = math.random() * radius * 1.5
            local rad = math.rad(angle)
            local heightVar = (math.noise(i * 0.3, seed * 0.1) * 8) + math.random(-3, 3)
            local pos = centerPos + Vector3.new(math.cos(rad) * dist, heightVar, math.sin(rad) * dist)
            local size = math.random(2, 6)
            Terrain:FillBall(pos, size, material)
        end
        
    elseif mode == "Gradient" then
        -- Tanjakan/lereng gradual (slope)
        for layer = 1, layers * 2 do
            local layerRadius = radius + (layer * 2)
            local heightDrop = layer * 1.5
            local angleStep = 360 / (16 * layer)
            for angle = 0, 359, angleStep do
                local rad = math.rad(angle)
                local offset = Vector3.new(math.cos(rad) * layerRadius, -heightDrop + math.random(-1, 1), math.sin(rad) * layerRadius)
                Terrain:FillBall(centerPos + offset, math.max(2, 5 - layer * 0.3), material)
            end
        end
        
    elseif mode == "Valley" then
        -- Lembah cekung (valley) - terrain di tengah lebih rendah
        for layer = 1, layers do
            local layerRadius = radius + (layer * 2.5)
            local depth = layer * 2
            local angleStep = 360 / (10 * layer)
            for angle = 0, 359, angleStep do
                local rad = math.rad(angle)
                local distFactor = layer / layers
                local drop = depth * distFactor
                local offset = Vector3.new(math.cos(rad) * layerRadius, -drop, math.sin(rad) * layerRadius)
                Terrain:FillBall(centerPos + offset, math.max(3, 7 - layer), material)
            end
        end
        -- Isi dasar lembah
        Terrain:FillBall(centerPos - Vector3.new(0, layers * 2, 0), radius * 0.5, material)
    end
end

--// BL Function (Execute Terrain) - SEMUA MODE PAKAI SHAPE YANG DIPILIH
local function BL(d)
    local pos = Vector3.new(d[1], d[2], d[3])
    local sx, sy, sz = d[4], d[5], d[6]
    local matName = d[7]
    local shape = d[8] or "Ball"
    local grassIdx = d[9] or currentGrassColorIndex
    local leafyIdx = d[10] or currentLeafyGrassColorIndex
    local groundIdx = d[11] or currentGroundColorIndex
    local rx, ry, rz = d[12] or 0, d[13] or 0, d[14] or 0
    local smoothOn = d[15] or false
    local smoothMode = d[16] or "Soft Edge"
    local smoothInt = d[17] or 2
    local actionMode = d[18] or "Add"
    local rockIdx = d[19] or currentRockColorIndex
    
    local mat = Enum.Material.Grass
    for _, m in ipairs(Materials) do
        if m.Name == matName then mat = m.Mat break end
    end
    
    currentGrassColorIndex, currentLeafyGrassColorIndex, currentGroundColorIndex, currentRockColorIndex = grassIdx, leafyIdx, groundIdx, rockIdx
    ApplyMaterialColors()
    
    local sizeVec = Vector3.new(sx, sy, sz)
    local cf = CFrame.new(pos) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
    
    if actionMode == "Erase" then
        -- ERASE PAKAI SHAPE YANG DIPILIH
        if shape == "Block" then
            local halfSize = sizeVec / 2
            local region = Region3.new(pos - halfSize, pos + halfSize):ExpandToGrid(4)
            local mats, occs = Terrain:ReadVoxels(region, 4)
            local changed = false
            for x = 1, mats.Size.X do
                for y = 1, mats.Size.Y do
                    for z = 1, mats.Size.Z do
                        if mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= Enum.Material.Water then
                            mats[x][y][z] = Enum.Material.Air
                            occs[x][y][z] = 0
                            changed = true
                        end
                    end
                end
            end
            if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
            
        elseif shape == "Wedge" then
            -- Wedge erase: hapus wedge shape
            local halfSize = sizeVec / 2
            local region = Region3.new(pos - halfSize, pos + halfSize):ExpandToGrid(4)
            local mats, occs = Terrain:ReadVoxels(region, 4)
            local changed = false
            for x = 1, mats.Size.X do
                for y = 1, mats.Size.Y do
                    for z = 1, mats.Size.Z do
                        if mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= Enum.Material.Water then
                            mats[x][y][z] = Enum.Material.Air
                            occs[x][y][z] = 0
                            changed = true
                        end
                    end
                end
            end
            if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
            
        else
            -- Ball erase
            local region = Region3.new(pos - sizeVec, pos + sizeVec):ExpandToGrid(4)
            local mats, occs = Terrain:ReadVoxels(region, 4)
            local radius = math.max(sx, sy, sz) / 2
            local changed = false
            for x = 1, mats.Size.X do
                for y = 1, mats.Size.Y do
                    for z = 1, mats.Size.Z do
                        local voxelPos = region.CFrame * CFrame.new(
                            (x - 1) * 4 - (mats.Size.X - 1) * 2,
                            (y - 1) * 4 - (mats.Size.Y - 1) * 2,
                            (z - 1) * 4 - (mats.Size.Z - 1) * 2
                        )
                        local dist = (voxelPos.Position - pos).Magnitude
                        if dist <= radius and mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= Enum.Material.Water then
                            mats[x][y][z] = Enum.Material.Air
                            occs[x][y][z] = 0
                            changed = true
                        end
                    end
                end
            end
            if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
        end
        
    elseif actionMode == "Flatten" then
        -- FLATTEN PAKAI SHAPE YANG DIPILIH
        if shape == "Block" then
            local baseCf = CFrame.new(pos) * CFrame.Angles(0, math.rad(ry), 0)
            Terrain:FillBlock(baseCf, Vector3.new(sx, 2, sz), mat)
            Terrain:FillBlock(baseCf * CFrame.new(0, (sy/2) + 1, 0), Vector3.new(sx, sy, sz), Enum.Material.Air)
        elseif shape == "Wedge" then
            local baseCf = CFrame.new(pos) * CFrame.Angles(0, math.rad(ry), 0)
            Terrain:FillWedge(baseCf, Vector3.new(sx, 2, sz), mat)
            Terrain:FillWedge(baseCf * CFrame.new(0, (sy/2) + 1, 0), Vector3.new(sx, sy, sz), Enum.Material.Air)
        else
            -- Ball flatten
            local baseRadius = math.max(sx, sy, sz) / 2
            Terrain:FillBall(pos, baseRadius, mat)
            Terrain:FillBall(pos + Vector3.new(0, baseRadius + 2, 0), baseRadius, Enum.Material.Air)
        end
        
    elseif actionMode == "Paint" then
        -- PAINT PAKAI SHAPE YANG DIPILIH
        if shape == "Block" then
            local halfSize = sizeVec / 2
            local region = Region3.new(pos - halfSize, pos + halfSize):ExpandToGrid(4)
