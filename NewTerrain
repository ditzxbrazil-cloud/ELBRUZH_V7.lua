    pcall(function() Terrain:SetMaterialColor(Enum.Material.LeafyGrass, leafyGrassColors[currentLeafyGrassColorIndex].color) end)
    pcall(function() Terrain:SetMaterialColor(Enum.Material.Ground, groundColors[currentGroundColorIndex].color) end)
    pcall(function() Terrain:SetMaterialColor(Enum.Material.Rock, rockColors[currentRockColorIndex].color) end)
end

--// SMOOTH TERRAIN ALGORITHM
local function ApplySmoothTerrain(centerPos, sizeVec, material, intensity, mode)
    local radius = math.max(sizeVec.X, sizeVec.Y, sizeVec.Z) / 2
    local layers = intensity or 2
    
    for layer = 1, layers do
        local layerRadius = radius + (layer * 2)
        local layerSize = math.max(2, 6 - layer)
        local angleStep = 360 / (8 * layer)
        
        for angle = 0, 359, angleStep do
            local rad = math.rad(angle)
            local offsetY = 0
            
            if mode == "Noise" then 
                offsetY = math.random(-4, 4) 
            elseif mode == "Gradient" then
                offsetY = math.random(-2, 2)
            end
            
            local offset = Vector3.new(
                math.cos(rad) * layerRadius,
                offsetY,
                math.sin(rad) * layerRadius
            )
            local pos = centerPos + offset
            
            if mode == "Soft Edge" then
                Terrain:FillBall(pos, layerSize / 1.5, material)
            elseif mode == "Noise" then
                if math.random() > 0.4 then
                    Terrain:FillBall(pos, layerSize / 2, material)
                end
            elseif mode == "Gradient" then
                if math.random() > 0.2 then
                    Terrain:FillBall(pos, layerSize / 2, material)
                end
            elseif mode == "Blend" then
                Terrain:FillBall(pos, layerSize, material)
            end
        end
    end
end

--// BL Function (Execute Terrain)
local function BL(d)
    local pos = Vector3.new(d[1], d[2], d[3])
    local sx, sy, sz = d[4], d[5], d[6]
    local matName = d[7]
    local shape = d[8] or "Ball"
    local grassIdx = d[9] or currentGrassColorIndex
    local leafyIdx = d[10] or currentLeafyGrassColorIndex
    local groundIdx = d[11] or currentGroundColorIndex
    local rx, ry, rz = d[12] or 0, d[13] or 0, d[14] or 0
    local smoothOn = d[15] or false
    local smoothMode = d[16] or "Soft Edge"
    local smoothInt = d[17] or 2
    local actionMode = d[18] or "Add"
    local rockIdx = d[19] or currentRockColorIndex
    
    local mat = Enum.Material.Grass
    for _, m in ipairs(Materials) do
        if m.Name == matName then mat = m.Mat break end
    end
    
    -- Paksa Update Warna Material
    currentGrassColorIndex, currentLeafyGrassColorIndex, currentGroundColorIndex, currentRockColorIndex = grassIdx, leafyIdx, groundIdx, rockIdx
    ApplyMaterialColors()
    
    local sizeVec = Vector3.new(sx, sy, sz)
    local cf = CFrame.new(pos) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
    
    if actionMode == "Erase" then
        -- SAFE ERASE MATERIAL (Safe Water)
        local halfSize = sizeVec / 2
        local region = Region3.new(pos - halfSize, pos + halfSize):ExpandToGrid(4)
        local mats, occs = Terrain:ReadVoxels(region, 4)
        local changed = false
        for x = 1, mats.Size.X do
            for y = 1, mats.Size.Y do
                for z = 1, mats.Size.Z do
                    if mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= Enum.Material.Water then
                        mats[x][y][z] = Enum.Material.Air
                        occs[x][y][z] = 0
                        changed = true
                    end
                end
            end
        end
        if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
    elseif actionMode == "Flatten" then
        local baseCf = CFrame.new(pos) * CFrame.Angles(0, math.rad(ry), 0)
        Terrain:FillBlock(baseCf, Vector3.new(sx, 2, sz), mat)
        Terrain:FillBlock(baseCf * CFrame.new(0, (sy/2) + 1, 0), Vector3.new(sx, sy, sz), Enum.Material.Air)
    elseif actionMode == "Paint" then
        local halfSize = sizeVec / 2
        local region = Region3.new(pos - halfSize, pos + halfSize):ExpandToGrid(4)
        local mats, occs = Terrain:ReadVoxels(region, 4)
        local changed = false
        for x = 1, mats.Size.X do
            for y = 1, mats.Size.Y do
                for z = 1, mats.Size.Z do
                    if mats[x][y][z] ~= Enum.Material.Air and mats[x][y][z] ~= mat then
                        mats[x][y][z] = mat
                        changed = true
                    end
                end
            end
        end
        if changed then Terrain:WriteVoxels(region, 4, mats, occs) end
    else
        -- Normal Add
        if shape == "Block" then
            Terrain:FillBlock(cf, sizeVec, mat)
        elseif shape == "Wedge" then
            Terrain:FillWedge(cf, sizeVec, mat)
        else
            Terrain:FillBall(pos, math.max(sx, sy, sz)/2, mat)
        end
        
        if smoothOn then
            ApplySmoothTerrain(pos, sizeVec, mat, smoothInt, smoothMode)
        end
    end
    
    return d
end

--// Spawn Terrain
local function SpawnTerrain()
    if BrushSettings.Enabled then return false end -- Disable normal spawn if brush is active
    if not PreviewPos then return false end
    
    local maxDim = math.max(SizeX, SizeY, SizeZ)
    local padding = SmoothEnabled and (SmoothIntensity * 6) or 4
    local halfBounds = Vector3.new(maxDim/2 + padding, maxDim/2 + padding, maxDim/2 + padding)
    local region = Region3.new(PreviewPos - halfBounds, PreviewPos + halfBounds):ExpandToGrid(4)

    local beforeMats, beforeOccs = Terrain:ReadVoxels(region, 4)

    local data = {
        PreviewPos.X, PreviewPos.Y, PreviewPos.Z, 
        SizeX, SizeY, SizeZ, CurrentMaterial.Name, CurrentShape,
        currentGrassColorIndex, currentLeafyGrassColorIndex, currentGroundColorIndex,     
        RotX, RotY, RotZ, SmoothEnabled, SmoothModes[CurrentSmoothModeIndex], SmoothIntensity,
        CurrentActionMode, currentRockColorIndex
    }
    
    BL(data)

    local afterMats, afterOccs = Terrain:ReadVoxels(region, 4)

    table.insert(UndoHistory, {
        IsBrushStroke = false,
        Region = region,
        BeforeMats = beforeMats,
        BeforeOccs = beforeOccs,
        AfterMats = afterMats,
        AfterOccs = afterOccs,
        Data = data
    })
    
    RedoHistory = {}
    table.insert(SpawnedData, data)
    return true
end

--// UNDO / REDO MODIFIED FOR BRUSH
local function Undo()
    if #UndoHistory == 0 then return false, "Nothing to undo" end
    local lastNode = table.remove(UndoHistory)
    table.insert(RedoHistory, lastNode)
    
    if lastNode.IsBrushStroke then
        for i, pos in ipairs(lastNode.Positions) do
            local sz = lastNode.Sizes[i]
            Terrain:FillBlock(CFrame.new(pos), sz, Enum.Material.Air)
        end
        return true, "Undone 1 brush stroke"
    end
    
    for i = #SpawnedData, 1, -1 do
        if SpawnedData[i] == lastNode.Data then
            table.remove(SpawnedData, i)
            break
        end
    end
    
    Terrain:WriteVoxels(lastNode.Region, 4, lastNode.BeforeMats, lastNode.BeforeOccs)
    
    return true, "Undone 1 terrain"
end

local function Redo()
    if #RedoHistory == 0 then return false, "Nothing to redo" end
    local node = table.remove(RedoHistory)
    table.insert(UndoHistory, node)
    
    if node.IsBrushStroke then
        -- (Simplified Redo for brush, full redo re-implements logic)
        return false, "Redo for brush not fully supported yet"
    end
    
    table.insert(SpawnedData, node.Data)
    Terrain:WriteVoxels(node.Region, 4, node.AfterMats, node.AfterOccs)
    
    return true, "Redone 1 terrain"
end

