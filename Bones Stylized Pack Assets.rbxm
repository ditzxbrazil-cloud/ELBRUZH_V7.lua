-- Advanced Mountain Generation Algorithm
local shhhhnayy05_MountainGen = {}

function shhhhnayy05_MountainGen.GenerateRealisticMountain(size, baseHeight, mountainType, seed)
    local heightmap = {}
    local rng = Random.new(seed)
    
    -- Initialize
    for x = 1, size do
        heightmap[x] = {}
        for z = 1, size do
            heightmap[x][z] = 0
        end
    end
    
    local centerX, centerZ = size/2, size/2
    
    -- Step 1: Create Base Mountain Shape (Cone/Pyramid base)
    for x = 1, size do
        for z = 1, size do
            local dx = x - centerX
            local dz = z - centerZ
            local dist = math.sqrt(dx*dx + dz*dz)
            local maxDist = size/2
            
            -- Base shape: Smooth falloff from center
            local normalizedDist = dist / maxDist
            local baseShape = math.max(0, 1 - normalizedDist)
            
            -- Power function for steeper slopes near peak
            baseShape = math.pow(baseShape, 0.7)
            
            heightmap[x][z] = baseShape * baseHeight
        end
    end
    
    -- Step 2: Add Ridge Lines (Punggung gunung)
    local numRidges = mountainType == "Himalaya" and 3 or (mountainType == "Volcano" and 0 or 2)
    
    for r = 1, numRidges do
        local angle = (r / numRidges) * math.pi * 2 + rng:NextNumber(-0.5, 0.5)
        local ridgeWidth = size * 0.15
        
        for x = 1, size do
            for z = 1, size do
                local dx = x - centerX
                local dz = z - centerZ
                
                -- Project onto ridge direction
                local ridgeX = dx * math.cos(angle) + dz * math.sin(angle)
                local ridgeY = -dx * math.sin(angle) + dz * math.cos(angle)
                
                -- Distance from ridge line
                local distFromRidge = math.abs(ridgeY)
                
                if distFromRidge < ridgeWidth and ridgeX > 0 then
                    -- Ridge height falls off with distance from center
                    local ridgeHeight = baseHeight * 0.8 * math.max(0, 1 - ridgeX/(size/2))
                    local ridgeFactor = math.max(0, 1 - distFromRidge/ridgeWidth)
                    ridgeFactor = math.pow(ridgeFactor, 2) -- Smooth ridge
                    
                    heightmap[x][z] = math.max(heightmap[x][z], ridgeHeight * ridgeFactor)
                end
            end
        end
    end
    
    -- Step 3: Add Secondary Peaks (Puncak sekunder)
    local numSecondary = rng:NextInteger(2, 4)
    for s = 1, numSecondary do
        local angle = rng:NextNumber(0, math.pi * 2)
        local dist = size * rng:NextNumber(0.2, 0.4)
        local secX = centerX + math.cos(angle) * dist
        local secZ = centerZ + math.sin(angle) * dist
        local secHeight = baseHeight * rng:NextNumber(0.4, 0.7)
        local secRadius = size * rng:NextNumber(0.15, 0.25)
        
        for x = 1, size do
            for z = 1, size do
                local dx = x - secX
                local dz = z - secZ
                local d = math.sqrt(dx*dx + dz*dz)
                
                if d < secRadius then
                    local peakShape = math.max(0, 1 - d/secRadius)
                    peakShape = math.pow(peakShape, 1.2)
                    heightmap[x][z] = math.max(heightmap[x][z], secHeight * peakShape)
                end
            end
        end
    end
    
    -- Step 4: Add Valley Systems (Lembah)
    local numValleys = rng:NextInteger(2, 3)
    for v = 1, numValleys do
        local angle = rng:NextNumber(0, math.pi * 2)
        local valleyWidth = size * 0.1
        
        for x = 1, size do
            for z = 1, size do
                local dx = x - centerX
                local dz = z - centerZ
                
                local valleyX = dx * math.cos(angle) + dz * math.sin(angle)
                local valleyY = -dx * math.sin(angle) + dz * math.cos(angle)
                
                local distFromValley = math.abs(valleyY)
                
                if distFromValley < valleyWidth and valleyX > 0 then
                    local depthFactor = math.max(0, 1 - distFromValley/valleyWidth)
                    depthFactor = math.pow(depthFactor, 3)
                    
                    local currentH = heightmap[x][z]
                    heightmap[x][z] = currentH * (1 - depthFactor * 0.6)
                end
            end
        end
    end
    
    -- Step 5: Add Rocky Details (Detail batu)
    local detailScale = 10
    for x = 1, size do
        for z = 1, size do
            local detail = 0
            for oct = 1, 3 do
                local freq = oct * 2
                local amp = 1 / oct
                detail = detail + math.sin(x/freq + seed) * math.cos(z/freq + seed) * amp
            end
            detail = detail / 2 -- Normalize
            
            -- Only add detail to higher areas (rocky peaks)
            local heightFactor = heightmap[x][z] / baseHeight
            heightmap[x][z] = heightmap[x][z] + detail * 5 * heightFactor
        end
    end
    
    -- Step 6: Smoothing (Gaussian-like)
    local smoothed = {}
    for x = 1, size do
        smoothed[x] = {}
        for z = 1, size do
            local sum = 0
            local count = 0
            for dx = -2, 2 do
                for dz = -2, 2 do
                    local nx, nz = x + dx, z + dz
                    if nx >= 1 and nx <= size and nz >= 1 and nz <= size then
                        local weight = 1 / (1 + math.sqrt(dx*dx + dz*dz))
                        sum = sum + heightmap[nx][nz] * weight
                        count = count + weight
                    end
                end
            end
            smoothed[x][z] = sum / count
        end
    end
    
    -- Step 7: Sharpen Peaks (Tajamkan puncak)
    for x = 1, size do
        for z = 1, size do
            local h = smoothed[x][z]
            local peakFactor = h / baseHeight
            if peakFactor > 0.7 then
                -- Sharpen high peaks
                smoothed[x][z] = h * (1 + (peakFactor - 0.7) * 0.5)
            end
        end
    end
    
    return smoothed
end

