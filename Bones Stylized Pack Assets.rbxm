    CopyScript.Text = "ðŸ“‹ Copy"
    CopyScript.TextColor3 = Color3.fromRGB(255, 255, 255)
    CopyScript.Font = Enum.Font.GothamBold
    CopyScript.Parent = ExportWindow
    
    Instance.new("UICorner", CopyScript).CornerRadius = UDim.new(0, 8)
    
    local SaveScript = Instance.new("TextButton")
    SaveScript.Size = UDim2.new(0.45, -5, 0, 35)
    SaveScript.Position = UDim2.new(0.55, 0, 1, -45)
    SaveScript.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
    SaveScript.Text = "ðŸ’¾ Save"
    SaveScript.TextColor3 = Color3.fromRGB(255, 255, 255)
    SaveScript.Font = Enum.Font.GothamBold
    SaveScript.Parent = ExportWindow
    
    Instance.new("UICorner", SaveScript).CornerRadius = UDim.new(0, 8)
    
    return {
        Main = Main,
        MountDropdown = MountDropdown,
        InfoText = InfoText,
        SizeInput = SizeInput,
        HeightInput = HeightInput,
        SnowInput = SnowInput,
        GenerateBtn = GenerateBtn,
        ExportBtn = ExportBtn,
        Status = Status,
        ListWindow = ListWindow,
        ListScroll = ListScroll,
        SearchBox = SearchBox,
        CloseList = CloseList,
        ExportWindow = ExportWindow,
        ScriptBox = ScriptBox,
        CloseExport = CloseExport,
        CopyScript = CopyScript,
        SaveScript = SaveScript,
        Close = Close
    }
end

-- Main Logic
local GUI = shhhhnayy05_CreateGUI()
local SelectedMountain = nil
local LastTerrainData = nil

-- Populate List
local function PopulateList(filter)
    for _, child in ipairs(GUI.ListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for _, mtn in ipairs(shhhhnayy05_Mountains) do
        if not filter or mtn.name:lower():find(filter:lower()) then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 60)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            btn.Text = ""
            btn.Parent = GUI.ListScroll
            
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
            
            local name = Instance.new("TextLabel")
            name.Size = UDim2.new(1, -10, 0, 20)
            name.Position = UDim2.new(0, 5, 0, 5)
            name.BackgroundTransparency = 1
            name.Text = mtn.name
            name.TextColor3 = Color3.fromRGB(255, 255, 255)
            name.TextSize = 14
            name.Font = Enum.Font.GothamBold
            name.TextXAlignment = Enum.TextXAlignment.Left
            name.Parent = btn
            
            local info = Instance.new("TextLabel")
            info.Size = UDim2.new(1, -10, 0, 15)
            info.Position = UDim2.new(0, 5, 0, 25)
            info.BackgroundTransparency = 1
            info.Text = string.format("%s â€¢ %dm", mtn.type, mtn.height)
            info.TextColor3 = Color3.fromRGB(200, 200, 200)
            info.TextSize = 12
            info.Font = Enum.Font.Gotham
            info.TextXAlignment = Enum.TextXAlignment.Left
            info.Parent = btn
            
            local coord = Instance.new("TextLabel")
            coord.Size = UDim2.new(1, -10, 0, 15)
            coord.Position = UDim2.new(0, 5, 0, 40)
            coord.BackgroundTransparency = 1
            coord.Text = string.format("%.4f, %.4f", mtn.lat, mtn.long)
            coord.TextColor3 = Color3.fromRGB(100, 255, 150)
            coord.TextSize = 11
            coord.Font = Enum.Font.Code
            coord.TextXAlignment = Enum.TextXAlignment.Left
            coord.Parent = btn
            
            btn.MouseButton1Click:Connect(function()
                SelectedMountain = mtn
                GUI.MountDropdown.Text = "ðŸ”ï¸ " .. mtn.name
                GUI.InfoText.Text = string.format(
                    "Koordinat: %.4f, %.4f\nKetinggian: %d meter\nTipe: %s",
                    mtn.lat, mtn.long, mtn.height, mtn.type
                )
                GUI.ListWindow.Visible = false
            end)
        end
    end
    
    GUI.ListScroll.CanvasSize = UDim2.new(0, 0, 0, #GUI.ListScroll:GetChildren() * 68)
end

-- Button Events
GUI.MountDropdown.MouseButton1Click:Connect(function()
    GUI.ListWindow.Visible = true
    PopulateList()
end)

GUI.CloseList.MouseButton1Click:Connect(function()
    GUI.ListWindow.Visible = false
end)

GUI.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    PopulateList(GUI.SearchBox.Text)
end)

GUI.Close.MouseButton1Click:Connect(function()
    GUI.Main.Parent:Destroy()
end)

GUI.CloseExport.MouseButton1Click:Connect(function()
    GUI.ExportWindow.Visible = false
end)

GUI.ExportBtn.MouseButton1Click:Connect(function()
    if LastTerrainData then
        -- Generate script
        local script = "-- shhhhnayy05 Mountain Terrain Script\n"
        script = script .. "-- Mountain: " .. (SelectedMountain and SelectedMountain.name or "Custom") .. "\n\n"
        script = script .. "local Workspace = game:GetService('Workspace')\n"
        script = script .. "local terrain = Workspace.Terrain\n\n"
        script = script .. "local heightmap = {"
        
        -- Compress data
        local step = 4
        for x = 1, LastTerrainData.Size, step do
            script = script .. "\n    [" .. x .. "] = {"
            for z = 1, LastTerrainData.Size, step do
                script = script .. math.floor(LastTerrainData.Heights[x][z]) .. ","
            end
            script = script .. "},"
        end
        script = script .. "\n}\n\n"
        
        script = script .. "local size = " .. LastTerrainData.Size .. "\n"
        script = script .. "local center = Vector3.new(-size/2, 0, -size/2)\n\n"
        script = script .. "terrain:Clear()\n\n"
        script = script .. "for x = 1, size, 4 do\n"
        script = script .. "    for z = 1, size, 4 do\n"
        script = script .. "        local h = heightmap[x][z]\n"
        script = script .. "        local pos = Vector3.new(x + center.X, h/2, z + center.Z)\n"
        script = script .. "        local mat = h > " .. LastTerrainData.SnowLine .. " and Enum.Material.Snow or (h > 20 and Enum.Material.Rock or Enum.Material.Grass)\n"
        script = script .. "        terrain:FillBlock(CFrame.new(pos), Vector3.new(4, math.max(h,1), 4), mat)\n"
        script = script .. "    end\n"
        script = script .. "end\n\n"
        script = script .. "print('Mountain generated by shhhhnayy05!')"
        
        GUI.ScriptBox.Text = script
        GUI.ExportWindow.Visible = true
    else
        GUI.Status.Text = "Status: Generate terrain dulu!"
        GUI.Status.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

GUI.CopyScript.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GUI.ScriptBox.Text)
        GUI.Status.Text = "Status: Script dicopy!"
        GUI.Status.TextColor3 = Color3.fromRGB(0, 200, 100)
    end
end)

GUI.SaveScript.MouseButton1Click:Connect(function()
    if writefile then
        local name = "shhhhnayy05_" .. (SelectedMountain and SelectedMountain.name:gsub(" ", "_") or "Mountain") .. ".lua"
        writefile(name, GUI.ScriptBox.Text)
        GUI.Status.Text = "Status: Disimpan " .. name
    end
end)

-- GENERATE REALISTIC MOUNTAIN
GUI.GenerateBtn.MouseButton1Click:Connect(function()
    if not SelectedMountain then
        GUI.Status.Text = "Status: Pilih gunung dulu!"
        GUI.Status.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end
    
    local size = tonumber(GUI.SizeInput.Text) or 512
    local scale = tonumber(GUI.HeightInput.Text) or 200
    local snowLine = tonumber(GUI.SnowInput.Text) or 70
    
    size = math.clamp(size, 128, 1024)
    
    GUI.Status.Text = "Status: Generating mountain..."
    GUI.Status.TextColor3 = Color3.fromRGB(255, 180, 0)
    
    task.spawn(function()
        -- Generate realistic mountain
        local seed = (SelectedMountain.lat * 10000 + SelectedMountain.long * 100) % 1000000
        local heightmap = shhhhnayy05_MountainGen.GenerateRealisticMountain(
            size, 
            scale, 
            SelectedMountain.type, 
            seed
        )
        
        LastTerrainData = {
            Size = size,
            Heights = heightmap,
            SnowLine = snowLine,
            Mountain = SelectedMountain
        }
        
        -- Clear and spawn
        local terrain = Workspace.Terrain
        terrain:Clear()
        
        local center = Vector3.new(-size/2, 0, -size/2)
        
        for x = 1, size, 2 do
            for z = 1, size, 2 do
                local h = heightmap[x][z]
                local pos = Vector3.new(x + center.X, h/2, z + center.Z)
                
                -- Determine material based on height
                local material = Enum.Material.Grass
                if h > snowLine then
                    material = Enum.Material.Snow
                elseif h > snowLine * 0.7 then
                    material = Enum.Material.Rock
                elseif h < 10 then
                    material = Enum.Material.Sand
                end
                
                terrain:FillBlock(CFrame.new(pos), Vector3.new(2, math.max(h, 1), 2), material)
            end
            
            if x % 50 == 0 then
                GUI.Status.Text = string.format("Status: Spawning... %d%%", math.floor(x/size * 100))
                task.wait()
            end
        end
        
        GUI.Status.Text = "Status: " .. SelectedMountain.name .. " selesai!"
        GUI.Status.TextColor3 = Color3.fromRGB(0, 200, 100)
    end)
end)

-- Animation
GUI.Main.Size = UDim2.new(0, 0, 0, 0)
TweenService:Create(GUI.Main, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
    Size = UDim2.new(0, 400, 0, 500)
}):Play()

print("ðŸ”ï¸ shhhhnayy05 Realistic Mountain Generator loaded!")
